---
/**
 * Hero del home (CSS puro, 12 s en bucle): el cursor conecta a tu cliente con tu
 * negocio; en medio, el punto de conexión es Neopoint. Cuando la línea se cierra,
 * los clientes empiezan a viajar por ella hasta tu negocio.
 */
---
<div class="cscene" data-scene aria-hidden="true">
<div class="cstage">
  <div class="backdrop"></div>

  <!-- Líneas de conexión -->
  <svg class="wire" viewBox="0 0 1000 100" preserveAspectRatio="none">
    <line class="wire__track" x1="140" y1="50" x2="440" y2="50" />
    <line class="wire__track" x1="560" y1="50" x2="860" y2="50" />
    <line class="wire__draw wire__draw--1" x1="140" y1="50" x2="440" y2="50" pathLength="100" />
    <line class="wire__draw wire__draw--2" x1="560" y1="50" x2="860" y2="50" pathLength="100" />
  </svg>

  <!-- Tu cliente -->
  <div class="node node--client">
    <span class="bubble">¿Quién me ayuda?</span>
    <span class="avatar">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4" /><path d="M4 21c0-4 3.6-7 8-7s8 3 8 7" /></svg>
    </span>
    <span class="cap">Tu cliente</span>
  </div>

  <!-- Neopoint: el punto de conexión -->
  <div class="node node--point">
    <span class="point">
      <svg viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="12" r="7.7" /><path d="M12 24C5.4 24 0 18.6 0 12S5.4 0 12 0s12 5.4 12 12-5.4 12-12 12Zm0-22.7C6.1 1.3 1.3 6.1 1.3 12S6.1 22.7 12 22.7 22.7 17.9 22.7 12 17.9 1.3 12 1.3Z" /></svg>
    </span>
    <span class="cap cap--point">Neopoint</span>
  </div>

  <!-- Tu negocio -->
  <div class="node node--biz">
    <span class="shop">
      <i class="shop__bar"></i>
      <i class="shop__l" style="width:70%"></i><i class="shop__l" style="width:45%"></i>
      <b class="shop__cta">Agendar</b>
    </span>
    <span class="count">+3 citas</span>
    <span class="cap">Tu negocio</span>
  </div>

  <!-- Clientes viajando por la línea -->
  <span class="dot dot--1"></span><span class="dot dot--2"></span><span class="dot dot--3"></span>

  <svg class="cursor" viewBox="0 0 24 24">
    <path d="M5 3l14 9-6 1.5L16 20l-3 1.5-3-6.5-5 4z" fill="#fff" stroke="#111" stroke-width="1.5" stroke-linejoin="round" />
  </svg>
</div>
</div>

<script>
  const scenes = document.querySelectorAll<HTMLElement>('.cscene[data-scene]');
  const io = new IntersectionObserver((entries) => {
    for (const e of entries) e.target.classList.toggle('is-playing', e.isIntersecting);
  }, { threshold: 0.2 });
  scenes.forEach((s) => io.observe(s));
</script>

<style>
  /* 12 s · 1 s = 8.333 % · 0–1 aparece · 1–3 línea 1 · 3–5 línea 2 · 5–9.5 viajan clientes · hold · 11–12 apaga */
  .cscene { --dur: 12s; --play: paused; position: relative; overflow: hidden; container-type: inline-size; aspect-ratio: 4 / 3; width: 100%; border-radius: var(--radius-card); background: var(--color-paper); }
  @media (min-width: 640px) { .cscene { aspect-ratio: 2.4 / 1; } }
  .cscene.is-playing { --play: running; }
  .cstage { position: absolute; inset: 0; font-size: max(0.62rem, 1.5cqw); }
  .cstage * { animation-duration: var(--dur); animation-iteration-count: infinite; animation-fill-mode: both; animation-timing-function: cubic-bezier(0.4, 0, 0.2, 1); animation-play-state: var(--play); }
  @media (prefers-reduced-motion: reduce) { .cstage * { animation-play-state: paused !important; animation-delay: -10s !important; } }

  .backdrop { position: absolute; inset: 0; border-radius: inherit; background: var(--color-paper-soft); }

  .wire { position: absolute; left: 0; top: 50%; width: 100%; height: 4cqw; translate: 0 -50%; overflow: visible; }
  .wire__track { stroke: rgb(0 0 0 / 0.12); stroke-width: 3; stroke-linecap: round; stroke-dasharray: 2 8; vector-effect: non-scaling-stroke; }
  .wire__draw { stroke: var(--color-lime-deep); stroke-width: 3; stroke-linecap: round; stroke-dasharray: 100; stroke-dashoffset: 100; vector-effect: non-scaling-stroke; animation-timing-function: linear; }
  .wire__draw--1 { animation-name: draw1; } .wire__draw--2 { animation-name: draw2; }

  .node { position: absolute; top: 50%; display: flex; flex-direction: column; align-items: center; translate: -50% -50%; }
  .cap { position: absolute; top: calc(100% + 1cqw); white-space: nowrap; font-size: max(0.66rem, 1.5cqw); font-weight: 600; color: var(--color-text); }
  .node--client { left: 14%; animation-name: appear; }
  .node--point { left: 50%; animation-name: appear; }
  .node--biz { left: 86%; animation-name: appear; }

  .avatar { display: grid; place-items: center; width: 9cqw; height: 9cqw; border-radius: 50%; color: #fff; background: linear-gradient(180deg, #3b3b3b, #1a1a1a); box-shadow: 0 16px 30px -16px rgb(0 0 0 / 0.6), inset 0 1px 0 rgb(255 255 255 / 0.15); }
  .avatar svg { width: 55%; height: 55%; }
  .bubble { position: absolute; bottom: calc(100% + 1.6cqw); left: 50%; translate: -50% 0; white-space: nowrap; padding: 1cqw 1.6cqw; border-radius: 1.6cqw; color: #fff; font-size: max(0.62rem, 1.5cqw); font-weight: 600; background: linear-gradient(180deg, #3b3b3b, #262626); box-shadow: 0 14px 26px -12px rgb(0 0 0 / 0.55); animation-name: bubble; }
  .bubble::after { content: ""; position: absolute; left: 50%; bottom: -0.5cqw; width: 1cqw; height: 1cqw; translate: -50% 0; rotate: 45deg; background: #262626; }

  .point { display: grid; place-items: center; width: 12cqw; height: 12cqw; border-radius: 50%; color: var(--color-text); background: var(--color-paper); box-shadow: 0 0 0 1px var(--color-line), 0 24px 40px -24px rgb(0 0 0 / 0.35); animation-name: point; }
  .point svg { width: 52%; height: 52%; }
  .cap--point { color: var(--color-muted); }

  .shop { position: relative; display: flex; flex-direction: column; gap: 1cqw; width: 14cqw; padding: 1.6cqw; border-radius: 2cqw; background: var(--color-paper); box-shadow: 0 0 0 1px var(--color-line), 0 24px 40px -24px rgb(0 0 0 / 0.35); animation-name: shop; }
  .shop__bar { display: block; width: 40%; height: 1cqw; border-radius: 999px; background: #111; }
  .shop__l { display: block; height: 0.8cqw; border-radius: 999px; background: var(--color-surface-hover); }
  .shop__cta { display: block; margin-top: 0.4cqw; padding: 0.8cqw 0; border-radius: 1cqw; text-align: center; font-size: max(0.55rem, 1.3cqw); font-weight: 600; color: #0a0a0a; background: var(--color-lime); }
  .count { position: absolute; right: -2.4cqw; top: -2cqw; padding: 0.6cqw 1.2cqw; border-radius: 999px; font-size: max(0.58rem, 1.4cqw); font-weight: 700; color: #0a0a0a; background: var(--color-lime); box-shadow: 0 10px 20px -10px rgb(151 239 73 / 0.8); opacity: 0; animation-name: count; }

  .dot { position: absolute; top: 50%; left: 14%; width: 2.4cqw; height: 2.4cqw; border-radius: 50%; translate: -50% -50%; background: var(--color-lime-deep); box-shadow: 0 0 0 0.6cqw rgb(151 239 73 / 0.35); opacity: 0; animation-name: travel; animation-timing-function: cubic-bezier(0.45, 0, 0.3, 1); }
  .dot--2 { animation-delay: 0.9s; } .dot--3 { animation-delay: 1.8s; }

  .cursor { position: absolute; left: 105%; top: 95%; width: 4.5cqw; z-index: 20; filter: drop-shadow(0 4px 8px rgb(0 0 0 / 0.35)); animation-name: cursor; animation-timing-function: cubic-bezier(0.65, 0, 0.35, 1); }

  @keyframes appear { 0% { opacity: 0; } 6%, 92% { opacity: 1; } 98%, 100% { opacity: 0; } }
  @keyframes bubble { 0%, 4% { opacity: 0; transform: translateY(6px); } 8%, 40% { opacity: 1; transform: none; } 44%, 100% { opacity: 0; transform: translateY(-6px); } }
  @keyframes cursor {
    0%, 3%   { left: 105%; top: 95%; opacity: 0; transform: scale(1); }
    6%       { opacity: 1; }
    9%       { left: 16%; top: 54%; }
    10%      { transform: scale(0.8); }
    11%      { transform: scale(1); }
    25%      { left: 50%; top: 54%; }
    26%      { transform: scale(0.8); }
    27%      { transform: scale(1); }
    41%      { left: 84%; top: 54%; }
    42%      { transform: scale(0.8); }
    43%, 50% { left: 84%; top: 54%; transform: scale(1); opacity: 1; }
    58%, 100% { left: 105%; top: 95%; opacity: 0; }
  }
  @keyframes draw1 { 0%, 11% { stroke-dashoffset: 100; opacity: 1; } 25%, 92% { stroke-dashoffset: 0; opacity: 1; } 98%, 100% { stroke-dashoffset: 0; opacity: 0; } }
  @keyframes draw2 { 0%, 27% { stroke-dashoffset: 100; opacity: 1; } 41%, 92% { stroke-dashoffset: 0; opacity: 1; } 98%, 100% { stroke-dashoffset: 0; opacity: 0; } }
  @keyframes point {
    0%, 24% { box-shadow: 0 0 0 1px var(--color-line), 0 24px 40px -24px rgb(0 0 0 / 0.35); transform: scale(1); }
    27%     { box-shadow: 0 0 0 0.6cqw var(--color-lime), 0 24px 40px -24px rgb(0 0 0 / 0.35); transform: scale(1.08); }
    30%, 92% { box-shadow: 0 0 0 0.6cqw var(--color-lime), 0 24px 40px -24px rgb(0 0 0 / 0.35); transform: scale(1); }
    98%, 100% { box-shadow: 0 0 0 1px var(--color-line), 0 24px 40px -24px rgb(0 0 0 / 0.35); transform: scale(1); }
  }
  @keyframes shop {
    0%, 41% { box-shadow: 0 0 0 1px var(--color-line), 0 24px 40px -24px rgb(0 0 0 / 0.35); }
    43%, 92% { box-shadow: 0 0 0 0.5cqw var(--color-lime), 0 24px 40px -24px rgb(0 0 0 / 0.35); }
    98%, 100% { box-shadow: 0 0 0 1px var(--color-line), 0 24px 40px -24px rgb(0 0 0 / 0.35); }
  }
  /* cada cliente recorre la línea en ~3 s a partir del segundo 5 */
  @keyframes travel {
    0%, 42% { left: 14%; opacity: 0; transform: scale(0.6); }
    45%     { left: 16%; opacity: 1; transform: scale(1); }
    66%     { left: 84%; opacity: 1; transform: scale(1); }
    68%, 100% { left: 86%; opacity: 0; transform: scale(0.4); }
  }
  @keyframes count { 0%, 64% { opacity: 0; transform: translateY(4px) scale(0.8); } 68%, 92% { opacity: 1; transform: none; } 98%, 100% { opacity: 0; } }
</style>
