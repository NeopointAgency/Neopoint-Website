---
/**
 * Hero del home (14 s en bucle, CSS puro):
 * 1) la mano arrastra en horizontal tres bloques (anuncio, sitio, venta) a su lugar;
 * 2) el cursor activa cada bloque con un clic y la gráfica de crecimiento sube un tramo por bloque.
 */
const blocks = [
  { id: 'ad', tag: 'Anuncio' },
  { id: 'site', tag: 'Sitio' },
  { id: 'sale', tag: 'Venta' },
];
---
<div class="pscene" data-scene aria-hidden="true">
<div class="pstage">
  <!-- Gráfica de crecimiento -->
  <div class="chart">
    <span class="chart__label">Ventas</span>
    <svg viewBox="0 0 300 160">
      <defs>
        <linearGradient id="chartFill" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#ffffff" stop-opacity="0.22" />
          <stop offset="1" stop-color="#ffffff" stop-opacity="0" />
        </linearGradient>
      </defs>
      <g class="chart__grid" stroke="rgb(255 255 255 / 0.08)" stroke-width="1" vector-effect="non-scaling-stroke">
        <line x1="0" y1="40" x2="300" y2="40" /><line x1="0" y1="80" x2="300" y2="80" /><line x1="0" y1="120" x2="300" y2="120" />
      </g>
      <g class="chart__draw">
        <path d="M0 150 L100 122 L200 78 L300 22 L300 160 L0 160 Z" fill="url(#chartFill)" />
        <path class="chart__line" d="M0 150 L100 122 L200 78 L300 22" />
      </g>
    </svg>
    <span class="pt pt--1"></span><span class="pt pt--2"></span><span class="pt pt--3"></span>
  </div>
  <span class="badge">Más ventas</span>

  <!-- Bloques -->
  {blocks.map(({ id, tag }) => (
    <div class:list={['block', `block--${id}`]}>
      <span class="block__tag">{tag}</span>
      {id === 'ad' && (<><i class="l l--dark"></i><i class="l" style="width:80%"></i><i class="l" style="width:55%"></i></>)}
      {id === 'site' && (<><i class="l l--dark" style="width:60%"></i><i class="l" style="width:90%"></i><b class="block__cta">Agendar</b></>)}
      {id === 'sale' && (<span class="sale"><span class="sale__ok"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5L20 7" /></svg></span><span><i class="l l--dark" style="width:70%;margin-top:0"></i><i class="l" style="width:100%"></i></span></span>)}
    </div>
  ))}

  <!-- Cursor: mano al arrastrar, flecha al activar -->
  <svg class="cursor cursor--hand" viewBox="0 0 24 24"><path d="M9 11V6.5a1.5 1.5 0 0 1 3 0V11m0-1.5a1.5 1.5 0 0 1 3 0V11m0-.5a1.5 1.5 0 0 1 3 0V15a6 6 0 0 1-6 6h-1.2a6 6 0 0 1-5-2.7L3.6 14.9a1.4 1.4 0 0 1 2.2-1.7L9 16.5V11" fill="#fff" stroke="#111" stroke-width="1.4" stroke-linejoin="round" stroke-linecap="round" /></svg>
  <svg class="cursor cursor--arrow" viewBox="0 0 24 24"><path d="M5 3l14 9-6 1.5L16 20l-3 1.5-3-6.5-5 4z" fill="#fff" stroke="#111" stroke-width="1.5" stroke-linejoin="round" /></svg>
</div>
</div>

<script>
  const scenes = document.querySelectorAll<HTMLElement>('.pscene[data-scene]');
  const io = new IntersectionObserver((entries) => {
    for (const e of entries) e.target.classList.toggle('is-playing', e.isIntersecting);
  }, { threshold: 0.2 });
  scenes.forEach((s) => io.observe(s));
</script>

<style>
  /* 14 s · 1 s = 7.14 %
     0.5–2.5 arrastra anuncio · 2.5–4.5 sitio · 4.5–6.5 cita
     7.5 clic anuncio → tramo 1 (7.5–9) · 9 clic sitio → tramo 2 (9–10.5) · 10.5 clic cita → tramo 3 (10.5–12) · hold · 13.3–14 apaga */
  .pscene { --dur: 14s; --play: paused; position: relative; container-type: inline-size; aspect-ratio: 4 / 3; width: 100%; }
  .pscene.is-playing { --play: running; }
  .pstage { position: absolute; inset: 0; font-size: max(0.62rem, 2.4cqw); color: #fff; }
  .pstage *, .pstage, .chart__draw { animation-duration: var(--dur); animation-iteration-count: infinite; animation-fill-mode: both; animation-timing-function: cubic-bezier(0.4, 0, 0.2, 1); animation-play-state: var(--play); }
  @media (prefers-reduced-motion: reduce) { .pstage * { animation-play-state: paused !important; animation-delay: -12.5s !important; } }

  /* Gráfica */
  .chart { position: absolute; left: 6%; right: 6%; top: 9%; aspect-ratio: 300 / 160; animation-name: chart; }
  .chart svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .chart__label { position: absolute; left: 0; top: -1.2cqw; font-size: max(0.6rem, 2.3cqw); font-weight: 600; color: rgb(255 255 255 / 0.5); }
  .chart__line { fill: none; stroke: #fff; stroke-width: 2.5; stroke-linecap: round; stroke-linejoin: round; filter: drop-shadow(0 0 6px rgb(255 255 255 / 0.5)); }
  .chart__draw { clip-path: inset(0 100% 0 0); animation-name: area; animation-timing-function: linear; }
  .pt { position: absolute; width: 2.6cqw; height: 2.6cqw; border-radius: 50%; translate: -50% -50%; background: var(--color-lime); box-shadow: 0 0 0 0.7cqw rgb(151 239 73 / 0.3), 0 0 12px rgb(151 239 73 / 0.8); opacity: 0; }
  .pt--1 { left: 33.3%; top: 76.25%; animation-name: pt1; } .pt--2 { left: 66.6%; top: 48.75%; animation-name: pt2; } .pt--3 { left: 100%; top: 13.75%; animation-name: pt3; }
  .badge { position: absolute; right: 6%; top: 6%; padding: 1cqw 2.2cqw; border-radius: 999px; font-size: max(0.6rem, 2.4cqw); font-weight: 700; color: #0a0a0a; background: var(--color-lime); box-shadow: 0 12px 24px -12px rgb(151 239 73 / 0.8); opacity: 0; animation-name: badge; }

  /* Bloques */
  .block { position: absolute; top: 78%; translate: -50% -50%; width: 24cqw; padding: 2.2cqw; border-radius: 2.4cqw; background: linear-gradient(180deg, rgb(255 255 255 / 0.12), rgb(255 255 255 / 0.05)); box-shadow: 0 0 0 1px rgb(255 255 255 / 0.12), inset 0 1px 0 rgb(255 255 255 / 0.14), 0 30px 50px -30px rgb(0 0 0 / 0.9); backdrop-filter: blur(8px); }
  .block__tag { display: block; margin-bottom: 1.4cqw; font-size: max(0.55rem, 2cqw); font-weight: 600; color: rgb(255 255 255 / 0.55); letter-spacing: 0.02em; text-transform: uppercase; }
  .l { display: block; height: 1.2cqw; margin-top: 1cqw; border-radius: 999px; background: rgb(255 255 255 / 0.18); }
  .l--dark { width: 46%; background: #fff; }
  .block__cta { display: block; margin-top: 1.8cqw; padding: 1cqw 0; border-radius: 1.1cqw; text-align: center; font-size: max(0.55rem, 2.1cqw); font-weight: 600; color: #0a0a0a; background: var(--color-lime); }
  .sale { display: grid; grid-template-columns: auto 1fr; align-items: center; gap: 1.6cqw; }
  .sale__ok { display: grid; place-items: center; width: 5.5cqw; height: 5.5cqw; border-radius: 50%; color: #0a0a0a; background: var(--color-lime); }
  .sale__ok svg { width: 60%; height: 60%; }
  .block--ad { animation-name: bAd; } .block--site { animation-name: bSite; } .block--sale { animation-name: bCal; }

  .cursor { position: absolute; width: 5cqw; z-index: 20; filter: drop-shadow(0 4px 8px rgb(0 0 0 / 0.6)); animation-timing-function: cubic-bezier(0.65, 0, 0.35, 1); }
  .cursor--hand { animation-name: hand; } .cursor--arrow { animation-name: arrow; }

  /* Arrastre horizontal: cada bloque entra por la derecha y se detiene en su lugar (18 %, 50 %, 82 %) */
  @keyframes bAd   { 0%, 3% { left: 108%; opacity: 0; } 5% { opacity: 1; } 18% { left: 18%; } 18%, 53% { left: 18%; opacity: 1; box-shadow: 0 0 0 1px rgb(255 255 255 / 0.12), inset 0 1px 0 rgb(255 255 255 / 0.14), 0 30px 50px -30px rgb(0 0 0 / 0.9); } 55%, 93% { left: 18%; box-shadow: 0 0 0 0.5cqw var(--color-lime), inset 0 1px 0 rgb(255 255 255 / 0.14), 0 30px 50px -30px rgb(0 0 0 / 0.9); } 98%, 100% { opacity: 0; } }
  @keyframes bSite { 0%, 18% { left: 108%; opacity: 0; } 20% { opacity: 1; } 32% { left: 50%; } 32%, 64% { left: 50%; opacity: 1; box-shadow: 0 0 0 1px rgb(255 255 255 / 0.12), inset 0 1px 0 rgb(255 255 255 / 0.14), 0 30px 50px -30px rgb(0 0 0 / 0.9); } 66%, 93% { left: 50%; box-shadow: 0 0 0 0.5cqw var(--color-lime), inset 0 1px 0 rgb(255 255 255 / 0.14), 0 30px 50px -30px rgb(0 0 0 / 0.9); } 98%, 100% { opacity: 0; } }
  @keyframes bCal  { 0%, 32% { left: 108%; opacity: 0; } 34% { opacity: 1; } 46% { left: 82%; } 46%, 74% { left: 82%; opacity: 1; box-shadow: 0 0 0 1px rgb(255 255 255 / 0.12), inset 0 1px 0 rgb(255 255 255 / 0.14), 0 30px 50px -30px rgb(0 0 0 / 0.9); } 76%, 93% { left: 82%; box-shadow: 0 0 0 0.5cqw var(--color-lime), inset 0 1px 0 rgb(255 255 255 / 0.14), 0 30px 50px -30px rgb(0 0 0 / 0.9); } 98%, 100% { opacity: 0; } }
  /* La mano acompaña cada bloque (centro del bloque, ligeramente abajo) */
  @keyframes hand {
    0%, 3%  { left: 108%; top: 80%; opacity: 0; }
    5%      { opacity: 1; }
    18%     { left: 18%; top: 80%; }
    18.5%   { left: 18%; top: 80%; opacity: 1; }
    19%     { left: 108%; top: 80%; opacity: 0; }
    20%     { opacity: 1; }
    32%     { left: 50%; top: 80%; }
    32.5%   { left: 50%; top: 80%; opacity: 1; }
    33%     { left: 108%; top: 80%; opacity: 0; }
    34%     { opacity: 1; }
    46%     { left: 82%; top: 80%; }
    47%     { left: 82%; top: 80%; opacity: 1; }
    48%, 100% { left: 82%; top: 80%; opacity: 0; }
  }
  /* La flecha activa cada bloque con un clic */
  @keyframes arrow {
    0%, 47% { left: 82%; top: 80%; opacity: 0; transform: scale(1); }
    48%     { opacity: 1; }
    53%     { left: 20%; top: 78%; transform: scale(1); }
    54%     { transform: scale(0.8); }
    55%     { transform: scale(1); }
    63%     { left: 52%; top: 78%; transform: scale(1); }
    64.5%   { transform: scale(0.8); }
    65.5%   { transform: scale(1); }
    73.5%   { left: 84%; top: 78%; transform: scale(1); }
    75%     { transform: scale(0.8); }
    76%, 86% { left: 84%; top: 78%; transform: scale(1); opacity: 1; }
    92%, 100% { left: 108%; top: 90%; opacity: 0; }
  }
  /* Gráfica: aparece con el primer clic; cada tramo sube al activar un bloque */
  @keyframes chart { 0%, 50% { opacity: 0; transform: translateY(6px); } 54%, 93% { opacity: 1; transform: none; } 98%, 100% { opacity: 0; } }
  @keyframes area { 0%, 54% { clip-path: inset(0 100% 0 0); } 64% { clip-path: inset(0 66.6% 0 0); } 65% { clip-path: inset(0 66.6% 0 0); } 75% { clip-path: inset(0 33.3% 0 0); } 76% { clip-path: inset(0 33.3% 0 0); } 86%, 100% { clip-path: inset(0 0 0 0); } }
  @keyframes pt1 { 0%, 63% { opacity: 0; transform: scale(0.4); } 65%, 93% { opacity: 1; transform: scale(1); } 98%, 100% { opacity: 0; } }
  @keyframes pt2 { 0%, 74% { opacity: 0; transform: scale(0.4); } 76%, 93% { opacity: 1; transform: scale(1); } 98%, 100% { opacity: 0; } }
  @keyframes pt3 { 0%, 85% { opacity: 0; transform: scale(0.4); } 87%, 93% { opacity: 1; transform: scale(1); } 98%, 100% { opacity: 0; } }
  @keyframes badge { 0%, 86% { opacity: 0; transform: translateY(4px); } 88.5%, 93% { opacity: 1; transform: none; } 98%, 100% { opacity: 0; } }
</style>
