---
/**
 * Hero del home (14 s en bucle, CSS + SMIL, sin librerías):
 * 1) el cursor construye el camino: coloca el anuncio, el sitio y la cita sobre una curva;
 * 2) el cursor se retira y los clientes (puntos de luz) recorren el camino; las citas suben.
 */
const PATH = 'M72 216 C150 216 150 144 200 144 S260 72 328 72';
const dots = [0, 0.9, 1.8, 2.7]; // segundos de retraso de cada cliente
---
<div class="pscene" data-scene aria-hidden="true">
<div class="pstage">
  <svg class="track" viewBox="0 0 400 300" preserveAspectRatio="none">
    <path class="track__dash" d={PATH} />
    <path class="track__lit" d={PATH} pathLength="100" />
    {dots.map((d) => (
      <circle class="client" r="5.5" opacity="0">
        <animateMotion dur="14s" repeatCount="indefinite" begin={`${d}s`} path={PATH} keyPoints="0;0;1;1" keyTimes="0;0.5;0.72;1" calcMode="linear" />
        <animate attributeName="opacity" dur="14s" repeatCount="indefinite" begin={`${d}s`} values="0;0;1;1;0;0" keyTimes="0;0.5;0.52;0.7;0.72;1" />
      </circle>
    ))}
  </svg>

  <!-- Estaciones -->
  <div class="piece piece--ad">
    <span class="piece__tag">Anuncio</span>
    <i class="l l--dark"></i><i class="l" style="width:78%"></i><i class="l" style="width:52%"></i>
  </div>
  <div class="piece piece--site">
    <span class="piece__tag">Sitio</span>
    <i class="l l--dark" style="width:60%"></i><i class="l" style="width:88%"></i>
    <b class="piece__cta">Agendar</b>
  </div>
  <div class="piece piece--cal">
    <span class="piece__tag">Cita</span>
    <span class="cal"><i></i><i></i><i></i><i></i><i></i><i class="on"></i><i></i><i></i></span>
  </div>

  <!-- Contador de citas -->
  <span class="count count--1">+1 cita</span>
  <span class="count count--2">+2 citas</span>
  <span class="count count--3">+3 citas</span>
  <span class="count count--4">+4 citas</span>

  <!-- Etiquetas de fase -->
  <p class="label label--build">Construimos el camino</p>
  <p class="label label--flow">Y los clientes lo recorren solos</p>

  <svg class="cursor" viewBox="0 0 24 24">
    <path d="M5 3l14 9-6 1.5L16 20l-3 1.5-3-6.5-5 4z" fill="#fff" stroke="#111" stroke-width="1.5" stroke-linejoin="round" />
  </svg>
</div>
</div>

<script>
  const scenes = document.querySelectorAll<HTMLElement>('.pscene[data-scene]');
  const io = new IntersectionObserver((entries) => {
    for (const e of entries) e.target.classList.toggle('is-playing', e.isIntersecting);
  }, { threshold: 0.2 });
  scenes.forEach((s) => io.observe(s));
</script>

<style>
  /* 14 s · 1 s = 7.14 % · 0.8–2.6 anuncio · 2.6–4.5 sitio · 4.5–6.5 cita · 7–13 clientes · 13–14 apaga */
  .pscene { --dur: 14s; --play: paused; position: relative; container-type: inline-size; aspect-ratio: 4 / 3; width: 100%; }
  .pscene.is-playing { --play: running; }
  .pstage { position: absolute; inset: 0; font-size: max(0.62rem, 2.4cqw); color: #fff; }
  .pstage > *, .count, .label, .track__lit { animation-duration: var(--dur); animation-iteration-count: infinite; animation-fill-mode: both; animation-timing-function: cubic-bezier(0.4, 0, 0.2, 1); animation-play-state: var(--play); }
  @media (prefers-reduced-motion: reduce) { .pstage * { animation-play-state: paused !important; animation-delay: -12s !important; } }

  .track { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .track__dash { fill: none; stroke: rgb(255 255 255 / 0.18); stroke-width: 2; stroke-dasharray: 3 7; stroke-linecap: round; vector-effect: non-scaling-stroke; }
  .track__lit { fill: none; stroke: rgb(255 255 255 / 0.9); stroke-width: 2.5; stroke-linecap: round; stroke-dasharray: 100; stroke-dashoffset: 100; vector-effect: non-scaling-stroke; filter: drop-shadow(0 0 6px rgb(255 255 255 / 0.6)); animation-name: lit; animation-timing-function: linear; }
  .client { fill: var(--color-lime); filter: drop-shadow(0 0 6px rgb(151 239 73 / 0.9)); }

  .piece { position: absolute; translate: -50% -50%; width: 26cqw; padding: 2.4cqw; border-radius: 2.6cqw; background: linear-gradient(180deg, rgb(255 255 255 / 0.12), rgb(255 255 255 / 0.05)); box-shadow: 0 0 0 1px rgb(255 255 255 / 0.12), inset 0 1px 0 rgb(255 255 255 / 0.14), 0 30px 50px -30px rgb(0 0 0 / 0.9); backdrop-filter: blur(8px); }
  .piece__tag { display: block; margin-bottom: 1.6cqw; font-size: max(0.55rem, 2.1cqw); font-weight: 600; color: rgb(255 255 255 / 0.55); letter-spacing: 0.02em; text-transform: uppercase; }
  .l { display: block; height: 1.3cqw; margin-top: 1.1cqw; border-radius: 999px; background: rgb(255 255 255 / 0.18); }
  .l--dark { width: 46%; background: #fff; }
  .piece__cta { display: block; margin-top: 2cqw; padding: 1.2cqw 0; border-radius: 1.2cqw; text-align: center; font-size: max(0.55rem, 2.2cqw); font-weight: 600; color: #0a0a0a; background: var(--color-lime); }
  .cal { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1cqw; }
  .cal i { aspect-ratio: 1; border-radius: 0.8cqw; background: rgb(255 255 255 / 0.1); }
  .cal i.on { background: var(--color-lime); }
  .piece--ad  { left: 18%; top: 72%; animation-name: ad; }
  .piece--site { left: 50%; top: 48%; animation-name: site; }
  .piece--cal { left: 82%; top: 24%; width: 20cqw; animation-name: cal; }

  .count { position: absolute; left: 82%; top: 24%; translate: -50% -50%; margin-top: -13cqw; padding: 1cqw 2.2cqw; border-radius: 999px; font-size: max(0.6rem, 2.4cqw); font-weight: 700; color: #0a0a0a; background: var(--color-lime); box-shadow: 0 12px 24px -12px rgb(151 239 73 / 0.8); opacity: 0; }
  .count--1 { animation-name: c1; } .count--2 { animation-name: c2; } .count--3 { animation-name: c3; } .count--4 { animation-name: c4; }

  .label { position: absolute; left: 4%; top: 6%; font-size: max(0.66rem, 2.6cqw); font-weight: 500; color: rgb(255 255 255 / 0.55); opacity: 0; }
  .label--build { animation-name: lb; } .label--flow { animation-name: lf; }

  .cursor { position: absolute; left: 105%; top: 105%; width: 5cqw; z-index: 20; filter: drop-shadow(0 4px 8px rgb(0 0 0 / 0.6)); animation-name: cursor; animation-timing-function: cubic-bezier(0.65, 0, 0.35, 1); }

  /* piezas: viajan con el cursor y caen en su estación */
  @keyframes ad   { 0%, 4% { left: 105%; top: 105%; opacity: 0; transform: scale(0.9); } 6% { opacity: 1; } 18.6% { left: 18%; top: 72%; transform: scale(1.06); } 20%, 92% { left: 18%; top: 72%; opacity: 1; transform: scale(1); } 98%, 100% { opacity: 0; } }
  @keyframes site { 0%, 19% { left: 105%; top: 105%; opacity: 0; transform: scale(0.9); } 21% { opacity: 1; } 32% { left: 50%; top: 48%; transform: scale(1.06); } 33.5%, 92% { left: 50%; top: 48%; opacity: 1; transform: scale(1); } 98%, 100% { opacity: 0; } }
  @keyframes cal  { 0%, 33% { left: 105%; top: 105%; opacity: 0; transform: scale(0.9); } 35% { opacity: 1; } 46% { left: 82%; top: 24%; transform: scale(1.06); } 47.5%, 92% { left: 82%; top: 24%; opacity: 1; transform: scale(1); } 98%, 100% { opacity: 0; } }
  @keyframes cursor {
    0%, 4%  { left: 105%; top: 105%; opacity: 0; }
    6%      { opacity: 1; }
    18.6%   { left: 21%; top: 75%; }
    19.5%   { left: 21%; top: 75%; }
    32%     { left: 53%; top: 51%; }
    33%     { left: 53%; top: 51%; }
    46%     { left: 85%; top: 27%; }
    48%     { left: 85%; top: 27%; opacity: 1; }
    54%, 100% { left: 105%; top: 105%; opacity: 0; }
  }
  @keyframes lit { 0%, 20% { stroke-dashoffset: 100; opacity: 1; } 33.5% { stroke-dashoffset: 50; } 47.5%, 92% { stroke-dashoffset: 0; opacity: 1; } 98%, 100% { stroke-dashoffset: 0; opacity: 0; } }
  @keyframes c1 { 0%, 71% { opacity: 0; transform: translateY(4px); } 73%, 77% { opacity: 1; transform: none; } 78%, 100% { opacity: 0; } }
  @keyframes c2 { 0%, 77.5% { opacity: 0; transform: translateY(4px); } 79.5%, 83.5% { opacity: 1; transform: none; } 84.5%, 100% { opacity: 0; } }
  @keyframes c3 { 0%, 84% { opacity: 0; transform: translateY(4px); } 86%, 90% { opacity: 1; transform: none; } 91%, 100% { opacity: 0; } }
  @keyframes c4 { 0%, 90.5% { opacity: 0; transform: translateY(4px); } 92.5%, 96% { opacity: 1; transform: none; } 98%, 100% { opacity: 0; } }
  @keyframes lb { 0%, 3% { opacity: 0; transform: translateY(6px); } 6%, 46% { opacity: 1; transform: none; } 49%, 100% { opacity: 0; transform: translateY(-6px); } }
  @keyframes lf { 0%, 50% { opacity: 0; transform: translateY(6px); } 53%, 92% { opacity: 1; transform: none; } 96%, 100% { opacity: 0; transform: translateY(-6px); } }
</style>
