---
import SectionHeading from '../ui/SectionHeading.astro';

const moments = [
  { n: '30 min', title: 'Hablamos de tu negocio', text: 'Un diagnóstico sin costo. Te decimos si tiene sentido trabajar juntos y por dónde empezar.' },
  { n: '10 días', title: 'Tu primer win', text: 'En web, tu MVP en línea. En leads, la campaña corriendo. Resultados visibles antes de dos semanas.', win: true },
  { n: 'Todo el año', title: 'Medimos y ajustamos', text: 'Ves cuánta gente entra, cuántos agendan y qué conviene mejorar. Sin adivinar.' },
];
---

<section class="bg-paper-soft py-20 sm:py-28" aria-labelledby="how-title">
  <div class="container-x">
    <SectionHeading id="how-title" eyebrow="Cómo trabajamos" title="Ves resultados antes de avanzar" description="Sabemos que es difícil saber qué hacer para que la web y los anuncios vendan. De eso nos encargamos nosotros." />
    <ol class="mt-12 grid gap-4 lg:grid-cols-3" role="list">
      {moments.map(({ n, title, text, win }) => (
        <li class:list={['reveal flex flex-col p-6 sm:p-7', win ? 'card ring-2 ring-lime' : 'card']}>
          <span class="text-2xl font-semibold tracking-tight text-text">{n}</span>
          <h3 class="mt-1 text-lg font-semibold text-text">{title}</h3>
          <p class="mt-2 leading-relaxed text-muted">{text}</p>
          {win && <span class="mt-4 inline-flex w-fit items-center rounded-full bg-lime px-3 py-1 text-xs font-semibold text-ink">Primer win</span>}
        </li>
      ))}
    </ol>
  </div>
</section>
