---
/**
 * Escena animada del hero de Diseño Web (CSS puro, 16 s en bucle):
 * 01 el cursor investiga el negocio → palabras clave
 * 02 voz del cliente → brief
 * 03 se arma el mockup y el titular se escribe con la palabra clave
 * 04 el mockup se convierte en un proyecto real
 * 05 se une al resto de proyectos del portafolio
 */
import { Image } from 'astro:assets';
import { getProjects } from '../../lib/portfolio';

const projects = await getProjects();
const main = projects.find((p) => p.id === 'studio-luto') ?? projects[0];
const others = projects.filter((p) => p.id !== main.id && p.data.featured && p.data.cover).slice(0, 3);

const keywords = ['cerámica artesanal', 'envíos a todo México', 'pedidos personalizados'];
const voices = ['“¿Puedo comprar en línea?”', '“Quiero ver el catálogo”'];
const headline = 'Cerámica artesanal, directo a tu mesa';
const labels = ['Investigamos el negocio', 'Escuchamos a tus clientes', 'Diseñamos a la medida', 'Publicamos y suma a tu portafolio'];
---

<div class="scene" data-scene aria-hidden="true">
<div class="stage">
  <!-- Etiquetas de fase -->
  {labels.map((l, i) => (
    <p class="label" style={`--i:${i}`}><span class="label__n">0{i + 1}</span>{l}</p>
  ))}

  <!-- 01 · Negocio -->
  <div class="biz">
    <span class="biz__avatar">SL</span>
    <span class="biz__name">Studio Luto</span>
    <span class="biz__line" style="width:82%"></span>
    <span class="biz__line" style="width:58%"></span>
    <span class="biz__tag">Cerámica · Guadalajara</span>
  </div>
  {keywords.map((k, i) => (
    <span class:list={['kw', `kw--${i + 1}`]}>{k}</span>
  ))}

  <!-- 02 · Voz del cliente -->
  {voices.map((v, i) => (
    <span class:list={['voice', `voice--${i + 1}`]}>{v}</span>
  ))}
  <span class="brief">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5L20 7" /></svg>
    Brief listo
  </span>

  <!-- 03 · Mockup → 04 · Proyecto real → 05 · Tarjeta -->
  <div class="wire">
    <div class="wire__skel">
      <div class="wire__bar">
        <span class="wire__logo"></span>
        <span class="wire__nav"></span><span class="wire__nav"></span><span class="wire__nav"></span>
      </div>
      <div class="wire__hero">
        <span class="wire__h wire__h--1"></span>
        <span class="wire__h wire__h--2"></span>
        <p class="wire__headline"><span>{headline}</span></p>
        <span class="wire__btn"></span>
      </div>
      <div class="wire__img"></div>
      <div class="wire__cards"><span></span><span></span><span></span></div>
    </div>
    {main.data.cover && (
      <Image src={main.data.cover} alt="" width={720} format="webp" quality={80} loading="eager" decoding="async" class="wire__shot" />
    )}
  </div>

  {others.map((p, i) => (
    <div class="row" style={`--i:${i}`}>
      {p.data.cover && <Image src={p.data.cover} alt="" width={480} format="webp" quality={76} loading="lazy" decoding="async" />}
    </div>
  ))}

  <!-- Cursor de Mac -->
  <svg class="cursor" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M5 3l14 9-6 1.5L16 20l-3 1.5-3-6.5-5 4z" fill="#fff" stroke="#111" stroke-width="1.5" stroke-linejoin="round" />
  </svg>
</div>
</div>

<script>
  // Solo se reproduce cuando está en pantalla (ahorra CPU en móvil).
  const scenes = document.querySelectorAll<HTMLElement>('[data-scene]');
  const io = new IntersectionObserver((entries) => {
    for (const e of entries) e.target.classList.toggle('is-playing', e.isIntersecting);
  }, { threshold: 0.2 });
  scenes.forEach((s) => io.observe(s));
</script>

<style>
  /* ---------- Línea de tiempo: 16 s. Porcentaje = segundos × 6.25 ---------- */
  .scene {
    --dur: 16s;
    --play: paused;
    position: relative;
    overflow: hidden;
    container-type: inline-size;
    aspect-ratio: 4 / 3;
    width: 100%;
    background: var(--color-paper);
  }
  /* Las unidades cqw se resuelven contra .scene, por eso el contenido va en un hijo */
  .stage { position: absolute; inset: 0; font-size: max(0.62rem, 2.6cqw); }
  .scene.is-playing { --play: running; }
  .stage > *, .scene .wire__skel > *, .scene .wire__hero > *, .scene .wire__cards > span, .scene .wire__shot {
    animation-duration: var(--dur);
    animation-iteration-count: infinite;
    animation-fill-mode: both;
    animation-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
    animation-play-state: var(--play);
  }
  @media (prefers-reduced-motion: reduce) {
    /* Sin movimiento: se muestra el cuadro final (segundo 14.6) */
    .scene *, .scene { animation-play-state: paused !important; animation-delay: -14.6s !important; animation-duration: var(--dur) !important; }
  }

  /* ---------- Piezas ---------- */
  .label {
    position: absolute; left: 5%; top: 5%;
    display: inline-flex; align-items: center; gap: 0.6em;
    font-size: max(0.7rem, 2.9cqw); font-weight: 500; color: var(--color-muted);
    opacity: 0;
  }
  .label__n { font-size: 0.85em; color: var(--color-faint); }

  .biz {
    position: absolute; left: 8%; top: 30%; width: 34%;
    display: grid; grid-template-columns: auto 1fr; column-gap: 3cqw; row-gap: 1.6cqw; align-items: center;
    padding: 4cqw; border-radius: 4cqw;
    background: var(--color-paper);
    box-shadow: 0 0 0 1px var(--color-line), 0 24px 48px -28px rgb(0 0 0 / 0.25);
    animation-name: biz;
  }
  .biz__avatar { grid-row: span 3; display: grid; place-items: center; width: 9cqw; height: 9cqw; border-radius: 50%; background: #111; color: #fff; font-size: 0.85em; font-weight: 600; }
  .biz__name { font-weight: 600; color: var(--color-text); }
  .biz__line { display: block; height: 1.4cqw; border-radius: 999px; background: var(--color-surface-hover); }
  .biz__tag { grid-column: 2; font-size: 0.8em; color: var(--color-faint); white-space: nowrap; }

  .kw, .voice, .brief {
    position: absolute; display: inline-flex; align-items: center; gap: 0.5em; white-space: nowrap;
    padding: 1.8cqw 3.2cqw; border-radius: 2.4cqw; font-weight: 500; line-height: 1.2;
  }
  .kw {
    color: #ececec;
    background: linear-gradient(180deg, #3b3b3b, #262626);
    box-shadow: 0 10px 22px -10px rgb(0 0 0 / 0.7), inset 0 1px 0 rgb(255 255 255 / 0.14);
    transform-origin: center;
  }
  .kw--1 { left: 46%; top: 24%; animation-name: kw1; }
  .kw--2 { left: 50%; top: 40%; animation-name: kw2; }
  .kw--3 { left: 44%; top: 56%; animation-name: kw3; }
  .voice {
    color: var(--color-text); background: var(--color-surface);
    box-shadow: 0 0 0 1px var(--color-line);
    border-bottom-left-radius: 0.6cqw;
  }
  .voice--1 { left: 58%; top: 60%; animation-name: voice1; }
  .voice--2 { left: 62%; top: 74%; animation-name: voice2; }
  .brief {
    left: 50%; top: 86%; translate: -50% 0;
    color: #0a0a0a; background: var(--color-lime);
    box-shadow: 0 14px 28px -14px rgb(151 239 73 / 0.7);
    animation-name: brief;
  }
  .brief svg { width: 1.1em; height: 1.1em; }

  /* Mockup */
  .wire {
    position: absolute; left: 14%; top: 14%; width: 72%; aspect-ratio: 4 / 3;
    border-radius: 4cqw; overflow: hidden;
    background: var(--color-paper);
    box-shadow: 0 0 0 1px var(--color-line), 0 30px 60px -30px rgb(0 0 0 / 0.3);
    transform-origin: 0 0;
    animation-name: wire;
  }
  .wire__skel { position: absolute; inset: 0; padding: 4cqw; display: flex; flex-direction: column; gap: 3cqw; }
  .wire__bar { display: flex; align-items: center; gap: 2cqw; }
  .wire__logo { width: 9cqw; height: 2.4cqw; border-radius: 999px; background: #111; }
  .wire__nav { width: 5cqw; height: 1.6cqw; border-radius: 999px; background: var(--color-surface-hover); }
  .wire__nav:first-of-type { margin-left: auto; }
  .wire__hero { position: relative; display: flex; flex-direction: column; gap: 2cqw; padding-top: 2cqw; }
  .wire__h { display: block; height: 3.4cqw; border-radius: 999px; background: var(--color-surface-hover); }
  .wire__h--1 { width: 78%; } .wire__h--2 { width: 52%; }
  .wire__btn { width: 16cqw; height: 4cqw; border-radius: 1.4cqw; background: #111; }
  .wire__headline {
    position: absolute; left: 0; top: 2cqw; width: 100%;
    font-size: max(0.8rem, 3.6cqw); font-weight: 600; line-height: 1.15; letter-spacing: -0.02em; color: var(--color-text);
    white-space: nowrap; overflow: hidden;
  }
  .wire__headline span { display: inline-block; }
  .wire__img { flex: 1; border-radius: 2.4cqw; background: linear-gradient(135deg, var(--color-surface), var(--color-surface-hover)); }
  .wire__cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2cqw; }
  .wire__cards span { height: 9cqw; border-radius: 2cqw; background: var(--color-surface); box-shadow: inset 0 0 0 1px var(--color-line); }
  .wire__shot { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; animation-name: shot; }

  /* Esqueleto: aparece por partes */
  .wire__bar, .wire__hero, .wire__img, .wire__cards { animation-name: skel; }
  .wire__hero { animation-delay: 0.25s; } .wire__img { animation-delay: 0.5s; } .wire__cards { animation-delay: 0.75s; }
  .wire__h { animation-name: hbar; }
  .wire__headline { animation-name: headline; }
  .wire__headline span { animation: type var(--dur) steps(30) infinite both; animation-play-state: var(--play); }

  /* Fila final de proyectos */
  .row {
    position: absolute; top: 36%; width: 27%; aspect-ratio: 4 / 3;
    left: calc(36.5% + var(--i) * 30.5%);
    border-radius: 3cqw; overflow: hidden;
    box-shadow: 0 0 0 1px var(--color-line);
    animation-name: row;
    animation-delay: calc(var(--i) * 0.18s);
  }
  .row img { width: 100%; height: 100%; object-fit: cover; }

  .cursor {
    position: absolute; left: 105%; top: 95%; width: 6cqw; z-index: 20;
    filter: drop-shadow(0 4px 8px rgb(0 0 0 / 0.35));
    animation-name: cursor;
    animation-timing-function: cubic-bezier(0.65, 0, 0.35, 1);
  }

  /* ---------- Keyframes (0.5 s = 3.125 %) ---------- */
  @keyframes cursor {
    0%, 3%   { left: 105%; top: 95%; opacity: 0; transform: scale(1); }
    6%       { opacity: 1; }
    9.4%     { left: 24%; top: 44%; transform: scale(1); }
    10.5%    { transform: scale(0.8); }
    11.5%, 22% { left: 24%; top: 44%; transform: scale(1); }
    26%      { left: 68%; top: 65%; }
    34.4%    { left: 54%; top: 88%; transform: scale(1); }
    36%      { transform: scale(0.8); }
    37%, 44% { left: 54%; top: 88%; transform: scale(1); }
    50%      { left: 12%; top: 10%; }
    56.25%   { left: 30%; top: 40%; transform: scale(1); }
    57.5%    { transform: scale(0.8); }
    58.5%, 72% { left: 30%; top: 40%; transform: scale(1); }
    78%      { left: 82%; top: 80%; opacity: 1; }
    85%, 100% { left: 105%; top: 95%; opacity: 0; }
  }
  /* Una animación por etiqueta de fase */
  .label:nth-child(1) { animation-name: label1; }
  .label:nth-child(2) { animation-name: label2; }
  .label:nth-child(3) { animation-name: label3; }
  .label:nth-child(4) { animation-name: label4; }
  @keyframes label1 { 0%,3%{opacity:0;transform:translateY(6px)} 6%,20%{opacity:1;transform:none} 22.5%,100%{opacity:0;transform:translateY(-6px)} }
  @keyframes label2 { 0%,22.5%{opacity:0;transform:translateY(6px)} 25%,39%{opacity:1;transform:none} 41.5%,100%{opacity:0;transform:translateY(-6px)} }
  @keyframes label3 { 0%,42%{opacity:0;transform:translateY(6px)} 45%,78%{opacity:1;transform:none} 80.5%,100%{opacity:0;transform:translateY(-6px)} }
  @keyframes label4 { 0%,81%{opacity:0;transform:translateY(6px)} 84%,95%{opacity:1;transform:none} 98%,100%{opacity:0;transform:translateY(-6px)} }

  @keyframes biz {
    0%        { opacity: 0; transform: translateY(10px) scale(0.98); }
    3%, 40.6% { opacity: 1; transform: none; }
    43.75%, 100% { opacity: 0; transform: translateY(-8px) scale(0.98); }
  }
  @keyframes kw1 {
    0%, 11.25% { opacity: 0; transform: scale(0.6); left: 46%; top: 24%; }
    13%, 40.6% { opacity: 1; transform: scale(1); left: 46%; top: 24%; }
    43.75%, 50% { opacity: 1; transform: scale(1); left: 4%; top: 6%; }
    56.25%, 57.5% { opacity: 1; transform: scale(1); left: 22%; top: 35%; }
    59.5%, 100% { opacity: 0; transform: scale(0.7); left: 22%; top: 35%; }
  }
  @keyframes kw2 {
    0%, 13.1% { opacity: 0; transform: scale(0.6); left: 50%; top: 40%; }
    15%, 34.4% { opacity: 1; transform: scale(1); left: 50%; top: 40%; }
    37.5%, 100% { opacity: 0; transform: scale(0.3); left: 48%; top: 86%; }
  }
  @keyframes kw3 {
    0%, 15% { opacity: 0; transform: scale(0.6); left: 44%; top: 56%; }
    17%, 35% { opacity: 1; transform: scale(1); left: 44%; top: 56%; }
    38.5%, 100% { opacity: 0; transform: scale(0.3); left: 46%; top: 86%; }
  }
  @keyframes voice1 {
    0%, 23.75% { opacity: 0; transform: scale(0.7); left: 58%; top: 60%; }
    26.25% { opacity: 1; transform: scale(1); left: 58%; top: 60%; }
    34.4% { opacity: 1; transform: scale(0.9); left: 46%; top: 84%; }
    35.5%, 100% { opacity: 0; transform: scale(0.3); left: 46%; top: 86%; }
  }
  @keyframes voice2 {
    0%, 26.25% { opacity: 0; transform: scale(0.7); left: 62%; top: 74%; }
    28.75%, 35% { opacity: 1; transform: scale(1); left: 62%; top: 74%; }
    38.5%, 100% { opacity: 0; transform: scale(0.3); left: 50%; top: 86%; }
  }
  @keyframes brief {
    0%, 36% { opacity: 0; transform: scale(0.7); }
    38% { opacity: 1; transform: scale(1.06); }
    39.5%, 40.6% { opacity: 1; transform: scale(1); }
    43.75%, 100% { opacity: 0; transform: scale(0.9); }
  }
  @keyframes wire {
    0%, 42% { opacity: 0; transform: translateY(12px) scale(0.97); }
    46%, 81.25% { opacity: 1; transform: none; }
    90%, 96.25% { opacity: 1; transform: translate(-8cqw, 16.5cqw) scale(0.375); }
    100% { opacity: 0; transform: translate(-8cqw, 16.5cqw) scale(0.375); }
  }
  @keyframes skel {
    0%, 44% { opacity: 0; transform: translateY(6px); }
    48%, 100% { opacity: 1; transform: none; }
  }
  @keyframes hbar {
    0%, 56% { opacity: 1; }
    59%, 100% { opacity: 0; }
  }
  @keyframes headline {
    0%, 57.5% { opacity: 0; }
    58%, 100% { opacity: 1; }
  }
  @keyframes type {
    0%, 57.5% { clip-path: inset(0 100% 0 0); }
    65.6%, 100% { clip-path: inset(0 0 0 0); }
  }
  @keyframes shot {
    0%, 65.6% { opacity: 0; }
    71.9%, 100% { opacity: 1; }
  }
  @keyframes row {
    0%, 84% { opacity: 0; transform: translateX(40cqw); }
    90%, 96.25% { opacity: 1; transform: none; }
    100% { opacity: 0; transform: none; }
  }
</style>
