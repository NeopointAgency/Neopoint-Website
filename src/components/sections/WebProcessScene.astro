---
/**
 * Escena animada del hero de Diseño Web (CSS puro, 16 s en bucle, con capas encimadas):
 * 01 el cursor investiga el negocio → palabras clave que pisan la ficha
 * 02 voz del cliente (burbujas encimadas) → brief
 * 03 se arma el mockup, el titular se escribe y cae la foto real inclinada encima
 * 04 la foto cubre el mockup: es el proyecto publicado
 * 05 el sitio se hace a un lado y aparece el panel de monitoreo (visitas, leads, citas)
 */
import { Image } from 'astro:assets';
import { getProjects } from '../../lib/portfolio';

const projects = await getProjects();
const main = projects.find((p) => p.id === 'studio-luto') ?? projects[0];

const keywords = ['cerámica artesanal', 'envíos a todo México', 'pedidos personalizados'];
const voices = [
  { initial: 'M', text: '¿Puedo comprar en línea?' },
  { initial: 'R', text: 'Quiero ver el catálogo' },
];
const headline = 'Cerámica artesanal, directo a tu mesa';
const labels = ['Investigamos el negocio', 'Escuchamos a tus clientes', 'Diseñamos a la medida', 'Publicamos y medimos tus leads'];
---

<div class="scene" data-scene aria-hidden="true">
<div class="stage">
  <div class="backdrop"></div>

  {labels.map((l, i) => (
    <p class="label"><span class="label__n">0{i + 1}</span>{l}</p>
  ))}

  <!-- 01 · Negocio -->
  <div class="biz">
    <span class="biz__avatar">SL</span>
    <span class="biz__name">Studio Luto</span>
    <span class="biz__line" style="width:82%"></span>
    <span class="biz__line" style="width:58%"></span>
    <span class="biz__tag">Guadalajara, Jal.</span>
  </div>
  <span class="tile tile--search">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="11" cy="11" r="6.5" /><path d="m20 20-4-4" /></svg>
  </span>
  {keywords.map((k, i) => (
    <span class:list={['kw', `kw--${i + 1}`]}>{k}</span>
  ))}

  <!-- 02 · Voz del cliente -->
  {voices.map((v, i) => (
    <span class:list={['voice', `voice--${i + 1}`]}>
      <i class="voice__avatar">{v.initial}</i>“{v.text}”
    </span>
  ))}
  <span class="brief">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5L20 7" /></svg>
    Brief listo
  </span>

  <!-- 03 · Mockup -->
  <div class="wire">
    <div class="wire__bar">
      <span class="wire__logo"></span>
      <span class="wire__nav"></span><span class="wire__nav"></span><span class="wire__nav"></span>
    </div>
    <div class="wire__hero">
      <span class="wire__h wire__h--1"></span>
      <span class="wire__h wire__h--2"></span>
      <p class="wire__headline"><span>{headline}</span></p>
      <span class="wire__btn"></span>
    </div>
    <div class="wire__img"></div>
    <div class="wire__cards"><span></span><span></span><span></span></div>
  </div>
  <span class="tile tile--brush">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3l7 7-9 9H5v-7l9-9Z" /><path d="M12 5l7 7" /></svg>
  </span>

  <!-- 05 · Panel de monitoreo -->
  <div class="dash">
    <div class="dash__head"><span>Tu panel</span><span class="dash__range">12 meses</span></div>
    <div class="dash__kpis">
      {[['Visitas', '4,820'], ['Leads', '132'], ['Citas', '41']].map(([k, v]) => (
        <div class="dash__kpi"><span class="dash__k">{k}</span><span class="dash__v">{v}</span></div>
      ))}
    </div>
    <div class="dash__bars">
      {[38, 46, 42, 58, 64, 60, 72, 78, 74, 88, 92, 100].map((h, i) => (
        <span class:list={['dash__bar', i === 11 && 'dash__bar--last']} style={`height:${h}%; --d:${i}`}></span>
      ))}
    </div>
  </div>

  <!-- 04 · Foto real: cae inclinada sobre el mockup, lo cubre y luego se abanica -->
  <div class="photo">
    {main.data.cover && (
      <Image src={main.data.cover} alt="" width={800} format="webp" quality={80} loading="eager" decoding="async" />
    )}
  </div>
  <span class="tile tile--check">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5L20 7" /></svg>
  </span>

  <!-- Cursor de Mac -->
  <svg class="cursor" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M5 3l14 9-6 1.5L16 20l-3 1.5-3-6.5-5 4z" fill="#fff" stroke="#111" stroke-width="1.5" stroke-linejoin="round" />
  </svg>
</div>
</div>

<script>
  // Solo se reproduce cuando está en pantalla (ahorra CPU en móvil).
  const scenes = document.querySelectorAll<HTMLElement>('[data-scene]');
  const io = new IntersectionObserver((entries) => {
    for (const e of entries) e.target.classList.toggle('is-playing', e.isIntersecting);
  }, { threshold: 0.2 });
  scenes.forEach((s) => io.observe(s));
</script>

<style>
  /* ---------- Línea de tiempo: 16 s. Porcentaje = segundos × 6.25 ---------- */
  .scene {
    --dur: 16s;
    --play: paused;
    position: relative;
    overflow: hidden;
    container-type: inline-size;
    aspect-ratio: 4 / 3;
    width: 100%;
    background: var(--color-paper);
  }
  .scene.is-playing { --play: running; }
  /* Las unidades cqw se resuelven contra .scene, por eso el contenido va en un hijo */
  .stage { position: absolute; inset: 0; font-size: max(0.62rem, 2.6cqw); }
  .stage > *, .wire > *, .wire__hero > *, .dash__bars > * {
    animation-duration: var(--dur);
    animation-iteration-count: infinite;
    animation-fill-mode: both;
    animation-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
    animation-play-state: var(--play);
  }
  @media (prefers-reduced-motion: reduce) {
    /* Sin movimiento: se muestra el cuadro final (segundo 14.6) */
    .scene * { animation-play-state: paused !important; animation-delay: -14.6s !important; animation-duration: var(--dur) !important; }
  }

  /* ---------- Capas (z): fondo 0 · ficha/mockup 3 · fila 3-4 · píldoras 5 · burbujas 6 · foto/baldosas 7-8 · cursor 20 ---------- */
  .backdrop {
    position: absolute; left: 4%; top: 15%; right: 4%; bottom: 6%; z-index: 0;
    border-radius: 6cqw;
    background: var(--color-paper-soft);
  }
  .label {
    position: absolute; left: 5%; top: 4.5%; z-index: 2;
    display: inline-flex; align-items: center; gap: 0.6em;
    font-size: max(0.7rem, 2.9cqw); font-weight: 500; color: var(--color-muted);
    opacity: 0;
  }
  .label__n { font-size: 0.85em; color: var(--color-faint); }

  .biz {
    position: absolute; left: 7%; top: 30%; width: 40%; z-index: 3;
    display: grid; grid-template-columns: auto 1fr; column-gap: 2.6cqw; row-gap: 1.6cqw; align-items: center;
    padding: 3.6cqw; border-radius: 4cqw;
    background: var(--color-paper);
    box-shadow: 0 0 0 1px var(--color-line), 0 30px 50px -28px rgb(0 0 0 / 0.3);
    animation-name: biz;
  }
  .biz__avatar { grid-row: span 3; display: grid; place-items: center; width: 8cqw; height: 8cqw; border-radius: 50%; background: #111; color: #fff; font-size: 0.85em; font-weight: 600; }
  .biz__name { min-width: 0; font-weight: 600; color: var(--color-text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .biz__line { display: block; height: 1.4cqw; border-radius: 999px; background: var(--color-surface-hover); }
  .biz__tag { grid-column: 2; min-width: 0; font-size: 0.78em; color: var(--color-faint); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

  /* Baldosas flotantes (mismo acabado que las tarjetas ilustradas) */
  .tile {
    position: absolute; z-index: 8;
    display: inline-flex; align-items: center; justify-content: center;
    width: 11cqw; height: 11cqw; border-radius: 2.8cqw; color: #161616;
    background: linear-gradient(160deg, #ffffff 0%, #e6e6e6 60%, #d0d0d0 100%);
    box-shadow: 0 18px 30px -14px rgb(0 0 0 / 0.45), inset 0 1px 0 #fff, 0 0 0 1px rgb(0 0 0 / 0.06);
  }
  .tile svg { width: 52%; height: 52%; }
  .tile--search { left: 2%; top: 22%; --tilt: -8deg; animation-name: tileSearch; }
  .tile--brush { left: 80%; top: 8%; --tilt: 9deg; animation-name: tileBrush; }
  .tile--check { left: 87%; top: 70%; --tilt: 6deg; color: #0a0a0a; background: linear-gradient(160deg, #d6ff9e, #97ef49); animation-name: tileCheck; }

  .kw, .voice, .brief {
    position: absolute; display: inline-flex; align-items: center; gap: 0.5em; white-space: nowrap;
    padding: 1.8cqw 3.2cqw; border-radius: 2.4cqw; font-weight: 500; line-height: 1.2;
  }
  .kw {
    z-index: 5; color: #ececec;
    background: linear-gradient(180deg, #3b3b3b, #262626);
    box-shadow: 0 14px 26px -12px rgb(0 0 0 / 0.75), inset 0 1px 0 rgb(255 255 255 / 0.14);
    transform-origin: center;
  }
  .kw--1 { left: 36%; top: 23%; animation-name: kw1; }
  .kw--2 { left: 42%; top: 41%; animation-name: kw2; }
  .kw--3 { left: 33%; top: 59%; animation-name: kw3; }

  .voice {
    z-index: 6; padding-left: 5.4cqw;
    color: var(--color-text); background: var(--color-paper);
    box-shadow: 0 0 0 1px var(--color-line), 0 18px 30px -18px rgb(0 0 0 / 0.35);
    border-bottom-left-radius: 0.6cqw;
  }
  .voice__avatar {
    position: absolute; left: -2.4cqw; top: -2.2cqw;
    display: grid; place-items: center; width: 6.2cqw; height: 6.2cqw; border-radius: 50%;
    background: #111; color: #fff; font-style: normal; font-size: 0.72em; font-weight: 600;
    box-shadow: 0 0 0 2px var(--color-paper);
  }
  .voice--1 { left: 46%; top: 59%; animation-name: voice1; }
  .voice--2 { left: 60%; top: 71%; z-index: 7; animation-name: voice2; }
  .brief {
    left: 50%; top: 84%; z-index: 7; translate: -50% 0;
    color: #0a0a0a; background: var(--color-lime);
    box-shadow: 0 16px 30px -14px rgb(151 239 73 / 0.8);
    animation-name: brief;
  }
  .brief svg { width: 1.1em; height: 1.1em; }

  /* Mockup */
  .wire {
    position: absolute; left: 14%; top: 14%; width: 72%; aspect-ratio: 4 / 3; z-index: 3;
    display: flex; flex-direction: column; gap: 3cqw; padding: 4cqw;
    border-radius: 4cqw; overflow: hidden;
    background: var(--color-paper);
    box-shadow: 0 0 0 1px var(--color-line), 0 34px 60px -30px rgb(0 0 0 / 0.35);
    will-change: transform, opacity;
    animation-name: wire;
  }
  .wire__bar { display: flex; align-items: center; gap: 2cqw; }
  .wire__logo { width: 9cqw; height: 2.4cqw; border-radius: 999px; background: #111; }
  .wire__nav { width: 5cqw; height: 1.6cqw; border-radius: 999px; background: var(--color-surface-hover); }
  .wire__nav:first-of-type { margin-left: auto; }
  .wire__hero { position: relative; display: flex; flex-direction: column; gap: 2cqw; padding-top: 2cqw; }
  .wire__h { display: block; height: 3.4cqw; border-radius: 999px; background: var(--color-surface-hover); }
  .wire__h--1 { width: 78%; } .wire__h--2 { width: 52%; }
  .wire__btn { width: 16cqw; height: 4cqw; border-radius: 1.4cqw; background: #111; }
  .wire__headline {
    position: absolute; left: 0; top: 2cqw; width: 100%;
    font-size: max(0.8rem, 3.6cqw); font-weight: 600; line-height: 1.15; letter-spacing: -0.02em; color: var(--color-text);
    white-space: nowrap; overflow: hidden;
  }
  .wire__headline span { display: inline-block; }
  .wire__img { flex: 1; border-radius: 2.4cqw; background: linear-gradient(135deg, var(--color-surface), var(--color-surface-hover)); }
  .wire__cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2cqw; }
  .wire__cards span { height: 9cqw; border-radius: 2cqw; background: var(--color-surface); box-shadow: inset 0 0 0 1px var(--color-line); }

  .wire__bar, .wire__hero, .wire__img, .wire__cards { animation-name: skel; }
  .wire__hero { animation-delay: 0.25s; } .wire__img { animation-delay: 0.5s; } .wire__cards { animation-delay: 0.75s; }
  .wire__h { animation-name: hbar; }
  .wire__headline { animation-name: headline; }
  .wire__headline span { animation: type var(--dur) steps(30) infinite both; animation-play-state: var(--play); }

  /* Foto real: misma caja que el mockup; se mueve con transform */
  .photo {
    position: absolute; left: 14%; top: 14%; width: 72%; aspect-ratio: 4 / 3; z-index: 7;
    border-radius: 4cqw; overflow: hidden;
    box-shadow: 0 0 0 1px rgb(0 0 0 / 0.08), 0 40px 70px -30px rgb(0 0 0 / 0.5);
    transform-origin: 0 0;
    will-change: transform; /* evita que Chrome deje de pintar la imagen al terminar la transformación */
    animation-name: photo;
  }
  .photo img { width: 100%; height: 100%; object-fit: cover; }


  /* Panel de monitoreo (escena 05) */
  .dash {
    position: absolute; left: 50%; top: 24%; width: 44%; z-index: 6;
    padding: 3cqw; border-radius: 3.2cqw;
    background: linear-gradient(180deg, #2a2a2a, #161616);
    box-shadow: 0 0 0 1px rgb(255 255 255 / 0.12), inset 0 1px 0 rgb(255 255 255 / 0.12), 0 34px 60px -30px rgb(0 0 0 / 0.9);
    color: #fff;
    will-change: transform;
    animation-name: dash;
  }
  .dash__head { display: flex; justify-content: space-between; align-items: center; font-size: max(0.6rem, 2.6cqw); font-weight: 600; }
  .dash__range { font-size: 0.8em; font-weight: 500; color: rgb(255 255 255 / 0.45); }
  .dash__kpis { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.6cqw; margin-top: 2.4cqw; }
  .dash__kpi { padding: 1.8cqw; border-radius: 1.8cqw; background: rgb(255 255 255 / 0.07); }
  .dash__k { display: block; font-size: max(0.5rem, 2cqw); color: rgb(255 255 255 / 0.5); }
  .dash__v { display: block; margin-top: 0.4cqw; font-size: max(0.75rem, 3.4cqw); font-weight: 600; line-height: 1; }
  .dash__bars { display: flex; align-items: flex-end; gap: 0.9cqw; height: 12cqw; margin-top: 2.6cqw; padding: 2cqw; border-radius: 1.8cqw; background: rgb(255 255 255 / 0.05); }
  .dash__bar {
    flex: 1; border-radius: 0.5cqw; background: rgb(255 255 255 / 0.3);
    transform-origin: bottom; transform: scaleY(0);
    animation-name: bar; animation-delay: calc(var(--d) * 0.04s);
  }
  .dash__bar--last { background: var(--color-lime); }

  .cursor {
    position: absolute; left: 105%; top: 95%; width: 6cqw; z-index: 20;
    filter: drop-shadow(0 4px 8px rgb(0 0 0 / 0.35));
    animation-name: cursor;
    animation-timing-function: cubic-bezier(0.65, 0, 0.35, 1);
  }

  /* ---------- Keyframes (0.5 s = 3.125 %) ---------- */
  @keyframes cursor {
    0%, 3%   { left: 105%; top: 95%; opacity: 0; transform: scale(1); }
    6%       { opacity: 1; }
    9.4%     { left: 24%; top: 44%; transform: scale(1); }
    10.5%    { transform: scale(0.8); }
    11.5%, 22% { left: 24%; top: 44%; transform: scale(1); }
    26%      { left: 60%; top: 64%; }
    34.4%    { left: 54%; top: 86%; transform: scale(1); }
    36%      { transform: scale(0.8); }
    37%, 44% { left: 54%; top: 86%; transform: scale(1); }
    50%      { left: 12%; top: 90%; }
    56.25%   { left: 30%; top: 40%; transform: scale(1); }
    57.5%    { transform: scale(0.8); }
    58.5%, 72% { left: 30%; top: 40%; transform: scale(1); }
    78%      { left: 82%; top: 80%; opacity: 1; }
    85%, 100% { left: 105%; top: 95%; opacity: 0; }
  }
  .label:nth-of-type(1) { animation-name: label1; }
  .label:nth-of-type(2) { animation-name: label2; }
  .label:nth-of-type(3) { animation-name: label3; }
  .label:nth-of-type(4) { animation-name: label4; }
  @keyframes label1 { 0%,3%{opacity:0;transform:translateY(6px)} 6%,20%{opacity:1;transform:none} 22.5%,100%{opacity:0;transform:translateY(-6px)} }
  @keyframes label2 { 0%,22.5%{opacity:0;transform:translateY(6px)} 25%,39%{opacity:1;transform:none} 41.5%,100%{opacity:0;transform:translateY(-6px)} }
  @keyframes label3 { 0%,42%{opacity:0;transform:translateY(6px)} 45%,78%{opacity:1;transform:none} 80.5%,100%{opacity:0;transform:translateY(-6px)} }
  @keyframes label4 { 0%,81%{opacity:0;transform:translateY(6px)} 84%,95%{opacity:1;transform:none} 98%,100%{opacity:0;transform:translateY(-6px)} }

  @keyframes biz {
    0%        { opacity: 0; transform: translateY(10px) scale(0.98); }
    3%, 40.6% { opacity: 1; transform: none; }
    43.75%, 100% { opacity: 0; transform: translateY(-8px) scale(0.98); }
  }
  @keyframes tileSearch {
    0%, 4.5% { opacity: 0; transform: rotate(var(--tilt)) scale(0.5) translateY(10px); }
    7%, 40.6% { opacity: 1; transform: rotate(var(--tilt)) scale(1); }
    43.75%, 100% { opacity: 0; transform: rotate(var(--tilt)) scale(0.7); }
  }
  @keyframes tileBrush {
    0%, 46% { opacity: 0; transform: rotate(var(--tilt)) scale(0.5) translateY(10px); }
    49%, 79% { opacity: 1; transform: rotate(var(--tilt)) scale(1); }
    82%, 100% { opacity: 0; transform: rotate(var(--tilt)) scale(0.7); }
  }
  @keyframes tileCheck {
    0%, 88% { opacity: 0; transform: rotate(var(--tilt)) scale(0.5) translateY(10px); }
    91%, 96.25% { opacity: 1; transform: rotate(var(--tilt)) scale(1); }
    100% { opacity: 0; transform: rotate(var(--tilt)) scale(0.8); }
  }
  @keyframes kw1 {
    0%, 11.25% { opacity: 0; transform: scale(0.6); left: 36%; top: 23%; }
    13%, 40.6% { opacity: 1; transform: scale(1); left: 36%; top: 23%; }
    43.75%, 50% { opacity: 1; transform: scale(1); left: 4%; top: 86%; }
    56.25%, 57.5% { opacity: 1; transform: scale(1); left: 22%; top: 35%; }
    59.5%, 100% { opacity: 0; transform: scale(0.7); left: 22%; top: 35%; }
  }
  @keyframes kw2 {
    0%, 13.1% { opacity: 0; transform: scale(0.6); left: 42%; top: 41%; }
    15%, 34.4% { opacity: 1; transform: scale(1); left: 42%; top: 41%; }
    37.5%, 100% { opacity: 0; transform: scale(0.3); left: 48%; top: 84%; }
  }
  @keyframes kw3 {
    0%, 15% { opacity: 0; transform: scale(0.6); left: 33%; top: 59%; }
    17%, 35% { opacity: 1; transform: scale(1); left: 33%; top: 59%; }
    38.5%, 100% { opacity: 0; transform: scale(0.3); left: 46%; top: 84%; }
  }
  @keyframes voice1 {
    0%, 23.75% { opacity: 0; transform: scale(0.7); left: 46%; top: 59%; }
    26.25% { opacity: 1; transform: scale(1); left: 46%; top: 59%; }
    34.4% { opacity: 1; transform: scale(0.9); left: 46%; top: 82%; }
    35.5%, 100% { opacity: 0; transform: scale(0.3); left: 46%; top: 84%; }
  }
  @keyframes voice2 {
    0%, 26.25% { opacity: 0; transform: scale(0.7); left: 60%; top: 71%; }
    28.75%, 35% { opacity: 1; transform: scale(1); left: 60%; top: 71%; }
    38.5%, 100% { opacity: 0; transform: scale(0.3); left: 50%; top: 84%; }
  }
  @keyframes brief {
    0%, 36% { opacity: 0; transform: scale(0.7); }
    38% { opacity: 1; transform: scale(1.06); }
    39.5%, 40.6% { opacity: 1; transform: scale(1); }
    43.75%, 100% { opacity: 0; transform: scale(0.9); }
  }
  @keyframes wire {
    0%, 42% { opacity: 0; transform: translateY(12px) scale(0.97); }
    46%, 74% { opacity: 1; transform: none; }
    78%, 100% { opacity: 0; transform: none; }
  }
  @keyframes skel {
    0%, 44% { opacity: 0; transform: translateY(6px); }
    48%, 100% { opacity: 1; transform: none; }
  }
  @keyframes hbar { 0%, 56% { opacity: 1; } 59%, 100% { opacity: 0; } }
  @keyframes headline { 0%, 57.5% { opacity: 0; } 58%, 100% { opacity: 1; } }
  @keyframes type {
    0%, 57.5% { clip-path: inset(0 100% 0 0); }
    65.6%, 100% { clip-path: inset(0 0 0 0); }
  }
  /* Foto: entra inclinada sobre la esquina del mockup → lo cubre → se abanica al frente */
  @keyframes photo {
    0%, 59.5% { opacity: 0; transform: translate(46cqw, 30cqw) scale(0.47) rotate(-6deg); }
    62.5%, 66% { opacity: 1; transform: translate(44cqw, 24cqw) scale(0.47) rotate(-6deg); }
    72%, 81.25% { opacity: 1; transform: translate(0, 0) scale(1) rotate(0deg); }
    90%, 96.25% { opacity: 1; transform: translate(-8cqw, 12cqw) scale(0.556) rotate(-3deg); }
    100% { opacity: 0; transform: translate(-8cqw, 12cqw) scale(0.556) rotate(-3deg); }
  }
  @keyframes dash {
    0%, 85% { opacity: 0; transform: translate(10cqw, 0) scale(0.96); }
    90%, 96.25% { opacity: 1; transform: none; }
    100% { opacity: 0; transform: none; }
  }
  @keyframes bar {
    0%, 87% { transform: scaleY(0); }
    91%, 100% { transform: scaleY(1); }
  }
</style>
