---
import { Image } from 'astro:assets';
import Button from '../ui/Button.astro';
import { site } from '../../data/site';
import { heroStats } from '../../data/home';
import { getProjects, projectHref } from '../../lib/portfolio';

const projects = (await getProjects()).filter((p) => p.data.cover);
// Dos carriles: proyectos alternados; cada carril se duplica para el bucle infinito.
const lanes = [projects.filter((_, i) => i % 2 === 0), projects.filter((_, i) => i % 2 === 1)];
---

<section class="relative flex min-h-svh flex-col justify-center overflow-hidden bg-ink text-white" aria-labelledby="hero-title">
  <!-- Carriles de proyectos -->
  <div class="absolute inset-0 flex flex-col justify-center gap-5 py-6 lg:pl-[38%]" aria-hidden="false">
    {lanes.map((lane, l) => (
      <ul
        class:list={['lane flex w-max gap-5 pr-5 motion-reduce:animate-none', l === 1 && '[animation-direction:reverse]']}
        role="list"
        aria-label={`Proyectos, carril ${l + 1}`}
      >
        {[0, 1].map((copy) =>
          lane.map((p, i) => (
            <li class="shrink-0" aria-hidden={copy === 1 ? 'true' : undefined}>
              <a
                href={projectHref(p)}
                tabindex={copy === 1 ? -1 : 0}
                class="card group relative block h-[13rem] w-[21rem] overflow-hidden rounded-card bg-ink-soft transition-[transform,box-shadow] duration-500 ease-(--ease-out-expo) hover:-translate-y-1.5 hover:shadow-[0_30px_70px_-20px_rgba(255,255,255,0.28)] sm:h-[16rem] sm:w-[26rem]"
                aria-label={`Ver proyecto ${p.data.title}`}
              >
                <Image
                  src={p.data.cover!}
                  alt=""
                  widths={[480, 720]}
                  sizes="26rem"
                  format="webp"
                  quality={78}
                  loading={copy === 0 && i < 3 ? 'eager' : 'lazy'}
                  decoding="async"
                  class="h-full w-full object-cover opacity-90 transition-[opacity,transform] duration-700 ease-(--ease-out-expo) group-hover:scale-[1.04] group-hover:opacity-100"
                />
                <!-- trazo animado -->
                <svg class="pointer-events-none absolute inset-0 h-full w-full" aria-hidden="true">
                  <rect class="stroke" pathLength="1" rx="19" ry="19" />
                </svg>
                <!-- etiqueta -->
                <span class="absolute inset-x-0 bottom-0 flex items-end justify-between gap-3 bg-gradient-to-t from-black/70 to-transparent p-5 opacity-0 transition-opacity duration-500 group-hover:opacity-100">
                  <span>
                    <span class="block text-[0.95rem] font-medium">{p.data.title}</span>
                    <span class="block text-xs text-white/60">{p.data.sector}</span>
                  </span>
                  <svg class="size-4 shrink-0" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12 12 4M6 4h6v6"/></svg>
                </span>
              </a>
            </li>
          )),
        )}
      </ul>
    ))}
  </div>

  <!-- Degradado: opaco sobre el contenido, transparente hacia los proyectos -->
  <div class="pointer-events-none absolute inset-0 bg-gradient-to-b from-ink via-ink/90 to-ink/30 lg:bg-gradient-to-r lg:from-ink lg:via-ink/85 lg:via-45% lg:to-transparent lg:to-75%" aria-hidden="true"></div>

  <!-- Contenido -->
  <div class="container-x relative pointer-events-none">
    <div class="pointer-events-auto max-w-xl py-20 sm:py-24">
      <p class="inline-flex items-center gap-2 text-sm font-medium text-white/60">
        <span class="size-1.5 rounded-full bg-lime" aria-hidden="true"></span>
        Digital Marketing Studio · México
      </p>
      <h1 id="hero-title" class="mt-5 text-[2.5rem] font-semibold leading-[1.06] sm:text-6xl lg:text-[4rem]">
        Hacemos que los resultados sean una realidad
      </h1>
      <p class="mt-6 max-w-lg text-lg leading-relaxed text-white/65 sm:text-xl">
        Diseño web y generación de leads para negocios que quieren crecer. Estrategia clara, ejecución impecable y resultados que se pueden medir.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <Button href={site.bookingUrl} variant="inverse" size="lg" icon={false}>Agendar asesoría</Button>
        <Button href="/portafolio/" variant="glass" size="lg">Ver portafolio</Button>
      </div>
      <p class="mt-4 text-sm text-white/40">Asesoría inicial sin costo · Respuesta en menos de 24 h</p>
    </div>
  </div>
</section>

<!-- Métricas -->
<section class="border-b border-line bg-paper" aria-label="Métricas">
  <dl class="container-x grid grid-cols-1 gap-y-6 py-10 sm:grid-cols-3 sm:gap-x-8 sm:py-12">
    {heroStats.map(({ value, label }) => (
      <div>
        <dd class="text-3xl font-semibold tracking-tight text-text sm:text-4xl">{value}</dd>
        <dt class="mt-1 text-sm text-muted">{label}</dt>
      </div>
    ))}
  </dl>
</section>

<style>
  .lane {
    animation: lane-scroll 70s linear infinite;
  }
  .lane:hover { animation-play-state: paused; }
  @keyframes lane-scroll {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }
  /* Trazo que se dibuja alrededor de la tarjeta al pasar el cursor */
  .stroke {
    x: 1px; y: 1px;
    width: calc(100% - 2px); height: calc(100% - 2px);
    fill: none;
    stroke: rgb(255 255 255 / 0.9);
    stroke-width: 2;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 0.9s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .card:hover .stroke, .card:focus-visible .stroke { stroke-dashoffset: 0; }
  @media (prefers-reduced-motion: reduce) {
    .lane { animation: none; }
    .stroke { transition: none; stroke-dashoffset: 0; opacity: 0; }
    .card:hover .stroke { opacity: 1; }
  }
</style>
