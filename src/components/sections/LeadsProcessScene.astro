---
/**
 * Escena animada del hero de Generación de Leads (CSS puro, 16 s en bucle):
 * 01 medio correcto → 02 mensaje correcto → 03 filtro y calificación → 04 medición → 05 escala
 */
const labels = ['Medio correcto', 'Mensaje correcto', 'Filtro y calificación', 'Medición', 'Escala'];
const leads = [
  { i: 'A', ok: false }, { i: 'M', ok: true }, { i: 'R', ok: false }, { i: 'S', ok: true }, { i: 'L', ok: false },
];
---
<div class="scene" data-scene aria-hidden="true">
<div class="stage">
  <div class="backdrop"></div>
  {labels.map((l, i) => (
    <p class="label"><span class="label__n">0{i + 1}</span>{l}</p>
  ))}

  <!-- 01 · Medio: dónde está tu cliente -->
  <div class="media media--meta"><span class="tile"><svg viewBox="0 0 24 24" aria-hidden="true"><defs><linearGradient id="metaG" x1="0" x2="1" y1="0" y2="1"><stop offset="0" stop-color="#0064E1"/><stop offset="1" stop-color="#0866FF"/></linearGradient></defs><path fill="url(#metaG)" d="M6.915 4.03c-1.968 0-3.683 1.28-4.871 3.113C.704 9.208 0 11.883 0 14.449c0 .706.07 1.369.21 1.973a6.624 6.624 0 0 0 .265.86 5.297 5.297 0 0 0 .371.761c.696 1.159 1.818 1.927 3.593 1.927 1.497 0 2.633-.671 3.965-2.444.76-1.012 1.144-1.626 2.663-4.32l.756-1.339.186-.325c.061.1.121.196.183.3l2.152 3.595c.724 1.21 1.665 2.556 2.47 3.314 1.046.987 1.992 1.22 3.06 1.22 1.075 0 1.876-.355 2.455-.843a3.743 3.743 0 0 0 .81-.973c.542-.939.861-2.127.861-3.745 0-2.72-.681-5.357-2.084-7.45-1.282-1.912-2.957-2.93-4.716-2.93-1.047 0-2.088.467-3.053 1.308-.652.57-1.257 1.29-1.82 2.05-.69-.875-1.335-1.547-1.958-2.056-1.182-.966-2.315-1.303-3.454-1.303zm10.16 2.053c1.147 0 2.188.758 2.992 1.999 1.132 1.748 1.647 4.195 1.647 6.4 0 1.548-.368 2.9-1.839 2.9-.58 0-1.027-.23-1.664-1.004-.496-.601-1.343-1.878-2.832-4.358l-.617-1.028a44.908 44.908 0 0 0-1.255-1.98c.07-.109.141-.224.211-.327 1.12-1.667 2.118-2.602 3.358-2.602zm-10.201.553c1.265 0 2.058.791 2.675 1.446.307.327.737.871 1.234 1.579l-1.02 1.566c-.757 1.163-1.882 3.017-2.837 4.338-1.191 1.649-1.81 1.817-2.486 1.817-.524 0-1.038-.237-1.383-.794-.263-.426-.464-1.13-.464-2.046 0-2.221.63-4.535 1.66-6.088.454-.687.964-1.226 1.499-1.584.393-.262.796-.234 1.122-.234z"/></svg></span><span class="media__t">Meta</span></div>
  <div class="media media--google"><span class="tile"><svg viewBox="0 0 48 48" aria-hidden="true"><path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/><path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/><path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/><path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/></svg></span><span class="media__t">Google</span><span class="media__pick">Aquí busca tu cliente</span></div>

  <!-- 02 · Mensaje -->
  <div class="ad">
    <div class="ad__head"><span class="ad__logo">N</span><span><b>Tu marca</b><i>Patrocinado</i></span></div>
    <p class="ad__h"><span>Techo nuevo con garantía por escrito</span></p>
    <span class="ad__cta">Inspección gratis</span>
  </div>

  <!-- 03 · Filtro -->
  <div class="leads">
    {leads.map(({ i, ok }, k) => (
      <span class:list={['lead', ok ? 'lead--ok' : 'lead--no']} style={`--k:${k}`}>{i}<i class="lead__mark">{ok ? '✓' : '✕'}</i></span>
    ))}
  </div>
  <span class="pill pill--filter">2 calificados · 3 fuera</span>

  <!-- 04 · Medición / 05 · Escala -->
  <div class="dash">
    <div class="dash__head"><span>Tu panel</span><span class="dash__scale">+ presupuesto</span></div>
    <div class="dash__kpis">
      <div class="dash__kpi"><span class="dash__k">Leads</span><span class="dash__v">48</span></div>
      <div class="dash__kpi"><span class="dash__k">Citas</span><span class="dash__v">19</span></div>
      <div class="dash__kpi"><span class="dash__k">Costo por cita</span><span class="dash__v dash__v--ok">$210</span></div>
    </div>
    <div class="dash__bars">
      {[30, 42, 38, 55, 60, 72, 68, 84, 92, 100].map((h, i) => (
        <span class="bar" style={`--h:${h}%; --d:${i}`}></span>
      ))}
    </div>
    <span class="dash__ok">✓ Agenda llena</span>
  </div>

  <svg class="cursor" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M5 3l14 9-6 1.5L16 20l-3 1.5-3-6.5-5 4z" fill="#fff" stroke="#111" stroke-width="1.5" stroke-linejoin="round" />
  </svg>
</div>
</div>

<script>
  const scenes = document.querySelectorAll<HTMLElement>('.scene[data-scene]');
  const io = new IntersectionObserver((entries) => {
    for (const e of entries) e.target.classList.toggle('is-playing', e.isIntersecting);
  }, { threshold: 0.2 });
  scenes.forEach((s) => io.observe(s));
</script>

<style>
  /* 16 s · 1 s = 6.25 %. Escenas: 01 0–3 s · 02 3–6.5 · 03 6.5–10 · 04 10–13 · 05 13–16 */
  .scene { --dur: 16s; --play: paused; position: relative; overflow: hidden; container-type: inline-size; aspect-ratio: 4 / 3; width: 100%; background: var(--color-paper); }
  .scene.is-playing { --play: running; }
  .stage { position: absolute; inset: 0; font-size: max(0.62rem, 2.6cqw); }
  .stage > *, .leads > *, .dash__bars > * { animation-duration: var(--dur); animation-iteration-count: infinite; animation-fill-mode: both; animation-timing-function: cubic-bezier(0.4, 0, 0.2, 1); animation-play-state: var(--play); }
  @media (prefers-reduced-motion: reduce) { .scene * { animation-play-state: paused !important; animation-delay: -15s !important; animation-duration: var(--dur) !important; } }

  .backdrop { position: absolute; left: 4%; top: 15%; right: 4%; bottom: 6%; border-radius: 6cqw; background: var(--color-paper-soft); }
  .label { position: absolute; left: 5%; top: 4.5%; z-index: 2; display: inline-flex; align-items: center; gap: 0.6em; font-size: max(0.7rem, 2.9cqw); font-weight: 500; color: var(--color-muted); opacity: 0; }
  .label__n { font-size: 0.85em; color: var(--color-faint); }
  .label:nth-of-type(1) { animation-name: l1; } .label:nth-of-type(2) { animation-name: l2; } .label:nth-of-type(3) { animation-name: l3; } .label:nth-of-type(4) { animation-name: l4; } .label:nth-of-type(5) { animation-name: l5; }
  @keyframes l1 { 0%,2%{opacity:0;transform:translateY(6px)} 5%,17%{opacity:1;transform:none} 19%,100%{opacity:0;transform:translateY(-6px)} }
  @keyframes l2 { 0%,19%{opacity:0;transform:translateY(6px)} 22%,39%{opacity:1;transform:none} 41%,100%{opacity:0;transform:translateY(-6px)} }
  @keyframes l3 { 0%,41%{opacity:0;transform:translateY(6px)} 44%,61%{opacity:1;transform:none} 63%,100%{opacity:0;transform:translateY(-6px)} }
  @keyframes l4 { 0%,63%{opacity:0;transform:translateY(6px)} 66%,80%{opacity:1;transform:none} 82%,100%{opacity:0;transform:translateY(-6px)} }
  @keyframes l5 { 0%,82%{opacity:0;transform:translateY(6px)} 85%,96%{opacity:1;transform:none} 99%,100%{opacity:0;transform:translateY(-6px)} }

  /* Piezas comunes */
  .tile { display: grid; place-items: center; width: 13cqw; height: 13cqw; border-radius: 3cqw; color: #161616; background: linear-gradient(160deg, #ffffff 0%, #e6e6e6 60%, #d0d0d0 100%); box-shadow: 0 18px 30px -14px rgb(0 0 0 / 0.45), inset 0 1px 0 #fff, 0 0 0 1px rgb(0 0 0 / 0.06); transition: box-shadow 0.4s; }
  .tile svg { width: 52%; height: 52%; }
  .pill { position: absolute; display: inline-flex; align-items: center; gap: 0.5em; white-space: nowrap; padding: 1.8cqw 3.2cqw; border-radius: 2.4cqw; font-size: max(0.6rem, 2.8cqw); font-weight: 600; color: #ececec; background: linear-gradient(180deg, #3b3b3b, #262626); box-shadow: 0 14px 26px -12px rgb(0 0 0 / 0.7), inset 0 1px 0 rgb(255 255 255 / 0.14); }

  /* 01 */
  .media { position: absolute; top: 34%; display: flex; flex-direction: column; align-items: center; gap: 1.6cqw; font-size: max(0.62rem, 2.8cqw); font-weight: 600; color: var(--color-text); }
  .media--meta { left: 22%; animation-name: mediaMeta; }
  .media--google { left: 58%; animation-name: mediaGoogle; }
  .media--google .tile { animation-name: pick; animation-duration: var(--dur); animation-iteration-count: infinite; animation-fill-mode: both; animation-play-state: var(--play); }
  .media__pick { position: absolute; top: calc(100% + 1.6cqw); white-space: nowrap; padding: 1cqw 2cqw; border-radius: 999px; font-size: 0.8em; color: #0a0a0a; background: var(--color-lime); opacity: 0; animation-name: pickPill; animation-duration: var(--dur); animation-iteration-count: infinite; animation-fill-mode: both; animation-play-state: var(--play); }
  @keyframes mediaMeta   { 0%,2%{opacity:0;transform:translateY(8px)} 6%,12%{opacity:1;transform:none} 17%,19%{opacity:0.35;transform:none} 21%,100%{opacity:0;transform:translateY(-8px)} }
  @keyframes mediaGoogle { 0%,3%{opacity:0;transform:translateY(8px)} 7%,19%{opacity:1;transform:none} 22%,100%{opacity:0;transform:translateY(-8px)} }
  @keyframes pick { 0%,11%{box-shadow:0 18px 30px -14px rgb(0 0 0/0.45),inset 0 1px 0 #fff,0 0 0 1px rgb(0 0 0/0.06)} 13%,100%{box-shadow:0 18px 30px -14px rgb(0 0 0/0.45),inset 0 1px 0 #fff,0 0 0 0.6cqw var(--color-lime)} }
  @keyframes pickPill { 0%,12%{opacity:0;transform:translateY(4px)} 14%,19%{opacity:1;transform:none} 22%,100%{opacity:0} }

  /* 02 · Anuncio */
  .ad { position: absolute; left: 24%; top: 22%; width: 52%; padding: 3.4cqw; border-radius: 3.4cqw; background: var(--color-paper); box-shadow: 0 0 0 1px var(--color-line), 0 30px 50px -30px rgb(0 0 0 / 0.35); animation-name: ad; }
  .ad__head { display: flex; align-items: center; gap: 2cqw; font-size: max(0.55rem, 2.4cqw); }
  .ad__logo { display: grid; place-items: center; width: 6cqw; height: 6cqw; border-radius: 50%; background: var(--color-lime); color: #0a0a0a; font-weight: 700; }
  .ad__head b { display: block; color: var(--color-text); } .ad__head i { display: block; font-style: normal; color: var(--color-faint); font-size: 0.85em; }
  .ad__h { margin-top: 2.6cqw; font-size: max(0.8rem, 4.2cqw); font-weight: 600; line-height: 1.15; letter-spacing: -0.02em; color: var(--color-text); }
  .ad__h span { display: inline-block; animation: type var(--dur) steps(34) infinite both; animation-play-state: var(--play); clip-path: inset(0 100% 0 0); }
  .ad__cta { display: inline-block; margin-top: 2.6cqw; padding: 1.4cqw 3cqw; border-radius: 1.6cqw; font-size: max(0.58rem, 2.6cqw); font-weight: 600; color: #fff; background: #111; }
  @keyframes ad { 0%,21%{opacity:0;transform:translateY(10px) scale(0.97)} 24%,39%{opacity:1;transform:none} 42%,100%{opacity:0;transform:translateY(-10px)} }
  @keyframes type { 0%,25%{clip-path:inset(0 100% 0 0)} 36%,100%{clip-path:inset(0 0 0 0)} }

  /* 03 · Filtro */
  .leads { position: absolute; left: 50%; top: 36%; display: flex; gap: 3cqw; translate: -50% 0; }
  .lead { position: relative; display: grid; place-items: center; width: 11cqw; height: 11cqw; border-radius: 50%; font-size: max(0.6rem, 2.8cqw); font-weight: 600; color: #fff; background: linear-gradient(180deg, #3b3b3b, #1a1a1a); box-shadow: 0 14px 26px -14px rgb(0 0 0 / 0.6); animation-delay: calc(var(--k) * 0.12s); }
  .lead__mark { position: absolute; right: -1cqw; bottom: -1cqw; display: grid; place-items: center; width: 4.6cqw; height: 4.6cqw; border-radius: 50%; font-style: normal; font-size: 0.7em; opacity: 0; animation: mark var(--dur) infinite both; animation-delay: calc(var(--k) * 0.2s); animation-play-state: var(--play); }
  .lead--ok .lead__mark { background: var(--color-lime); color: #0a0a0a; }
  .lead--no .lead__mark { background: #e5e5e5; color: #555; }
  .lead--ok { animation-name: leadOk; } .lead--no { animation-name: leadNo; }
  @keyframes leadOk { 0%,42%{opacity:0;transform:translateY(8px)} 45%,61%{opacity:1;transform:none} 64%,100%{opacity:0;transform:translateY(-8px)} }
  @keyframes leadNo { 0%,42%{opacity:0;transform:translateY(8px)} 45%,52%{opacity:1;transform:none} 56%,61%{opacity:0.25;transform:scale(0.85)} 64%,100%{opacity:0} }
  @keyframes mark { 0%,50%{opacity:0;transform:scale(0.5)} 53%,61%{opacity:1;transform:none} 64%,100%{opacity:0} }
  .pill--filter { left: 50%; top: 60%; translate: -50% 0; animation-name: filterPill; }
  @keyframes filterPill { 0%,55%{opacity:0;transform:translateY(6px)} 58%,61%{opacity:1;transform:none} 64%,100%{opacity:0} }

  /* 04 · Medición → 05 · Escala */
  .dash { position: absolute; left: 12%; top: 22%; width: 76%; padding: 3.4cqw; border-radius: 3.4cqw; background: var(--color-paper); box-shadow: 0 0 0 1px var(--color-line), 0 30px 50px -30px rgb(0 0 0 / 0.35); animation-name: dash; }
  .dash__head { display: flex; justify-content: space-between; align-items: center; font-size: max(0.6rem, 2.7cqw); font-weight: 600; color: var(--color-text); }
  .dash__scale { padding: 0.8cqw 2cqw; border-radius: 999px; font-size: 0.85em; color: #0a0a0a; background: var(--color-lime); opacity: 0; animation: scalePill var(--dur) infinite both; animation-play-state: var(--play); }
  .dash__kpis { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.8cqw; margin-top: 2.4cqw; }
  .dash__kpi { padding: 2cqw; border-radius: 2cqw; background: var(--color-surface); }
  .dash__k { display: block; font-size: max(0.5rem, 2.1cqw); color: var(--color-muted); }
  .dash__v { display: block; margin-top: 0.4cqw; font-size: max(0.8rem, 3.6cqw); font-weight: 600; line-height: 1; color: var(--color-text); }
  .dash__v--ok { color: var(--color-lime-deep); }
  .dash__bars { display: flex; align-items: flex-end; gap: 1cqw; height: 14cqw; margin-top: 2.6cqw; padding: 2cqw; border-radius: 2cqw; background: var(--color-surface); }
  .bar { flex: 1; height: var(--h); border-radius: 0.6cqw; background: rgb(0 0 0 / 0.2); transform-origin: bottom; transform: scaleY(0); animation-name: bar; animation-delay: calc(var(--d) * 0.05s); }
  .bar:last-child { background: var(--color-lime); }
  .dash__ok { position: absolute; right: 3cqw; top: -2.6cqw; padding: 1cqw 2.2cqw; border-radius: 999px; font-size: max(0.58rem, 2.6cqw); font-weight: 600; color: #0a0a0a; background: var(--color-lime); box-shadow: 0 12px 24px -12px rgb(151 239 73 / 0.8); opacity: 0; animation: agenda var(--dur) infinite both; animation-play-state: var(--play); }
  @keyframes dash { 0%,63%{opacity:0;transform:translateY(10px) scale(0.97)} 67%,96%{opacity:1;transform:none} 99%,100%{opacity:0} }
  /* Medición: barras a media altura; Escala: crecen a su altura completa */
  @keyframes bar { 0%,66%{transform:scaleY(0)} 72%,82%{transform:scaleY(0.55)} 88%,100%{transform:scaleY(1)} }
  @keyframes scalePill { 0%,83%{opacity:0;transform:translateY(4px)} 86%,100%{opacity:1;transform:none} }
  @keyframes agenda { 0%,90%{opacity:0;transform:translateY(4px)} 93%,97%{opacity:1;transform:none} 100%{opacity:0} }

  /* Cursor */
  .cursor { position: absolute; left: 105%; top: 95%; width: 6cqw; z-index: 20; filter: drop-shadow(0 4px 8px rgb(0 0 0 / 0.35)); animation-name: cursor; animation-timing-function: cubic-bezier(0.65, 0, 0.35, 1); }
  @keyframes cursor {
    0%, 3%   { left: 105%; top: 95%; opacity: 0; transform: scale(1); }
    6%       { opacity: 1; }
    10%      { left: 66%; top: 48%; transform: scale(1); }
    12%      { transform: scale(0.8); }
    13%, 19% { left: 66%; top: 48%; transform: scale(1); }
    26%      { left: 62%; top: 70%; }
    36%      { left: 62%; top: 70%; transform: scale(1); }
    38%      { transform: scale(0.8); }
    39%, 44% { left: 62%; top: 70%; transform: scale(1); }
    50%      { left: 40%; top: 52%; }
    56%      { left: 68%; top: 52%; }
    63%      { left: 80%; top: 80%; }
    72%      { left: 84%; top: 40%; }
    84%      { left: 84%; top: 40%; transform: scale(1); }
    86%      { transform: scale(0.8); }
    88%, 92% { left: 84%; top: 40%; transform: scale(1); }
    97%, 100% { left: 105%; top: 95%; opacity: 0; }
  }
</style>
