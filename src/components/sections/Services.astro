---
import SectionHeading from '../ui/SectionHeading.astro';
import { services } from '../../data/home';
import { icons } from '../../lib/icons';

const serviceIcons = [icons.layers, icons.funnel];
---

<section class="py-20 sm:py-28" aria-labelledby="services-title">
  <div class="container-x">
    <SectionHeading id="services-title"
      eyebrow="Servicios"
      title="Dos caminos, un mismo objetivo: que tu negocio venda más"
      description="Construimos la presencia digital que tu marca merece y la llenamos de clientes potenciales listos para comprar."
    />

    <div class="mt-12 grid gap-4 lg:grid-cols-2">
      {services.map(({ title, href, description, bullets }, i) => (
        <a href={href} class="reveal card-surface card-hover group flex flex-col justify-between p-7 sm:p-9">
          <div>
            <span class="inline-flex size-10 items-center justify-center rounded-xl border border-line bg-paper text-text">
              <svg class="size-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={serviceIcons[i]} />
            </span>
            <h3 class="mt-6 text-2xl font-semibold text-text">{title}</h3>
            <p class="mt-3 text-lg leading-relaxed text-muted">{description}</p>
            <ul class="mt-6 flex flex-wrap gap-2">
              {bullets.map((b) => (
                <li class="rounded-lg border border-line bg-paper px-2.5 py-1 text-sm text-muted">{b}</li>
              ))}
            </ul>
          </div>
          <span class="mt-8 inline-flex items-center gap-1.5 text-[0.95rem] font-medium text-text">
            Conocer el servicio
            <svg class="size-4 transition-transform duration-300 group-hover:translate-x-0.5" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 10h12M11 5l5 5-5 5"/></svg>
          </span>
        </a>
      ))}
    </div>
  </div>
</section>
