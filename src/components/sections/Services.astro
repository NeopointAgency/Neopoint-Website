---
import SectionHeading from '../ui/SectionHeading.astro';
import EditorGraphic from '../graphics/EditorGraphic.astro';
import FunnelGraphic from '../graphics/FunnelGraphic.astro';
import { services } from '../../data/home';

const graphics = [EditorGraphic, FunnelGraphic];
---

<section class="py-20 sm:py-28" aria-labelledby="services-title">
  <div class="container-x">
    <SectionHeading id="services-title"
      eyebrow="Servicios"
      title="Dos caminos, un mismo objetivo: que tu negocio venda más"
      description="Construimos la presencia digital que tu marca merece y la llenamos de clientes potenciales listos para comprar."
    />

    <ul class="mt-12 grid gap-x-8 gap-y-12 md:grid-cols-2" role="list">
      {services.map(({ title, href, description, bullets }, i) => {
        const Graphic = graphics[i];
        return (
          <li class="reveal">
            <a href={href} class="group block">
              <div class="gcard">
                <Graphic />
                <span class="gcard__sheen" aria-hidden="true"></span>
              </div>
              <h3 class="mt-6 text-2xl font-semibold text-text">{title}</h3>
              <p class="mt-2 text-lg leading-relaxed text-muted">{description}</p>
              <ul class="mt-5 flex flex-wrap gap-2" role="list">
                {bullets.map((b) => (
                  <li class="rounded-lg border border-line bg-surface px-2.5 py-1 text-sm text-muted">{b}</li>
                ))}
              </ul>
              <span class="mt-6 inline-flex items-center gap-1.5 text-[0.95rem] font-medium text-text">
                Conocer el servicio
                <svg class="size-4 transition-transform duration-300 group-hover:translate-x-0.5" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 10h12M11 5l5 5-5 5"/></svg>
              </span>
            </a>
          </li>
        );
      })}
    </ul>
  </div>
</section>
