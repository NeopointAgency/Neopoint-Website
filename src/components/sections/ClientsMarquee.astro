---
import { Image } from 'astro:assets';
import { clients } from '../../data/home';

/** tone="dark" (gris oscuro, logos blancos) o "light" (blanco, logos grises) */
interface Props { tone?: 'dark' | 'light' }
const { tone = 'dark' } = Astro.props;
const dark = tone === 'dark';
---

<section class:list={['border-y py-10', dark ? 'border-white/10 bg-[#141414] text-white' : 'border-line bg-paper']} aria-labelledby="clients-title">
  <div class="container-x">
    <h2 id="clients-title" class:list={['text-sm font-medium', dark ? 'text-white/50' : 'text-muted']}>+60 empresas impactando en el mundo digital</h2>
  </div>

  <div class="group relative mt-7 overflow-hidden [mask-image:linear-gradient(to_right,transparent,black_10%,black_90%,transparent)]">
    <ul class="flex w-max animate-marquee items-center gap-16 pr-16 motion-reduce:animate-none group-hover:[animation-play-state:paused]">
      {[0, 1].map((copy) =>
        clients.map(({ name, image }) => (
          <li class="shrink-0" aria-hidden={copy === 1 ? 'true' : undefined}>
            <Image
              src={image}
              alt={copy === 0 ? name : ''}
              width={360}
              format="webp"
              quality={80}
              loading="lazy"
              decoding="async"
              class:list={['h-9 w-auto brightness-0 transition-opacity duration-300 sm:h-11', dark ? 'invert opacity-55 hover:opacity-100' : 'opacity-45 hover:opacity-85']}
            />
          </li>
        )),
      )}
    </ul>
  </div>
</section>
