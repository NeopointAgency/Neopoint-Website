---
import Button from '../ui/Button.astro';
import WebProcessScene from './WebProcessScene.astro';
import LeadsProcessScene from './LeadsProcessScene.astro';
import { site } from '../../data/site';
import { heroStats } from '../../data/home';

const services = [
  { href: '/diseno-web/', title: 'Diseño web', text: 'Sitios que responden dudas, cargan rápido y llevan a una sola acción. Tu MVP en 10 días.' },
  { href: '/generacion-de-leads/', title: 'Generación de leads', text: 'Anuncios con embudos que filtran. A ti solo llegan los que sí quieren comprar.' },
];
---

<section class="bg-paper !pt-16" aria-labelledby="hero-title">
  <div class="container-x pt-10 pb-14 sm:pt-16 sm:pb-20">
    <div class="max-w-3xl">
      <p class="inline-flex items-center gap-2 rounded-full border border-line bg-surface px-3 py-1 text-xs font-medium text-muted">
        <span class="size-1.5 rounded-full bg-lime-deep" aria-hidden="true"></span>Digital Marketing Studio · México
      </p>
      <h1 id="hero-title" class="mt-5 text-4xl font-semibold leading-[1.06] tracking-[-0.025em] sm:text-5xl lg:text-[3.75rem]">Marketing que trae clientes, no likes</h1>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-muted sm:text-xl">Sabemos cuál es el miedo: pagar por una web o por anuncios que no traen nada. Hacemos sitios que venden y campañas que llenan tu agenda.</p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <Button href={site.bookingUrl} size="lg" icon={false}>Agendar diagnóstico</Button>
        <Button href="/portafolio/" variant="secondary" size="lg">Ver portafolio</Button>
      </div>
      <p class="mt-4 text-sm text-faint">30 minutos, sin costo. Te decimos si tiene sentido trabajar juntos.</p>
    </div>

    <!-- Dos caminos: cada uno con su animación -->
    <div class="mt-14 grid gap-6 lg:grid-cols-2">
      {services.map(({ href, title, text }, i) => (
        <a href={href} class="group reveal block overflow-hidden rounded-card border border-line bg-paper transition-[border-color,transform] duration-500 ease-(--ease-out-expo) hover:-translate-y-1 hover:border-line-strong">
          <div class="border-b border-line">{i === 0 ? <WebProcessScene /> : <LeadsProcessScene />}</div>
          <div class="flex items-start justify-between gap-4 p-6 sm:p-7">
            <div>
              <h2 class="text-xl font-semibold text-text sm:text-2xl">{title}</h2>
              <p class="mt-1.5 text-muted">{text}</p>
            </div>
            <span class="mt-1 inline-flex size-9 shrink-0 items-center justify-center rounded-full border border-line text-text transition-colors group-hover:bg-ink group-hover:text-white">
              <svg class="size-4" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 10h12M11 5l5 5-5 5"/></svg>
            </span>
          </div>
        </a>
      ))}
    </div>
  </div>

  <dl class="container-x grid grid-cols-1 gap-y-6 border-t border-line py-10 sm:grid-cols-3 sm:gap-x-8" aria-label="Métricas">
    {heroStats.map(({ value, label }) => (
      <div>
        <dd class="text-3xl font-semibold tracking-tight text-text sm:text-4xl">{value}</dd>
        <dt class="mt-1 text-sm text-muted">{label}</dt>
      </div>
    ))}
  </dl>
</section>
