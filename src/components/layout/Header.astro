---
import Logo from '../ui/Logo.astro';
import Button from '../ui/Button.astro';
import { mainNav } from '../../data/nav';
import { site } from '../../data/site';

/**
 * Header que se funde con el hero (transparente al inicio) y, al hacer scroll,
 * se convierte en una píldora flotante con fondo claro y desenfoque.
 * `tone="dark"` invierte los colores mientras está transparente sobre un hero oscuro.
 */
interface Props { tone?: 'light' | 'dark' }
const { tone = 'light' } = Astro.props;

const current = Astro.url.pathname;
const isActive = (href: string) => current === href || (href !== '/' && current.startsWith(href));
---

<header class="group sticky top-0 z-50 -mb-16 h-16" id="site-header" data-tone={tone}>
  <div class="container-x relative">
    <nav
      class="flex h-14 items-center justify-between rounded-pill border border-transparent bg-transparent pl-0 pr-0 transition-[background-color,border-color,box-shadow,padding,margin,backdrop-filter] duration-500 ease-(--ease-out-expo) group-data-scrolled:border-line group-data-scrolled:bg-paper/85 group-data-scrolled:pl-5 group-data-scrolled:pr-1.5 group-data-scrolled:shadow-card group-data-scrolled:backdrop-blur-xl mt-1 group-data-scrolled:mt-2"
      aria-label="Navegación principal"
    >
      <a href="/" class="flex items-center text-text" aria-label="Neopoint, ir al inicio">
        <Logo class="h-[21px] w-auto" />
      </a>

      <ul class="hidden items-center gap-1 lg:flex">
        {mainNav.map(({ label, href }) => (
          <li>
            <a
              href={href}
              aria-current={isActive(href) ? 'page' : undefined}
              class="rounded-pill px-3.5 py-2 text-[0.95rem] font-medium text-muted transition-colors duration-300 hover:bg-surface hover:text-text aria-[current=page]:text-text"
            >
              {label}
            </a>
          </li>
        ))}
      </ul>

      <div class="flex items-center gap-2">
        <div class="hidden sm:block"><Button href={site.bookingUrl} size="sm" icon={false} class="rounded-pill">Agendar diagnóstico</Button></div>
        <button
          type="button"
          class="inline-flex size-10 items-center justify-center rounded-pill text-text transition hover:bg-surface lg:hidden"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label="Abrir menú"
          data-menu-toggle
        >
          <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
            <path data-icon-open d="M4 7h16M4 12h16M4 17h16" />
            <path data-icon-close class="hidden" d="M6 6l12 12M18 6L6 18" />
          </svg>
        </button>
      </div>
    </nav>

    <div id="mobile-menu" class="absolute inset-x-5 top-full mt-2 hidden rounded-card border border-line bg-paper p-3 shadow-lift sm:inset-x-8 lg:hidden" hidden>
      <ul class="flex flex-col">
        {mainNav.map(({ label, href }) => (
          <li>
            <a href={href} class="block rounded-btn px-3 py-3 text-base font-medium text-text hover:bg-surface">{label}</a>
          </li>
        ))}
        <li class="mt-2 border-t border-line pt-3">
          <Button href={site.bookingUrl} class="w-full" icon={false}>Agendar diagnóstico</Button>
        </li>
      </ul>
    </div>
  </div>
</header>

<style>
  /* Sobre un hero oscuro sin scroll, o sobre cualquier sección oscura al hacer scroll:
     invierte los tokens solo dentro del header (píldora oscura, texto blanco, botón blanco) */
  header[data-tone='dark']:not([data-scrolled]),
  header[data-over-dark] {
    --color-text: #ffffff;
    --color-muted: rgb(255 255 255 / 0.7);
    --color-faint: rgb(255 255 255 / 0.45);
    --color-paper: #0a0a0a;
    --color-surface: rgb(255 255 255 / 0.08);
    --color-line: rgb(255 255 255 / 0.12);
  }
</style>

<script>
  const header = document.getElementById('site-header')!;
  const toggle = header.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = toggle?.querySelector('[data-icon-open]');
  const iconClose = toggle?.querySelector('[data-icon-close]');

  // Estado "scrolled": píldora flotante
  let ticking = false;
  // ¿Qué hay debajo del header? Si el fondo es oscuro, el header se pone oscuro.
  const isDarkBehind = () => {
    const y = header.getBoundingClientRect().bottom + 6;
    header.style.pointerEvents = 'none';
    let el = document.elementFromPoint(window.innerWidth / 2, y) as HTMLElement | null;
    header.style.pointerEvents = '';
    while (el && el !== document.body) {
      const bg = getComputedStyle(el).backgroundColor;
      const m = bg.match(/rgba?\(([\d.]+),\s*([\d.]+),\s*([\d.]+)(?:,\s*([\d.]+))?\)/);
      if (m && (m[4] === undefined || parseFloat(m[4]) > 0.5)) {
        const lum = 0.2126 * +m[1] + 0.7152 * +m[2] + 0.0722 * +m[3];
        return lum < 90;
      }
      el = el.parentElement;
    }
    return false;
  };
  const sync = () => {
    ticking = false;
    const scrolled = window.scrollY > 24 || menu?.hidden === false;
    header.toggleAttribute('data-scrolled', scrolled);
    header.toggleAttribute('data-over-dark', scrolled && menu?.hidden !== false && isDarkBehind());
  };
  window.addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(sync); } }, { passive: true });
  sync();

  function setOpen(open: boolean) {
    if (!toggle || !menu) return;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
    menu.hidden = !open;
    menu.classList.toggle('hidden', !open);
    iconOpen?.classList.toggle('hidden', open);
    iconClose?.classList.toggle('hidden', !open);
    sync();
  }

  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  document.addEventListener('keydown', (e) => e.key === 'Escape' && setOpen(false));
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
</script>
