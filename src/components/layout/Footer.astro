---
import Logo from '../ui/Logo.astro';
import { site } from '../../data/site';
import { footerNav } from '../../data/nav';

const year = new Date().getFullYear();
const groups = [
  { title: 'Servicios', items: footerNav.servicios },
  { title: 'Empresa', items: footerNav.empresa },
  { title: 'Legal', items: footerNav.legal },
];
---

<footer class="border-t border-line bg-paper" aria-labelledby="footer-heading">
  <h2 id="footer-heading" class="sr-only">Pie de página</h2>
  <div class="container-x py-14 lg:py-16">
    <div class="grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <a href="/" class="inline-flex text-text" aria-label="Neopoint, ir al inicio">
          <Logo class="h-6 w-auto" />
        </a>
        <p class="mt-6 max-w-xs text-lg font-medium leading-snug text-text">Marketing con dirección.<br />Leads con intención.</p>
        <p class="mt-3 text-sm text-muted">{site.location}</p>
      </div>

      <div class="grid grid-cols-2 gap-8 sm:grid-cols-3 lg:col-span-7">
        {groups.map(({ title, items }) => (
          <div>
            <h3 class="text-sm font-medium text-faint">{title}</h3>
            <ul class="mt-4 space-y-2.5">
              {items.map(({ label, href }) => (
                <li>
                  <a
                    href={href}
                    class="text-[0.95rem] text-muted transition-colors hover:text-text"
                    {...(href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {})}
                  >
                    {label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>

    <div class="mt-14 flex flex-col gap-2 border-t border-line pt-6 text-sm text-faint sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} {site.name}. Todos los derechos reservados.</p>
      <p>México · LATAM · USA</p>
    </div>
  </div>
</footer>
