---
/** Mini ilustraciones (SVG) para explicar cada error de un vistazo. */
interface Props { kind: 'company' | 'fear' | 'proof' | 'button' | 'slow' | 'offer'; class?: string }
const { kind, class: className = '' } = Astro.props;
---
<svg class:list={['mini', className]} viewBox="0 0 160 100" fill="none" aria-hidden="true">
  <rect x="0" y="0" width="160" height="100" rx="12" fill="rgb(255 255 255 / 0.05)" />
  {kind === 'company' && (
    <>
      <rect x="14" y="14" width="90" height="72" rx="8" fill="#fff" />
      <text x="22" y="32" font-size="7.5" font-weight="700" fill="#111">SOBRE NOSOTROS</text>
      <text x="22" y="45" font-size="7" fill="#777">20 años de experiencia</text>
      <rect x="22" y="54" width="60" height="4" rx="2" fill="#ddd" /><rect x="22" y="62" width="70" height="4" rx="2" fill="#ddd" /><rect x="22" y="70" width="48" height="4" rx="2" fill="#ddd" />
      <circle cx="128" cy="62" r="9" fill="rgb(255 255 255 / 0.25)" /><path d="M113 86c0-8 7-13 15-13s15 5 15 13" fill="rgb(255 255 255 / 0.25)" />
      <rect x="112" y="18" width="34" height="22" rx="8" fill="#97ef49" /><text x="129" y="34" text-anchor="middle" font-size="14" font-weight="700" fill="#0a0a0a">?</text>
    </>
  )}
  {kind === 'fear' && (
    <>
      <path d="M24 22h96a10 10 0 0 1 10 10v30a10 10 0 0 1-10 10H60l-16 14v-14H24a10 10 0 0 1-10-10V32a10 10 0 0 1 10-10Z" fill="#fff" />
      <text x="72" y="44" text-anchor="middle" font-size="9" font-weight="600" fill="#111">¿Y si pago y</text>
      <text x="72" y="58" text-anchor="middle" font-size="9" font-weight="600" fill="#111">no vuelven?</text>
      <circle cx="134" cy="76" r="12" fill="rgb(255 255 255 / 0.12)" /><text x="134" y="81" text-anchor="middle" font-size="14" font-weight="700" fill="#fff">?</text>
    </>
  )}
  {kind === 'proof' && (
    <>
      {[16, 62, 108].map((x) => (
        <>
          <rect x={x} y="22" width="36" height="30" rx="6" stroke="rgb(255 255 255 / 0.35)" stroke-width="1.5" stroke-dasharray="4 3" />
          <path d={`M${x + 8} ${44} l7-8 5 5 5-6 7 9`} stroke="rgb(255 255 255 / 0.35)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
        </>
      ))}
      <text x="80" y="76" text-anchor="middle" font-size="9" fill="rgb(255 255 255 / 0.6)">sin fotos · sin reseñas · sin registro</text>
    </>
  )}
  {kind === 'button' && (
    <>
      <rect x="20" y="12" width="120" height="76" rx="8" fill="#fff" />
      <rect x="28" y="20" width="24" height="5" rx="2.5" fill="#111" /><rect x="96" y="20" width="12" height="4" rx="2" fill="#ccc" /><rect x="112" y="20" width="12" height="4" rx="2" fill="#ccc" />
      <rect x="28" y="34" width="70" height="6" rx="3" fill="#ddd" /><rect x="28" y="44" width="90" height="4" rx="2" fill="#e8e8e8" /><rect x="28" y="52" width="80" height="4" rx="2" fill="#e8e8e8" /><rect x="28" y="60" width="60" height="4" rx="2" fill="#e8e8e8" />
      <rect x="108" y="76" width="26" height="7" rx="3.5" fill="#e0e0e0" /><text x="121" y="81.5" text-anchor="middle" font-size="4" fill="#999">contacto</text>
      <circle cx="121" cy="79" r="11" stroke="#97ef49" stroke-width="2" /><path d="M129 87l8 8" stroke="#97ef49" stroke-width="2.5" stroke-linecap="round" />
    </>
  )}
  {kind === 'slow' && (
    <>
      <rect x="44" y="14" width="72" height="72" rx="10" fill="#fff" />
      <circle cx="80" cy="42" r="12" stroke="#e5e5e5" stroke-width="4" /><path d="M80 30a12 12 0 0 1 12 12" stroke="#111" stroke-width="4" stroke-linecap="round" />
      <rect x="56" y="62" width="48" height="6" rx="3" fill="#eee" /><rect x="56" y="62" width="14" height="6" rx="3" fill="#111" />
      <text x="80" y="80" text-anchor="middle" font-size="7" fill="#999">Cargando… 8 s</text>
      <circle cx="26" cy="50" r="7" fill="rgb(255 255 255 / 0.2)" /><path d="M14 72c0-6 5-10 12-10s12 4 12 10" fill="rgb(255 255 255 / 0.2)" /><path d="M20 26l-6 6M14 26l6 6" stroke="rgb(255 255 255 / 0.5)" stroke-width="2" stroke-linecap="round" />
    </>
  )}
  {kind === 'offer' && (
    <>
      <path d="M40 22h44l40 40-24 24-40-40V22Z" fill="#fff" transform="rotate(-8 80 54)" /><circle cx="56" cy="36" r="4" fill="#111" transform="rotate(-8 80 54)" />
      <text x="88" y="66" text-anchor="middle" font-size="22" font-weight="700" fill="#111" transform="rotate(-8 80 54)">?</text>
      <text x="80" y="92" text-anchor="middle" font-size="8" fill="rgb(255 255 255 / 0.6)">¿qué incluye? ¿cuánto tarda? ¿por qué tú?</text>
    </>
  )}
</svg>

<style>
  .mini { width: 100%; height: auto; display: block; font-family: var(--font-sans); }
</style>
