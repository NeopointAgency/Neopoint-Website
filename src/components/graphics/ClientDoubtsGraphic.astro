---
/** Tu cliente y lo que se pregunta antes de contactarte, según el tipo de negocio. */
const doubts = [
  { tag: 'Servicios', text: '¿Sí van a cumplir lo que prometen? ¿Y si pago y no responden?' },
  { tag: 'Tienda en línea', text: '¿Es seguro pagar aquí? ¿Cuándo me llega? ¿Y si no me gusta?' },
  { tag: 'Negocio local', text: '¿Están abiertos? ¿Queda cerca? ¿Por qué ellos y no el de al lado?' },
];
---
<div class="gcard group !aspect-auto p-6 sm:p-7">
  <div class="relative z-10 grid gap-6 sm:grid-cols-[auto_1fr] sm:items-center">
    <div class="flex flex-col items-center text-center sm:pr-2">
      <span class="relative grid size-20 place-items-center rounded-full bg-white/10 ring-1 ring-white/15">
        <svg class="size-10 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="4" /><path d="M4 21c0-4 3.6-7 8-7s8 3 8 7" /></svg>
        <span class="absolute -right-1 -top-1 grid size-7 place-items-center rounded-full bg-lime text-sm font-bold text-ink ring-4 ring-[#1a1a1a]">?</span>
      </span>
      <p class="mt-3 font-semibold text-white">Tu cliente</p>
      <p class="mt-0.5 text-xs text-white/50">antes de escribirte</p>
    </div>
    <ul class="grid gap-4 pt-3" role="list">
      {doubts.map(({ tag, text }, i) => (
        <li class:list={['doubt relative rounded-2xl bg-white px-4 py-3 text-ink shadow-[0_18px_30px_-18px_rgb(0_0_0/0.8)]', i === 1 ? 'sm:ml-6' : '', i === 2 ? 'sm:ml-3' : '']}>
          <span class="absolute -top-2.5 left-4 rounded-full bg-ink px-2 py-0.5 text-[0.62rem] font-semibold uppercase tracking-wide text-white">{tag}</span>
          <p class="mt-1 text-sm font-medium leading-snug sm:text-[0.95rem]">{text}</p>
          <i class="absolute -left-1.5 top-5 size-3 rotate-45 bg-white" aria-hidden="true"></i>
        </li>
      ))}
    </ul>
  </div>
  <span class="gcard__sheen" aria-hidden="true"></span>
</div>
