---
/**
 * Escenas de "lo que espanta clientes", con las mismas piezas de las tarjetas
 * ilustradas (g-panel, g-pill, g-tile, g-bubble). Cada una lleva una baldosa ✕.
 */
interface Props { kind: 'company' | 'fear' | 'proof' | 'button' | 'slow' | 'offer' }
const { kind } = Astro.props;
---
<div class="absolute inset-0">
  <span class="g-tile absolute left-[5%] top-[7%] z-10 !size-[10cqw] !rounded-[2.4cqw] -rotate-[8deg] [--tilt:-8deg]" aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18" /></svg>
  </span>

  {kind === 'company' && (
    <>
      <div class="g-panel absolute left-[16%] top-[16%] w-[52%] rounded-[3cqw] p-[3.4cqw]">
        <p class="text-[max(0.6rem,3cqw)] font-semibold text-white">Sobre nosotros</p>
        <p class="mt-[1cqw] text-[max(0.52rem,2.4cqw)] text-white/45">20 años de experiencia</p>
        <span class="mt-[2.6cqw] block h-[1.4cqw] w-[80%] rounded-full bg-white/15"></span>
        <span class="mt-[1.4cqw] block h-[1.4cqw] w-[92%] rounded-full bg-white/15"></span>
        <span class="mt-[1.4cqw] block h-[1.4cqw] w-[60%] rounded-full bg-white/15"></span>
      </div>
      <span class="absolute right-[12%] bottom-[14%] grid size-[16cqw] place-items-center rounded-full bg-white/[0.08] ring-1 ring-white/10 text-white/50">
        <svg class="size-[9cqw]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4" /><path d="M4 21c0-4 3.6-7 8-7s8 3 8 7" /></svg>
      </span>
      <span class="g-bubble g-bubble--out absolute right-[6%] top-[14%] !px-[3cqw] !py-[1.8cqw] text-[max(0.7rem,3.4cqw)] font-semibold">¿Y a mí qué?</span>
    </>
  )}

  {kind === 'fear' && (
    <>
      <span class="g-bubble absolute left-[8%] top-[18%] max-w-[64%] !bg-white !text-ink text-[max(0.66rem,3.2cqw)] font-medium">“¿Y si pago y no cumplen?”</span>
      <div class="g-panel absolute right-[8%] bottom-[14%] w-[50%] rounded-[3cqw] p-[3cqw]">
        <p class="text-[max(0.52rem,2.4cqw)] text-white/45">Respuesta del sitio</p>
        <span class="mt-[2cqw] flex gap-[1.2cqw]"><i class="size-[2cqw] rounded-full bg-white/25"></i><i class="size-[2cqw] rounded-full bg-white/25"></i><i class="size-[2cqw] rounded-full bg-white/25"></i></span>
      </div>
    </>
  )}

  {kind === 'proof' && (
    <>
      <div class="absolute inset-x-[10%] top-[20%] grid grid-cols-3 gap-[3cqw]">
        {[0, 1, 2].map(() => (
          <span class="grid aspect-[4/3] place-items-center rounded-[2.4cqw] border border-dashed border-white/25 text-white/30">
            <svg class="size-[7cqw]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="3" /><path d="m3 16 5-5 4 4 3-3 6 6" /></svg>
          </span>
        ))}
      </div>
      <span class="g-pill absolute left-1/2 bottom-[14%] -translate-x-1/2 !text-white/60">Sin fotos · sin reseñas · sin registro</span>
    </>
  )}

  {kind === 'button' && (
    <>
      <div class="g-panel absolute left-[18%] top-[12%] w-[64%] rounded-[3cqw] p-[3.4cqw]">
        <div class="flex items-center gap-[1.6cqw]">
          <span class="h-[2.2cqw] w-[10cqw] rounded-full bg-white"></span>
          <span class="ml-auto h-[1.6cqw] w-[6cqw] rounded-full bg-white/20"></span><span class="h-[1.6cqw] w-[6cqw] rounded-full bg-white/20"></span><span class="h-[1.6cqw] w-[6cqw] rounded-full bg-white/20"></span>
        </div>
        <span class="mt-[3.4cqw] block h-[2.6cqw] w-[70%] rounded-full bg-white/25"></span>
        <span class="mt-[1.6cqw] block h-[1.4cqw] w-[90%] rounded-full bg-white/12"></span>
        <span class="mt-[1.4cqw] block h-[1.4cqw] w-[84%] rounded-full bg-white/12"></span>
        <span class="mt-[1.4cqw] block h-[1.4cqw] w-[60%] rounded-full bg-white/12"></span>
        <span class="mt-[4cqw] ml-auto block w-fit rounded-[1cqw] bg-white/10 px-[1.6cqw] py-[0.6cqw] text-[max(0.42rem,1.8cqw)] text-white/35">contacto</span>
      </div>
      <span class="g-tile absolute right-[9%] bottom-[9%] rotate-[10deg] [--tilt:10deg]" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="11" cy="11" r="6.5" /><path d="m20 20-4-4" /></svg>
      </span>
    </>
  )}

  {kind === 'slow' && (
    <>
      <div class="g-panel absolute left-[30%] top-[12%] w-[40%] rounded-[4cqw] p-[3cqw]">
        <span class="mx-auto block h-[1cqw] w-[10cqw] rounded-full bg-white/15"></span>
        <span class="spinner mx-auto mt-[5cqw] block size-[12cqw] rounded-full border-[1.2cqw] border-white/15 border-t-white"></span>
        <span class="mt-[5cqw] block h-[1.6cqw] w-full rounded-full bg-white/12"><i class="block h-full w-[22%] rounded-full bg-white"></i></span>
        <p class="mt-[2cqw] text-center text-[max(0.5rem,2.3cqw)] text-white/45">Cargando… 8 s</p>
      </div>
      <span class="absolute left-[6%] bottom-[16%] grid size-[14cqw] place-items-center rounded-full bg-white/[0.08] ring-1 ring-white/10 text-white/40">
        <svg class="size-[8cqw]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4" /><path d="M4 21c0-4 3.6-7 8-7s8 3 8 7" /></svg>
      </span>
      <svg class="absolute left-[21%] bottom-[24%] w-[9cqw] text-white/40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 12H4M10 6l-6 6 6 6" /></svg>
    </>
  )}

  {kind === 'offer' && (
    <>
      <div class="g-panel absolute left-[14%] top-[18%] w-[44%] rotate-[-8deg] rounded-[3cqw] p-[3cqw]">
        <span class="block size-[3cqw] rounded-full bg-white/30"></span>
        <span class="g-metal mt-[2cqw] block text-[16cqw] font-semibold leading-none">?</span>
      </div>
      <span class="g-pill absolute right-[6%] top-[18%] !text-white/70">¿Qué incluye?</span>
      <span class="g-pill absolute right-[12%] top-[44%] !text-white/70">¿Cuánto tarda?</span>
      <span class="g-pill absolute right-[8%] top-[70%] !text-white/70">¿Por qué tú?</span>
    </>
  )}
</div>

<style>
  .spinner { animation: spin 1.2s linear infinite; }
  @keyframes spin { to { transform: rotate(360deg); } }
</style>
