---
/** Árbol de navegación: estructura estratégica del sitio. */
---
<div class="absolute inset-0 flex flex-col items-center justify-center">
  <span class="g-pill">Sitio web</span>
  <svg class="mt-[1cqw] h-[10cqw] w-[78%]" viewBox="0 0 300 40" fill="none" preserveAspectRatio="none" aria-hidden="true">
    <path d="M150 0v18M50 18h200M50 18v22M150 18v22M250 18v22" stroke="rgb(255 255 255 / 0.22)" stroke-width="1.5" vector-effect="non-scaling-stroke" />
  </svg>
  <div class="grid w-[78%] grid-cols-3 gap-[3cqw]">
    <span class="g-pill">Inicio</span>
    <span class="g-pill">Servicios</span>
    <span class="g-pill"><span class="size-[1.6cqw] rounded-full bg-lime" aria-hidden="true"></span>Contacto</span>
  </div>
</div>
