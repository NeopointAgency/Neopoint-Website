---
/** Enfoque narrativo comercial: mock de anuncio con mensaje claro y llamada a la acción. */
---
<div class="absolute inset-0">
  <div class="g-panel absolute left-1/2 top-1/2 w-[58%] -translate-x-1/2 -translate-y-1/2 overflow-hidden rounded-[3cqw]">
    <div class="flex items-center gap-[2.4cqw] px-[3.4cqw] py-[2.2cqw]">
      <span class="grid size-[7cqw] place-items-center rounded-full bg-lime text-[3.2cqw] font-bold text-ink">N</span>
      <span class="leading-tight">
        <span class="block text-[max(0.62rem,3cqw)] font-semibold text-white">Tu marca</span>
        <span class="block text-[max(0.52rem,2.4cqw)] text-white/45">Patrocinado</span>
      </span>
    </div>
    <div class="relative aspect-[2/1] bg-[radial-gradient(90%_90%_at_20%_0%,#3a3a3a,#111_70%)]">
      <p class="absolute inset-x-[7%] bottom-[10%] text-[max(0.7rem,4.4cqw)] font-semibold leading-[1.1] tracking-tight text-white">Departamentos en preventa, desde tu celular.</p>
    </div>
    <div class="flex items-center justify-between gap-[2cqw] px-[3.4cqw] py-[2.4cqw]">
      <span class="truncate text-[max(0.56rem,2.6cqw)] text-white/60">Conoce los precios</span>
      <span class="rounded-[1.6cqw] bg-white px-[3cqw] py-[1.4cqw] text-[max(0.56rem,2.6cqw)] whitespace-nowrap font-semibold text-ink">Más información</span>
    </div>
  </div>
  <span class="g-tile absolute left-[6%] top-[12%] -rotate-[10deg] [--tilt:-10deg]" aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11v2a2 2 0 0 0 2 2h2l7 4V5L7 9H5a2 2 0 0 0-2 2Z" /><path d="M18 9a4 4 0 0 1 0 6" /></svg>
  </span>
  <span class="g-tile absolute right-[6%] bottom-[12%] rotate-[8deg] [--tilt:8deg]" aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9" /><circle cx="12" cy="12" r="4.5" /><circle cx="12" cy="12" r="0.8" fill="currentColor" /></svg>
  </span>
</div>
