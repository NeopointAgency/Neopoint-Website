---
/**
 * El puente, animado y simple (CSS puro, 10 s en bucle):
 * el cliente llega con su duda, cruza tres tablones (carga rápido · responde
 * dudas · muestra pruebas; cada uno se enciende con una etiqueta ✓) y llega al botón. Cita confirmada.
 */
const planks = [
  { n: '1', title: 'Carga rápido', tag: '0.8 s en el celular' },
  { n: '2', title: 'Responde dudas', tag: 'Garantía por escrito' },
  { n: '3', title: 'Muestra pruebas', tag: 'Trabajos y reseñas' },
];
---
<div class="bscene" data-scene aria-hidden="true">
<div class="bstage">
  <!-- Camino: se pinta de lima conforme avanza el cliente -->
  <svg class="path" viewBox="0 0 100 4" preserveAspectRatio="none" aria-hidden="true">
    <line x1="0" y1="2" x2="100" y2="2" pathLength="100" class="path__track" />
    <line x1="0" y1="2" x2="100" y2="2" pathLength="100" class="path__done" />
  </svg>
  <span class="arrow arrow--1">→</span>
  <span class="arrow arrow--2">→</span>

  <!-- Cliente -->
  <div class="visitor">
    <span class="vbubble"><span class="vbubble__q">¿Sí cumplen? ¿Por qué ellos?</span><span class="vbubble__a">Duda resuelta ✓</span></span>
    <span class="avatar">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4" /><path d="M4 21c0-4 3.6-7 8-7s8 3 8 7" /></svg>
    </span>
  </div>
  <p class="caption caption--left">Tu cliente llega con dudas</p>

  <!-- Puente -->
  <div class="deck">
    {planks.map(({ n, title, tag }, i) => (
      <div class:list={['plank', `plank--${i + 1}`]}>
        <span class="plank__tag">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5L20 7" /></svg>
          {tag}
        </span>
        <b>{n}</b>{title}
      </div>
    ))}
  </div>
  <p class="caption caption--center">El sitio hace tres cosas, en este orden</p>

  <!-- Botón -->
  <div class="goal">
    <span class="goal__ok">✓ Cita confirmada</span>
    <span class="goal__cta">Agendar</span>
  </div>
  <p class="caption caption--right">Y agenda</p>
</div>
</div>

<script>
  const scenes = document.querySelectorAll<HTMLElement>('.bscene[data-scene]');
  const io = new IntersectionObserver((entries) => {
    for (const e of entries) e.target.classList.toggle('is-playing', e.isIntersecting);
  }, { threshold: 0.2 });
  scenes.forEach((s) => io.observe(s));
</script>

<style>
  /* ───── Escenario: 10 s. 1 s = 10 % ───── */
  .bscene {
    --dur: 10s; --play: paused;
    position: relative; overflow: hidden; container-type: inline-size;
    aspect-ratio: 1.4 / 1; width: 100%;
    border-radius: var(--radius-card); background: var(--color-paper-soft);
  }
  @media (min-width: 640px) { .bscene { aspect-ratio: 2.6 / 1; } }
  .bscene.is-playing { --play: running; }
  .bstage { position: absolute; inset: 0; font-size: max(0.62rem, 1.6cqw); color: var(--color-text); }
  .bstage * { animation-duration: var(--dur); animation-iteration-count: infinite; animation-fill-mode: both; animation-timing-function: cubic-bezier(0.4, 0, 0.2, 1); animation-play-state: var(--play); }
  @media (prefers-reduced-motion: reduce) { .bstage * { animation-play-state: paused !important; animation-delay: -8.5s !important; } }

  /* Pies de foto */
  .caption { position: absolute; bottom: 2.4cqw; font-size: max(0.6rem, 1.5cqw); font-weight: 500; color: var(--color-faint); }
  .caption--left { left: 3%; width: 18%; text-align: center; }
  .caption--center { left: 50%; translate: -50% 0; }
  .caption--right { right: 6%; width: 14%; text-align: center; }

  /* Camino */
  .path { position: absolute; left: 12%; right: 13%; bottom: 13.6cqw; height: 1.2cqw; z-index: 1; overflow: visible; }
  .path__track { stroke: rgb(0 0 0 / 0.14); stroke-width: 4; stroke-linecap: round; stroke-dasharray: 2.2 2.2; vector-effect: non-scaling-stroke; }
  .path__done { stroke: var(--color-lime); stroke-width: 4; stroke-linecap: round; stroke-dasharray: 100; stroke-dashoffset: 100; vector-effect: non-scaling-stroke; animation-name: pathDone; animation-timing-function: linear; }

  .arrow { position: absolute; bottom: 16.4cqw; font-size: max(0.9rem, 2.4cqw); font-weight: 600; color: var(--color-faint); z-index: 4; }
  .arrow--1 { left: 18.6%; } .arrow--2 { left: 76.6%; }

  /* Cliente */
  .visitor { position: absolute; left: 6%; bottom: 14.2cqw; width: 12%; text-align: center; z-index: 5; animation-name: appear; }
  .avatar {
    display: grid; place-items: center; width: 8cqw; height: 8cqw; margin: 0 auto; border-radius: 50%; color: #fff;
    background: linear-gradient(180deg, #3b3b3b, #1a1a1a);
    box-shadow: 0 16px 30px -16px rgb(0 0 0 / 0.6), inset 0 1px 0 rgb(255 255 255 / 0.15);
  }
  .avatar svg { width: 55%; height: 55%; }
  .vbubble {
    position: absolute; bottom: calc(100% + 1.4cqw); left: 50%; translate: -50% 0; width: 20cqw;
    padding: 1.1cqw 1.5cqw; border-radius: 1.8cqw; color: #fff; font-size: max(0.58rem, 1.5cqw); font-weight: 600; line-height: 1.25;
    background: linear-gradient(180deg, #3b3b3b, #262626);
    box-shadow: 0 14px 26px -12px rgb(0 0 0 / 0.6), inset 0 1px 0 rgb(255 255 255 / 0.14);
    animation-name: bubble;
  }
  .vbubble__q, .vbubble__a { display: block; }
  .vbubble__a { position: absolute; inset: 0; display: grid; place-items: center; border-radius: inherit; background: var(--color-lime); color: #0a0a0a; opacity: 0; animation-name: answer; }
  .vbubble::after { content: ""; position: absolute; left: 50%; bottom: -0.6cqw; width: 1.2cqw; height: 1.2cqw; translate: -50% 0; rotate: 45deg; background: #262626; }

  /* Puente */
  .deck {
    position: absolute; left: 22%; right: 24%; bottom: 6.4cqw; display: grid; grid-template-columns: repeat(3, 1fr); gap: 1cqw;
    padding: 1cqw; border-radius: 2.2cqw; z-index: 2;
    background: linear-gradient(180deg, #3b3b3b, #1f1f1f);
    box-shadow: 0 30px 50px -30px rgb(0 0 0 / 0.6), inset 0 1px 0 rgb(255 255 255 / 0.14);
  }
  .plank {
    position: relative; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.2cqw;
    padding: 1.4cqw 0.8cqw; border-radius: 1.5cqw; text-align: center;
    font-size: max(0.6rem, 1.55cqw); font-weight: 600; color: #0a0a0a;
    background: linear-gradient(180deg, #ffffff, #efefef); box-shadow: 0 1px 0 rgb(0 0 0 / 0.08), inset 0 1px 0 #fff;
  }
  .plank b { font-size: 0.85em; color: var(--color-lime-deep); }
  .plank--1 { animation-name: plank1; } .plank--2 { animation-name: plank2; } .plank--3 { animation-name: plank3; }
  .plank__tag {
    position: absolute; left: 50%; bottom: calc(100% + 11cqw); white-space: nowrap;
    display: inline-flex; align-items: center; gap: 0.6cqw; padding: 0.6cqw 1.2cqw; border-radius: 999px;
    font-size: max(0.56rem, 1.4cqw); font-weight: 600; color: #0a0a0a; background: var(--color-lime);
    box-shadow: 0 12px 24px -12px rgb(151 239 73 / 0.8); opacity: 0;
  }
  .plank__tag svg { width: 1.1em; height: 1.1em; }
  .plank--1 .plank__tag { animation-name: tag1; } .plank--2 .plank__tag { animation-name: tag2; } .plank--3 .plank__tag { animation-name: tag3; }

  /* Botón */
  .goal { position: absolute; right: 6%; bottom: 14.2cqw; width: 14%; text-align: center; z-index: 3; }
  .goal__cta {
    display: block; padding: 1.6cqw 0; border-radius: 1.6cqw; font-size: max(0.66rem, 1.8cqw); font-weight: 600; color: #0a0a0a;
    background: var(--color-lime); box-shadow: 0 16px 30px -14px rgb(151 239 73 / 0.7); animation-name: cta;
  }
  .goal__ok {
    position: absolute; left: 50%; bottom: calc(100% + 1.4cqw); white-space: nowrap;
    padding: 0.8cqw 1.4cqw; border-radius: 999px; font-size: max(0.58rem, 1.5cqw); font-weight: 600;
    color: var(--color-text); background: var(--color-paper); box-shadow: 0 0 0 1px var(--color-line), 0 12px 24px -12px rgb(0 0 0 / 0.35);
    opacity: 0; animation-name: ok;
  }

  /* ───── Keyframes (1 s = 10 %) ─────
     0–1 llega · 1–2.5 tablón 1 · 2.5–4.5 tablón 2 · 4.5–6.5 tablón 3 · 6.5–8 botón · hold · 9.4–10 fade */
  @keyframes appear { 0%, 2% { opacity: 0; transform: translateY(6px); } 8%, 92% { opacity: 1; transform: none; } 96%, 100% { opacity: 0; transform: none; } }
  @keyframes pathDone {
    0%, 8%  { stroke-dashoffset: 100; opacity: 1; }
    18%     { stroke-dashoffset: 78; }
    25%     { stroke-dashoffset: 78; }
    38%     { stroke-dashoffset: 55; }
    45%     { stroke-dashoffset: 55; }
    58%     { stroke-dashoffset: 32; }
    65%     { stroke-dashoffset: 32; }
    78%, 92% { stroke-dashoffset: 0; opacity: 1; }
    96%, 100% { stroke-dashoffset: 0; opacity: 0; }
  }
  @keyframes bubble { 0%, 4% { opacity: 0; } 10%, 92% { opacity: 1; } 96%, 100% { opacity: 0; } }
  @keyframes answer { 0%, 40% { opacity: 0; } 44%, 100% { opacity: 1; } }
  @keyframes plank1 { 0%, 17% { box-shadow: 0 1px 0 rgb(0 0 0 / 0.08), inset 0 1px 0 #fff; } 20%, 92% { box-shadow: 0 0 0 0.45cqw var(--color-lime), inset 0 1px 0 #fff; } 96%, 100% { box-shadow: 0 1px 0 rgb(0 0 0 / 0.08), inset 0 1px 0 #fff; } }
  @keyframes plank2 { 0%, 37% { box-shadow: 0 1px 0 rgb(0 0 0 / 0.08), inset 0 1px 0 #fff; } 40%, 92% { box-shadow: 0 0 0 0.45cqw var(--color-lime), inset 0 1px 0 #fff; } 96%, 100% { box-shadow: 0 1px 0 rgb(0 0 0 / 0.08), inset 0 1px 0 #fff; } }
  @keyframes plank3 { 0%, 57% { box-shadow: 0 1px 0 rgb(0 0 0 / 0.08), inset 0 1px 0 #fff; } 60%, 92% { box-shadow: 0 0 0 0.45cqw var(--color-lime), inset 0 1px 0 #fff; } 96%, 100% { box-shadow: 0 1px 0 rgb(0 0 0 / 0.08), inset 0 1px 0 #fff; } }
  @keyframes tag1 { 0%, 19% { opacity: 0; transform: translate(-50%, 6px); } 23%, 92% { opacity: 1; transform: translate(-50%, 0); } 96%, 100% { opacity: 0; transform: translate(-50%, 0); } }
  @keyframes tag2 { 0%, 39% { opacity: 0; transform: translate(-50%, 6px); } 43%, 92% { opacity: 1; transform: translate(-50%, 0); } 96%, 100% { opacity: 0; transform: translate(-50%, 0); } }
  @keyframes tag3 { 0%, 59% { opacity: 0; transform: translate(-50%, 6px); } 63%, 92% { opacity: 1; transform: translate(-50%, 0); } 96%, 100% { opacity: 0; transform: translate(-50%, 0); } }
  @keyframes cta { 0%, 78% { transform: scale(1); } 80% { transform: scale(1.08); } 82%, 100% { transform: scale(1); } }
  @keyframes ok { 0%, 81% { opacity: 0; transform: translate(-50%, 6px); } 85%, 92% { opacity: 1; transform: translate(-50%, 0); } 96%, 100% { opacity: 0; transform: translate(-50%, 0); } }
</style>
