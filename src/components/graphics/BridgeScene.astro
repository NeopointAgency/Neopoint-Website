---
/**
 * El puente como diagrama de flujo (CSS puro, 10 s en bucle):
 * cliente con duda → 1 carga rápido → 2 responde dudas → 3 muestra pruebas → agendar.
 * Cinco nodos en un solo eje; la línea se pinta de lima y cada paso se enciende con su etiqueta.
 */
const steps = [
  { n: '1', title: 'Carga rápido', tag: '0.8 s en el celular' },
  { n: '2', title: 'Responde dudas', tag: 'Garantía por escrito' },
  { n: '3', title: 'Muestra pruebas', tag: 'Trabajos y reseñas' },
];
---
<div class="bscene" data-scene aria-hidden="true">
  <div class="flow">
    <!-- Cliente -->
    <div class="node node--client">
      <span class="bubble">
        <span class="bubble__q">¿Sí cumplen?</span>
        <span class="bubble__a"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5L20 7" /></svg>Duda resuelta</span>
      </span>
      <span class="avatar">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4" /><path d="M4 21c0-4 3.6-7 8-7s8 3 8 7" /></svg>
      </span>
      <span class="cap">Tu cliente</span>
    </div>

    <span class="link link--1"></span>

    {steps.map(({ n, title, tag }, i) => (
      <>
        <div class:list={['node node--step', `step--${i + 1}`]}>
          <span class="tag"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5L20 7" /></svg>{tag}</span>
          <span class="card"><b>{n}</b>{title}</span>
          {i === 1 && <span class="cap">El sitio</span>}
        </div>
        <span class:list={['link', `link--${i + 2}`]}></span>
      </>
    ))}

    <!-- Acción -->
    <div class="node node--goal">
      <span class="tag tag--ok"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5L20 7" /></svg>Cita confirmada</span>
      <span class="cta">Agendar</span>
      <span class="cap">Una sola acción</span>
    </div>
  </div>
</div>

<script>
  const scenes = document.querySelectorAll<HTMLElement>('.bscene[data-scene]');
  const io = new IntersectionObserver((entries) => {
    for (const e of entries) e.target.classList.toggle('is-playing', e.isIntersecting);
  }, { threshold: 0.3 });
  scenes.forEach((s) => io.observe(s));
</script>

<style>
  /* ───── Escenario: 10 s. 1 s = 10 % ───── */
  .bscene {
    --dur: 10s; --play: paused;
    padding: 4.5rem 1.5rem 2rem; border-radius: var(--radius-card); background: var(--color-paper-soft);
  }
  @media (min-width: 640px) { .bscene { padding: 5rem 2.5rem 2.5rem; } }
  .bscene.is-playing { --play: running; }
  .bscene * { animation-duration: var(--dur); animation-iteration-count: infinite; animation-fill-mode: both; animation-timing-function: cubic-bezier(0.4, 0, 0.2, 1); animation-play-state: var(--play); }
  @media (prefers-reduced-motion: reduce) { .bscene * { animation-play-state: paused !important; animation-delay: -8s !important; } }

  /* Un solo eje: nodo · línea · nodo · línea … */
  .flow { display: flex; flex-direction: column; align-items: center; gap: 0; }
  @media (min-width: 640px) { .flow { flex-direction: row; align-items: flex-start; } }
  .node { position: relative; display: flex; flex-direction: column; align-items: center; flex: none; }
  .cap { position: absolute; top: calc(100% + 0.6rem); white-space: nowrap; font-size: 0.75rem; font-weight: 500; color: var(--color-faint); }
  .node--step .cap { top: calc(100% + 0.6rem); }

  /* Línea que se pinta de lima (vertical en móvil, horizontal en escritorio) */
  .link { position: relative; flex: none; width: 3px; height: 2.25rem; margin: 0.25rem 0; border-radius: 999px; background: rgb(0 0 0 / 0.1); overflow: hidden; }
  .link::after { content: ""; position: absolute; inset: 0; transform-origin: top; transform: scaleY(0); background: var(--color-lime-deep); animation: var(--fill) var(--dur) cubic-bezier(0.4, 0, 0.2, 1) infinite both; animation-play-state: var(--play); }
  @media (min-width: 640px) {
    .link { flex: 1 1 0; width: auto; height: 3px; margin: 0 0.5rem; align-self: center; }
    .link::after { transform-origin: left; transform: scaleX(0); }
  }
  .link--1 { --fill: fill1; } .link--2 { --fill: fill2; } .link--3 { --fill: fill3; } .link--4 { --fill: fill4; }

  /* Cliente */
  .avatar {
    display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #fff;
    background: linear-gradient(180deg, #3b3b3b, #1a1a1a);
    box-shadow: 0 14px 26px -14px rgb(0 0 0 / 0.6), inset 0 1px 0 rgb(255 255 255 / 0.15);
    animation-name: appear;
  }
  .avatar svg { width: 55%; height: 55%; }
  .bubble {
    position: absolute; bottom: calc(100% + 0.8rem); left: 0; width: max-content; max-width: 9rem;
    padding: 0.5rem 0.8rem; border-radius: 0.9rem; color: #fff; font-size: 0.8rem; font-weight: 600; line-height: 1.25; text-align: left;
    background: linear-gradient(180deg, #3b3b3b, #262626);
    box-shadow: 0 14px 26px -12px rgb(0 0 0 / 0.55), inset 0 1px 0 rgb(255 255 255 / 0.14);
    animation-name: appear;
  }
  .bubble::after { content: ""; position: absolute; left: 1.75rem; bottom: -0.3rem; width: 0.6rem; height: 0.6rem; translate: -50% 0; rotate: 45deg; background: #262626; }
  .bubble__q, .bubble__a { display: flex; align-items: center; justify-content: flex-start; gap: 0.35rem; }
  .bubble__a { padding: 0.5rem 0.8rem; }
  .bubble__a { position: absolute; inset: 0; border-radius: inherit; background: #fff; color: var(--color-text); box-shadow: 0 0 0 1px var(--color-line); opacity: 0; animation-name: answer; }
  .bubble__a svg { width: 0.9rem; height: 0.9rem; color: var(--color-lime-deep); }

  /* Pasos */
  .card {
    display: flex; flex-direction: column; align-items: center; gap: 0.1rem; width: 9.5rem; padding: 0.9rem 0.75rem; border-radius: 0.9rem;
    font-size: 0.9rem; font-weight: 600; color: var(--color-text); text-align: center;
    background: var(--color-paper); box-shadow: 0 0 0 1px var(--color-line), 0 18px 30px -24px rgb(0 0 0 / 0.35);
  }
  .card b { font-size: 0.7rem; color: var(--color-faint); }
  .step--1 .card { animation-name: light1; } .step--2 .card { animation-name: light2; } .step--3 .card { animation-name: light3; }
  .tag {
    position: absolute; bottom: calc(100% + 0.6rem); left: 50%; white-space: nowrap;
    display: inline-flex; align-items: center; gap: 0.35rem; padding: 0.3rem 0.65rem; border-radius: 999px;
    font-size: 0.72rem; font-weight: 600; color: #0a0a0a; background: var(--color-lime);
    box-shadow: 0 10px 20px -12px rgb(151 239 73 / 0.8); opacity: 0; transform: translate(-50%, 4px);
  }
  .tag svg { width: 0.8rem; height: 0.8rem; }
  .step--1 .tag { animation-name: tag1; } .step--2 .tag { animation-name: tag2; } .step--3 .tag { animation-name: tag3; }

  /* Acción */
  .cta {
    display: block; padding: 0.9rem 1.6rem; border-radius: 0.9rem; font-size: 0.95rem; font-weight: 600; color: #0a0a0a;
    background: var(--color-lime); box-shadow: 0 14px 28px -14px rgb(151 239 73 / 0.7); animation-name: cta;
  }
  .tag--ok { background: var(--color-paper); color: var(--color-text); box-shadow: 0 0 0 1px var(--color-line), 0 10px 20px -12px rgb(0 0 0 / 0.35); animation-name: ok; }
  .tag--ok svg { color: var(--color-lime-deep); }

  /* ───── Keyframes (1 s = 10 %) ─────
     0–0.8 aparece · 0.8–1.6 línea 1 → paso 1 · 2.4–3.2 línea 2 → paso 2 (duda resuelta)
     4.0–4.8 línea 3 → paso 3 · 5.6–6.4 línea 4 → botón · hold · 9.2–10 se apaga */
  @keyframes appear { 0% { opacity: 0; transform: translateY(6px); } 8%, 92% { opacity: 1; transform: none; } 97%, 100% { opacity: 0; } }
  @keyframes fill1 { 0%, 8%  { transform: scale(0); } 16%, 92% { transform: none; } 97%, 100% { transform: scale(0); } }
  @keyframes fill2 { 0%, 24% { transform: scale(0); } 32%, 92% { transform: none; } 97%, 100% { transform: scale(0); } }
  @keyframes fill3 { 0%, 40% { transform: scale(0); } 48%, 92% { transform: none; } 97%, 100% { transform: scale(0); } }
  @keyframes fill4 { 0%, 56% { transform: scale(0); } 64%, 92% { transform: none; } 97%, 100% { transform: scale(0); } }
  @keyframes light1 { 0%, 16% { box-shadow: 0 0 0 1px var(--color-line), 0 18px 30px -24px rgb(0 0 0 / 0.35); } 18%, 92% { box-shadow: 0 0 0 2px var(--color-lime-deep), 0 18px 30px -24px rgb(0 0 0 / 0.35); } 97%, 100% { box-shadow: 0 0 0 1px var(--color-line), 0 18px 30px -24px rgb(0 0 0 / 0.35); } }
  @keyframes light2 { 0%, 32% { box-shadow: 0 0 0 1px var(--color-line), 0 18px 30px -24px rgb(0 0 0 / 0.35); } 34%, 92% { box-shadow: 0 0 0 2px var(--color-lime-deep), 0 18px 30px -24px rgb(0 0 0 / 0.35); } 97%, 100% { box-shadow: 0 0 0 1px var(--color-line), 0 18px 30px -24px rgb(0 0 0 / 0.35); } }
  @keyframes light3 { 0%, 48% { box-shadow: 0 0 0 1px var(--color-line), 0 18px 30px -24px rgb(0 0 0 / 0.35); } 50%, 92% { box-shadow: 0 0 0 2px var(--color-lime-deep), 0 18px 30px -24px rgb(0 0 0 / 0.35); } 97%, 100% { box-shadow: 0 0 0 1px var(--color-line), 0 18px 30px -24px rgb(0 0 0 / 0.35); } }
  @keyframes tag1 { 0%, 17% { opacity: 0; transform: translate(-50%, 4px); } 21%, 92% { opacity: 1; transform: translate(-50%, 0); } 97%, 100% { opacity: 0; transform: translate(-50%, 0); } }
  @keyframes tag2 { 0%, 33% { opacity: 0; transform: translate(-50%, 4px); } 37%, 92% { opacity: 1; transform: translate(-50%, 0); } 97%, 100% { opacity: 0; transform: translate(-50%, 0); } }
  @keyframes tag3 { 0%, 49% { opacity: 0; transform: translate(-50%, 4px); } 53%, 92% { opacity: 1; transform: translate(-50%, 0); } 97%, 100% { opacity: 0; transform: translate(-50%, 0); } }
  @keyframes answer { 0%, 35% { opacity: 0; } 39%, 100% { opacity: 1; } }
  @keyframes cta { 0%, 64% { transform: scale(1); } 66% { transform: scale(1.08); } 68%, 100% { transform: scale(1); } }
  @keyframes ok { 0%, 66% { opacity: 0; transform: translate(-50%, 4px); } 70%, 92% { opacity: 1; transform: translate(-50%, 0); } 97%, 100% { opacity: 0; transform: translate(-50%, 0); } }
</style>
