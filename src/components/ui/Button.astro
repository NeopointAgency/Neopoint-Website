---
import type { HTMLAttributes } from 'astro/types';

/**
 * Botón con el acabado de las tarjetas: degradado, brillo fijo arriba y sombra suave (estilos en global.css).
 * primary   → relleno con el color de texto (negro en claro, blanco en oscuro)
 * secondary → superficie suave con borde fino
 * ghost     → solo texto
 * Los enlaces externos muestran el icono ⤢ automáticamente.
 */
interface Props extends HTMLAttributes<'a'> {
  href: string;
  variant?: 'primary' | 'secondary' | 'ghost' | 'inverse' | 'glass';
  size?: 'sm' | 'md' | 'lg';
  external?: boolean;
  icon?: boolean;
  class?: string;
}

const { href, variant = 'primary', size = 'md', external, icon = true, class: className = '', ...rest } = Astro.props;
const isExternal = external ?? /^https?:\/\//.test(href);

const base =
  'group inline-flex items-center justify-center gap-2 rounded-btn font-medium whitespace-nowrap transition-[background-color,border-color,color,transform,box-shadow,filter] duration-300 ease-(--ease-out-expo) active:translate-y-0 active:scale-[0.985]';
const sizes = { sm: 'h-9 px-3.5 text-sm', md: 'h-11 px-5 text-[0.95rem]', lg: 'h-12 px-6 text-base' };
const variants = {
  primary: 'btn-primary',
  secondary: 'btn-secondary',
  ghost: 'text-muted hover:text-text',
  inverse: 'btn-inverse',
  glass: 'btn-glass',
};
---

<a
  href={href}
  class:list={[base, sizes[size], variants[variant], className]}
  {...(isExternal ? { target: '_blank', rel: 'noopener' } : {})}
  {...rest}
>
  <slot />
  {icon && isExternal && (
    <svg class="size-3.5 opacity-70 transition-transform duration-300 group-hover:translate-x-px group-hover:-translate-y-px" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M4 12 12 4M6 4h6v6" />
    </svg>
  )}
  <slot name="icon" />
</a>
