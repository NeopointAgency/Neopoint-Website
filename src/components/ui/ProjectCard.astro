---
import { Image } from 'astro:assets';
import { projectHref, type Project } from '../../lib/portfolio';

interface Props { project: Project; eager?: boolean; class?: string }
const { project, eager = false, class: className = '' } = Astro.props;
const { title, sector, cover, results } = project.data;
const href = projectHref(project);
---

<a href={href} class:list={['group block', className]}>
  <div class="overflow-hidden rounded-card border border-line bg-surface">
    {cover ? (
      <Image
        src={cover}
        alt={`Vista del proyecto ${title}`}
        widths={[400, 640, 800]}
        sizes="(min-width: 1024px) 380px, (min-width: 640px) 50vw, 100vw"
        format="webp"
        quality={82}
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
        class="aspect-[4/3] w-full object-cover transition-transform duration-700 ease-(--ease-out-expo) group-hover:scale-[1.03]"
      />
    ) : (
      <div class="flex aspect-[4/3] w-full flex-col justify-end bg-ink p-6 text-white">
        <dl class="grid grid-cols-2 gap-4">
          {results.slice(0, 4).map((r) => (
            <div>
              <dd class="text-2xl font-semibold">{r.value}</dd>
              <dt class="text-xs text-white/60">{r.label}</dt>
            </div>
          ))}
        </dl>
      </div>
    )}
  </div>
  <div class="mt-3.5 flex items-start justify-between gap-4 px-0.5">
    <div>
      <h3 class="text-[1.05rem] font-medium text-text">{title}</h3>
      <p class="mt-0.5 text-sm text-muted">{sector}</p>
    </div>
    <svg class="mt-1 size-4 shrink-0 text-faint transition-all duration-300 group-hover:translate-x-px group-hover:-translate-y-px group-hover:text-text" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12 12 4M6 4h6v6"/></svg>
    <span class="sr-only">Ver proyecto</span>
  </div>
</a>
