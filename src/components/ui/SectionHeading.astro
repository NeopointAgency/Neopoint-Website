---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: 'center' | 'left';
  tone?: 'light' | 'dark';
  as?: 'h1' | 'h2' | 'h3';
  id?: string;
  class?: string;
}
const { eyebrow, title, description, align = 'left', tone = 'light', as: Tag = 'h2', id, class: className = '' } = Astro.props;
const dark = tone === 'dark';
---

<div class:list={['reveal max-w-2xl', align === 'center' ? 'mx-auto text-center' : 'text-left', className]}>
  {eyebrow && (
    <p class:list={['mb-3 text-sm font-medium', dark ? 'text-white/50' : 'text-muted']}>{eyebrow}</p>
  )}
  <Tag {id} class:list={['text-3xl font-semibold leading-[1.12] sm:text-4xl', dark ? 'text-white' : 'text-text']}>
    {title}
  </Tag>
  {description && (
    <p class:list={['mt-4 text-lg leading-relaxed', dark ? 'text-white/60' : 'text-muted']}>{description}</p>
  )}
</div>
