---
/**
 * Monitor dibujado en CSS con varias "pantallas" apiladas.
 * Solo la activa (y sus vecinas, precargadas) están en el DOM visible; el resto
 * queda en display:none para que las imágenes lazy no se descarguen.
 * Para cambiar de pantalla: el elemento [data-monitor] escucha el evento
 * personalizado `np:screen` con `detail: { id }`.
 */
import { Image } from 'astro:assets';
import type { Project } from '../../lib/portfolio';

interface Props { projects: Project[]; eagerCount?: number; sizes?: string; class?: string }
const { projects, eagerCount = 1, sizes = '(min-width: 1024px) 56vw, 100vw', class: className = '' } = Astro.props;
---

<div class:list={['relative mx-auto w-full', className]} data-monitor>
  <div class="pointer-events-none absolute left-1/2 top-1/3 h-[60%] w-[110%] -translate-x-1/2 -translate-y-1/2 rounded-[50%] bg-white/[0.045] blur-3xl" aria-hidden="true"></div>

  <div class="relative">
    <div class="relative rounded-[14px] border border-white/10 bg-[#161616] p-[6px] shadow-[0_30px_80px_-30px_rgba(0,0,0,0.9)] sm:rounded-[18px] sm:p-2.5">
      <div class="relative aspect-[16/10] overflow-hidden rounded-[8px] bg-[#0d0d0d] sm:rounded-[10px]" data-screen-stage>
        {projects.map((p, i) => (
          <div
            class="screen absolute inset-0"
            data-screen={p.id}
            {...(i === 0 ? { 'data-active': '' } : {})}
            {...(i === 1 ? { 'data-warm': '' } : {})}
          >
            {p.data.cover ? (
              <Image
                src={p.data.cover}
                alt={`Proyecto ${p.data.title}`}
                widths={[640, 960, 1280]}
                {sizes}
                format="webp"
                quality={82}
                loading={i < eagerCount ? 'eager' : 'lazy'}
                decoding="async"
                class="h-full w-full object-cover"
              />
            ) : (
              <div class="flex h-full w-full flex-col justify-between bg-[radial-gradient(60%_80%_at_50%_0%,rgba(151,239,73,0.22),transparent_70%),#0d0d0d] p-6 text-white sm:p-10">
                <p class="text-sm font-medium text-white/50">{p.data.sector}</p>
                <dl class="grid grid-cols-2 gap-5 sm:gap-8">
                  {p.data.results.map((r) => (
                    <div>
                      <dd class="text-3xl font-semibold sm:text-5xl">{r.value}</dd>
                      <dt class="mt-1 text-xs text-white/55 sm:text-sm">{r.label}</dt>
                    </div>
                  ))}
                </dl>
              </div>
            )}
          </div>
        ))}
      </div>
    </div>
    <div class="mx-auto h-14 w-24 bg-gradient-to-b from-[#2b2b2b] to-[#171717] [clip-path:polygon(18%_0,82%_0,100%_100%,0_100%)] sm:h-24 sm:w-32" aria-hidden="true"></div>
    <div class="mx-auto h-1.5 w-40 rounded-full bg-gradient-to-r from-[#161616] via-[#2c2c2c] to-[#161616] sm:h-2 sm:w-64" aria-hidden="true"></div>
  </div>
  <div class="pointer-events-none absolute inset-x-[-30%] bottom-0 h-24 bg-gradient-to-t from-[#141414] to-transparent sm:h-36 lg:hidden" aria-hidden="true"></div>
</div>

<style>
  .screen { display: none; opacity: 0; transition: opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1); }
  .screen[data-warm], .screen[data-leaving] { display: block; }
  .screen[data-active] { display: block; opacity: 1; z-index: 1; }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-monitor]').forEach((monitor) => {
    const screens = [...monitor.querySelectorAll<HTMLElement>('[data-screen]')];
    let leavingTimer = 0;

    monitor.addEventListener('np:screen', (e) => {
      const id = (e as CustomEvent<{ id: string }>).detail.id;
      const idx = screens.findIndex((s) => s.dataset.screen === id);
      if (idx < 0) return;
      const current = screens.find((s) => s.hasAttribute('data-active'));
      if (current === screens[idx]) return;

      window.clearTimeout(leavingTimer);
      screens.forEach((s) => { s.removeAttribute('data-leaving'); s.removeAttribute('data-warm'); });

      // La pantalla saliente sigue visible mientras se desvanece.
      if (current) { current.removeAttribute('data-active'); current.setAttribute('data-leaving', ''); }

      const next = screens[idx];
      next.setAttribute('data-warm', '');
      void next.offsetHeight; // fuerza layout con display:block para que la opacidad anime
      next.setAttribute('data-active', '');
      next.removeAttribute('data-warm');

      // Precalienta las vecinas (cargan su imagen sin mostrarse).
      [screens[idx - 1], screens[idx + 1]].forEach((s) => s && s !== next && s.setAttribute('data-warm', ''));

      leavingTimer = window.setTimeout(() => current?.removeAttribute('data-leaving'), 600);
    });
  });
</script>
