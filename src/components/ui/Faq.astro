---
import SectionHeading from './SectionHeading.astro';

interface Props { items: { q: string; a: string }[]; title?: string; description?: string }
const { items, title = 'Preguntas frecuentes', description } = Astro.props;
---

<section class="py-20 sm:py-28" aria-labelledby="faq-title">
  <div class="container-x grid gap-10 lg:grid-cols-12">
    <div class="lg:col-span-4"><SectionHeading id="faq-title" eyebrow="FAQ" {title} {description} /></div>
    <div class="divide-y divide-line rounded-card border border-line bg-paper lg:col-span-8">
      {items.map(({ q, a }) => (
        <details class="group px-6 py-5">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-left text-[1.05rem] font-medium text-text [&::-webkit-details-marker]:hidden">
            {q}
            <span class="inline-flex size-7 shrink-0 items-center justify-center rounded-full border border-line text-muted transition-transform duration-300 group-open:rotate-45" aria-hidden="true">
              <svg class="size-3.5" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M10 4v12M4 10h12"/></svg>
            </span>
          </summary>
          <p class="mt-3 max-w-2xl leading-relaxed text-muted">{a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
