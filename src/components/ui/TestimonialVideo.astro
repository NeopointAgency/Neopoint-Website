---
/** Video testimonial autoalojado (sin scripts de terceros): portada, controles y cita al lado. */
interface Props { video: string; poster: string; quote: string; author: string; role?: string; vertical?: boolean; href?: string; hrefLabel?: string; tone?: 'light' | 'dark' }
const { video, poster, quote, author, role, vertical = false, href, hrefLabel = 'Ver el proyecto', tone = 'light' } = Astro.props;
const dark = tone === 'dark';
---

<div class="grid gap-8 lg:grid-cols-12 lg:items-center">
  <div class:list={[vertical ? 'lg:col-span-5' : 'lg:col-span-7']}>
    <video
      class:list={['w-full rounded-card border border-line bg-ink object-cover', vertical ? 'mx-auto aspect-[9/16] max-w-sm' : 'aspect-video']}
      src={video}
      poster={poster}
      controls
      preload="metadata"
      playsinline
    >
      Tu navegador no reproduce video. <a href={video}>Descarga el testimonio</a>.
    </video>
  </div>
  <figure class:list={[vertical ? 'lg:col-span-7' : 'lg:col-span-5']}>
    <blockquote class:list={['text-2xl font-medium leading-snug sm:text-3xl', dark ? 'text-white' : 'text-text']}>“{quote}”</blockquote>
    <figcaption class:list={['mt-5 text-sm', dark ? 'text-white/55' : 'text-muted']}>
      <span class:list={['block font-semibold', dark ? 'text-white' : 'text-text']}>{author}</span>
      {role && <span class="block">{role}</span>}
    </figcaption>
    {href && (
      <a href={href} class:list={['mt-6 inline-flex items-center gap-1.5 text-sm font-medium underline-offset-4 hover:underline', dark ? 'text-white' : 'text-text']}>
        {hrefLabel}
        <svg class="size-4" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 10h12M11 5l5 5-5 5"/></svg>
      </a>
    )}
  </figure>
</div>
