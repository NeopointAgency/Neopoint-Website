---
import Base from '../../layouts/Base.astro';
import Button from '../../components/ui/Button.astro';
import WebProcessScene from '../../components/sections/WebProcessScene.astro';
import GraphicCard from '../../components/ui/GraphicCard.astro';
import SitemapGraphic from '../../components/graphics/SitemapGraphic.astro';
import SeoGraphic from '../../components/graphics/SeoGraphic.astro';
import EditorGraphic from '../../components/graphics/EditorGraphic.astro';
import BookingGraphic from '../../components/graphics/BookingGraphic.astro';
import BridgeGraphic from '../../components/graphics/BridgeGraphic.astro';
import DashboardGraphic from '../../components/graphics/DashboardGraphic.astro';
import MistakeScene from '../../components/graphics/MistakeScene.astro';
import Faq from '../../components/ui/Faq.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import Portfolio from '../../components/sections/Portfolio.astro';
import ClientsMarquee from '../../components/sections/ClientsMarquee.astro';
import Results from '../../components/sections/Results.astro';
import Testimonials from '../../components/sections/Testimonials.astro';
import { site } from '../../data/site';

const title = 'Diseño Web que convierte | Sitios que agendan clientes | Neopoint';
const description =
  'Diseñamos sitios web como un puente entre lo que busca tu cliente y tu oferta: responden sus dudas, cargan rápido y llevan a una sola acción. Estudio del negocio, textos, diseño a la medida, sistema de agendado y SEO. Primer resultado en 10 días, entrega en 45.';

/* Cifras del método (aplican a todo proyecto) */
const promises = [
  { value: '10 días', label: 'para ver el primer boceto' },
  { value: '45 días', label: 'del arranque al lanzamiento' },
  { value: '90+', label: 'calificación en las pruebas de Google' },
];

/* 01 · Lo que espanta a los clientes */
const mistakes = [
  { kind: 'company', title: 'Habla de la empresa, no del cliente', text: 'Años de experiencia, lista de servicios, fotos genéricas. El visitante entró preguntándose otra cosa.' },
  { kind: 'fear', title: 'No responde el miedo principal', text: '“¿Y si pago y no vuelven?”, “¿sí van a terminar?”. Si el sitio no lo contesta, se va con el competidor que sí.' },
  { kind: 'proof', title: 'No hay prueba', text: 'Sin trabajos reales, reseñas ni registros visibles nadie contrata. En servicios, la confianza lo es todo.' },
  { kind: 'button', title: 'El botón está escondido y la página es lenta', text: 'Menús, formularios largos y segundos de espera. Quien entra con urgencia desde el celular necesita un botón grande, y ya.' },
];

/* 03 · Perfil del comprador (ejemplo real, resumido) */
const profileIcons: Record<string, string> = {
  'Lo que desea': '<path d="M12 21s-7-4.6-9.3-8.6C.8 9 3 5 6.8 5c2 0 3.4 1 4.2 2.3C11.8 6 13.2 5 15.2 5 19 5 21.2 9 19.3 12.4 17 16.4 12 21 12 21Z"/>',
  'Su miedo principal': '<path d="M12 3 2 20h20L12 3Z"/><path d="M12 10v4M12 17h.01"/>',
  'Necesita ver': '<path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/>',
};
const profile = [
  { k: 'Lo que desea', v: 'Un techo que aguante el invierno, hecho por alguien que sí llega, sí termina y cobra lo que dijo.' },
  { k: 'Su miedo principal', v: '“¿Y si les doy el anticipo y no vuelven?”', quote: true },
  { k: 'Necesita ver', v: 'Licencia visible, fotos de trabajos reales en su zona, reseñas de vecinos y una inspección gratis fácil de agendar.' },
];

/* 04 · Los 4 pilares */
const pillars = [
  { graphic: SitemapGraphic, title: 'Estructura que vende antes de que lean', description: 'Cada sección tiene un trabajo: resolver una duda, dar confianza o llevar al botón. La información se acomoda según qué tan decidido llega el visitante.' },
  { graphic: EditorGraphic, title: 'Diseño y textos que te vuelven la opción obvia', description: 'Diseño a la medida de tu marca, no una plantilla. Textos que le hablan a tu cliente de sus miedos reales y una sección de prueba: trabajos, reseñas, registros.' },
  { graphic: BookingGraphic, title: 'Sistema de agendado y seguimiento', description: 'Formulario corto o calendario para elegir día y hora. Aviso inmediato a tu celular y correo, y cada contacto guardado en una lista para que ninguno se pierda.' },
  { graphic: SeoGraphic, title: 'Que te encuentren en Google', description: 'Cada página lista para que Google la entienda, conexión con tu perfil de negocio y páginas por ciudad o zona para las búsquedas locales.' },
];

/* 05 · Lo que recibes */
const deliverables = [
  'Estudio del negocio y plan para que el sitio convierta',
  'Boceto de la página de inicio en 10 días, que define el estilo de todo',
  'Todos los textos del sitio, escritos para tu cliente',
  'Diseño a la medida, pensado dos veces: celular y computadora',
  'Sistema de agendado: formulario corto y calendario',
  'Aviso inmediato de cada solicitud y lista de contactos',
  'Páginas de servicio que terminan en el mismo botón',
  'Páginas por ciudad o zona para búsquedas locales',
  'Trabajo completo para aparecer en Google',
  'Tecnología de alto desempeño: carga rápido, siempre',
  'Panel de monitoreo anual: leads, visitas y de dónde llega el tráfico',
];
/* Incluido en cada proyecto, sin costo adicional */
const extras = [
  { title: 'Sesión de arranque y plan estructurado', text: 'Qué necesitamos de ti, qué hacemos nosotros y las fechas de cada cosa.' },
  { title: 'Ajuste de logo', text: 'Lo pulimos para que se vea nítido en el sitio, en Google y donde se use.' },
  { title: 'Guía de fotos', text: 'Cómo tomar fotos de tus trabajos con el celular, para que la galería crezca sola.' },
  { title: 'Soporte directo 30 días', text: 'Después del lanzamiento, línea directa por WhatsApp para ajustes y dudas.' },
];

/* 06 · Cronograma */
const stages = [
  { days: 'Días 1–10', title: 'Arranque y primer resultado', items: ['Reunimos logo, fotos, registros y datos del negocio', 'Definimos cómo se organiza el sitio y dónde van los botones', 'Entregamos el boceto de la página de inicio'], pay: 'Primer pago · ves el primer resultado' },
  { days: 'Días 11–20', title: 'Diseño completo', items: ['Con la inicio aprobada, diseñamos el resto del sitio', 'Escribimos todos los textos para tu cliente', 'Apruebas el diseño completo antes de construir'], pay: 'Al aprobar, segundo pago' },
  { days: 'Días 21–35', title: 'Construcción', items: ['Construimos el sitio, el formulario y el calendario', 'Subimos fotos, servicios y páginas por ciudad', 'Revisas todo ya en funcionamiento'], pay: null },
  { days: 'Días 36–45', title: 'Lanzamiento', items: ['Configuramos el sitio con Google', 'Probamos velocidad y funcionamiento en celular', 'Lanzamos y damos seguimiento los primeros días'], pay: 'Contra entrega, el tercer pago' },
];

/* 07 · Garantías y alcance */
const guarantees = [
  { title: 'Primer resultado en 10 días', text: 'A los 10 días hábiles tienes el boceto de la página de inicio listo para revisar y aprobar. Si no llega, lo ves de inmediato, no seis meses después.' },
  { title: 'Garantía de satisfacción', text: 'Trabajamos contigo hasta lograr un diseño que apruebes y que cumpla lo acordado. No firmamos la entrega hasta que estés conforme.' },
  { title: 'Garantía de rendimiento', text: 'Entregamos el sitio con calificación de 90 o más en las herramientas de medición de Google: velocidad, buscadores y facilidad de uso.' },
];

/* Para quién es */
const fit = {
  yes: [
    'Vendes un servicio donde la confianza decide la compra',
    'Ves tu sitio como una inversión con retorno, no como un gasto de diseño',
    'Quieres un proceso con fechas, entregas revisables y garantías por escrito',
  ],
  no: [
    'Buscas la opción más barata o una plantilla con tus datos',
    'Esperas aparecer primero en Google en 30 días',
    'Quieres “una página” solo por tener una',
  ],
};

/* Siguiente paso */
const nextSteps = [
  'Sesión de diagnóstico: 30 minutos por videollamada para entender tu negocio y tu cliente',
  'Recibes una propuesta con alcance exacto, fechas y esquema de pagos',
  'Firmamos acuerdo y arrancamos en 48 horas',
];

const faqs = [
  { q: 'Ya nos quedó mal una agencia antes. ¿En qué son diferentes?', a: 'No te pedimos que confíes en palabras. Cada pago se libera contra algo que puedes ver y revisar, el primer resultado llega en 10 días y hay garantías por escrito. Si en algún punto no cumplimos, lo ves de inmediato, no seis meses después.' },
  { q: '¿Qué pasa con mi sitio actual y el dominio?', a: 'El dominio es tuyo y así se queda. Tu sitio actual sigue en línea mientras construimos el nuevo, y el día del lanzamiento se hace el cambio. Sin días fuera del aire.' },
  { q: '¿Por qué no arrancamos con los anuncios de una vez?', a: 'Porque pagar anuncios para mandar gente a una página que no convence es tirar el dinero. Primero el vehículo; luego, con la investigación de palabras clave lista, la estrategia de anuncios en su propia propuesta.' },
  { q: 'Hay opciones más baratas. ¿Por qué invertir más?', a: 'Si lo que buscas es lo más barato, no somos la opción, y preferimos decirlo desde ahora. Una plantilla con tus datos cuesta menos porque no investiga a tu comprador, no escribe para sus miedos reales, no agenda citas ni te posiciona por zona. Nuestro trabajo es para negocios que ven su sitio como una inversión: un solo cliente cerrado suele pagarla.' },
  { q: '¿Cuánto cuesta?', a: 'La inversión se define por el alcance: número de páginas, sistema de agendado, páginas por zona e integraciones. Cada propuesta llega con el valor de cada entregable desglosado y un esquema de tres pagos ligados a entregas. Lo revisamos juntos en la sesión de diagnóstico.' },
  { q: '¿Cómo sé si el sitio está funcionando?', a: 'Con tu sitio recibes acceso a un panel de monitoreo durante un año: cuántas personas lo visitan, de dónde llegan (Google, anuncios, recomendados), cuántas se convierten en leads y cuántas en citas. Sin métricas de vanidad: lo que necesitas para decidir dónde invertir.' },
  { q: '¿Cómo se paga?', a: 'En tres pagos ligados a entregas que puedes ver y revisar: al firmar, al aprobar el diseño completo y contra entrega con el sitio funcionando. El esquema exacto va en tu propuesta.' },
  { q: '¿Trabajan con clientes fuera de México?', a: 'Sí. Tenemos clientes en México, LATAM y Estados Unidos, con sitios en español e inglés. Todo el proceso se lleva de forma remota.' },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Diseño Web',
    serviceType: 'Diseño y desarrollo de sitios web que convierten',
    provider: { '@id': `${site.url}/#organization` },
    areaServed: ['MX', 'US', 'Latin America'],
    url: `${site.url}/diseno-web/`,
    description,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map(({ q, a }) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
  },
];
---

<Base {title} {description} {jsonLd}>
  <!-- Hero -->
  <section class="bg-paper">
    <div class="container-x grid items-center gap-x-10 gap-y-10 pt-14 pb-12 sm:pt-24 sm:pb-16 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <p class="mb-4 text-sm font-medium text-muted">Diseño web estratégico</p>
        <h1 class="text-4xl font-semibold leading-[1.08] sm:text-5xl lg:text-[3.25rem]">Un sitio que convierte visitas en clientes agendados</h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-muted sm:text-xl">No es una página nueva por tener una página nueva. Es un puente entre lo que busca tu cliente y tu oferta: responde sus dudas, carga rápido y lleva a una sola acción.</p>
        <div class="mt-9 flex flex-col gap-3 sm:flex-row">
          <Button href={site.bookingUrl} size="lg" icon={false}>Agendar diagnóstico</Button>
          <Button href="#puente" variant="secondary" size="lg">Ver cómo funciona</Button>
        </div>
        <p class="mt-4 text-sm text-faint">Sesión de 30 minutos, sin costo. Te decimos con claridad si tiene sentido trabajar juntos.</p>
      </div>
      <div class="lg:col-span-7">
        <WebProcessScene />
        <dl class="reveal mt-4 grid grid-cols-3 gap-3">
          {promises.map(({ value, label }) => (
            <div class="card-surface px-4 py-3.5">
              <dd class="text-xl font-semibold tracking-tight text-text sm:text-2xl">{value}</dd>
              <dt class="mt-0.5 text-xs leading-snug text-muted sm:text-sm">{label}</dt>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <ClientsMarquee />

  <!-- 01 · El problema -->
  <section class="ink-glow py-20 text-white sm:py-28" aria-labelledby="problem-title">
    <div class="container-x">
      <SectionHeading id="problem-title" eyebrow="El problema" title="El trabajo ya lo haces bien. Falta que tu sitio lo demuestre." description="Casi todos los sitios hablan de la empresa: años de experiencia, lista de servicios, fotos genéricas. Y la persona que entra está pensando en otra cosa: si van a cumplir, si es seguro, por qué ellos y no el de al lado. Si el sitio no lo responde, se va con el competidor que sí lo hizo." tone="dark" />
      <ul class="mt-14 grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-4" role="list">
        {mistakes.map(({ kind, title, text }, i) => (
          <GraphicCard {title} description={text} eyebrow={`Error 0${i + 1}`} tone="dark">
            <MistakeScene kind={kind as any} />
          </GraphicCard>
        ))}
      </ul>
    </div>
  </section>

  <!-- 02 · El puente -->
  <section id="puente" class="py-20 sm:py-28" aria-labelledby="bridge-title">
    <div class="container-x">
      <SectionHeading id="bridge-title" eyebrow="La solución" title="Un puente sólido: no importa por dónde entre, el sitio lo lleva por un solo camino" description="Un solo destino para todo el sitio: que el visitante confíe y dé el paso. Cada página, cada texto y cada botón trabajan para eso." />

      <div class="reveal mt-14"><BridgeGraphic /></div>
    </div>
  </section>

  <!-- 03 · Construimos la oferta -->
  <section class="bg-paper-soft py-20 sm:py-28" aria-labelledby="offer-title">
    <div class="container-x grid gap-12 lg:grid-cols-12 lg:items-center">
      <div class="lg:col-span-5">
        <SectionHeading id="offer-title" eyebrow="Antes de diseñar" title="Primero construimos la oferta. Luego el sitio la comunica." description="Un sitio bonito sin oferta es un folleto. Por eso todo proyecto empieza con un estudio del negocio: a quién le vendes, qué desea, qué teme y qué necesita ver para decidirse." />
        <ul class="mt-8 space-y-3 text-muted" role="list">
          {['Perfil del comprador con sus miedos y objeciones reales', 'Qué prometer, en qué orden y con qué prueba', 'El camino del visitante: de la entrada al botón', 'Un plan de sitio que se aprueba antes de construir'].map((t) => (
            <li class="flex gap-3"><span class="mt-2.5 size-1.5 shrink-0 rounded-full bg-lime-deep" aria-hidden="true"></span>{t}</li>
          ))}
        </ul>
      </div>
      <div class="reveal lg:col-span-7">
        <div class="card overflow-hidden">
          <div class="flex items-center justify-between gap-4 bg-ink px-6 py-4 text-white">
            <span class="font-semibold">Perfil del comprador</span>
            <span class="text-xs text-white/50 sm:text-sm">Ejemplo real: compañía de techos en EE. UU.</span>
          </div>
          <dl class="divide-y divide-line">
            {profile.map(({ k, v, quote }) => (
              <div class="grid gap-2 px-6 py-4 sm:grid-cols-[11rem_1fr] sm:gap-6">
                <dt class="flex items-center gap-2.5 text-xs font-medium uppercase tracking-wide text-faint">
                  <span class="inline-flex size-7 shrink-0 items-center justify-center rounded-lg bg-paper-soft text-text ring-1 ring-line"><svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={profileIcons[k]} /></span>
                  {k}
                </dt>
                <dd class:list={['leading-relaxed', quote ? 'font-medium text-text' : 'text-muted']}>{v}</dd>
              </div>
            ))}
          </dl>
          <p class="border-t border-line bg-paper-soft px-6 py-4 text-sm text-muted">El sitio atiende a los dos visitantes: al que tiene un problema hoy le da velocidad y confianza inmediata; al que está comparando, prueba y razones. Y a ambos los lleva al mismo lugar.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 04 · Pilares -->
  <section class="py-20 sm:py-28" aria-labelledby="pillars-title">
    <div class="container-x">
      <SectionHeading id="pillars-title" eyebrow="Cómo lo construimos" title="Los cuatro pilares de un sitio que convierte" />
      <ul class="mt-12 grid gap-x-8 gap-y-12 md:grid-cols-2" role="list">
        {pillars.map(({ graphic: Graphic, title, description }) => (
          <GraphicCard {title} {description}><Graphic /></GraphicCard>
        ))}
      </ul>
    </div>
  </section>

  <!-- Después del lanzamiento: monitoreo -->
  <section class="bg-paper-soft py-20 sm:py-28" aria-labelledby="monitor-title">
    <div class="container-x grid gap-12 lg:grid-cols-12 lg:items-center">
      <div class="order-2 lg:order-1 lg:col-span-6">
        <div class="reveal group">
          <div class="gcard"><DashboardGraphic /><span class="gcard__sheen" aria-hidden="true"></span></div>
          <p class="mt-3 text-xs text-faint">Datos ilustrativos.</p>
        </div>
      </div>
      <div class="order-1 lg:order-2 lg:col-span-6">
        <SectionHeading id="monitor-title" eyebrow="Después del lanzamiento" title="Sabes qué pasa con tu sitio, todo el año" description="Un sitio que no se mide es una apuesta. Con tu proyecto recibes acceso a un panel de monitoreo durante un año: cuánta gente entra, de dónde llega y cuántos se convierten en leads y en citas." />
        <ul class="mt-8 grid gap-3 sm:grid-cols-2" role="list">
          {[
            ['Visitas y tráfico', 'Cuántas personas entran y desde qué canal: Google, anuncios, recomendados.'],
            ['Leads y citas', 'Cada contacto y cada cita agendada, en un solo lugar.'],
            ['Tendencia mes a mes', 'Ves si el sitio crece o si hay que ajustar algo.'],
            ['Decisiones con datos', 'Sabes dónde invertir el siguiente peso, sin adivinar.'],
          ].map(([t, d]) => (
            <li class="card p-5">
              <h3 class="font-semibold text-text">{t}</h3>
              <p class="mt-1 text-sm leading-relaxed text-muted">{d}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <Portfolio />
  <Results />
  <Testimonials />

  <!-- 06 · Cronograma -->
  <section class="py-20 sm:py-28" aria-labelledby="timeline-title">
    <div class="container-x">
      <SectionHeading id="timeline-title" eyebrow="Proceso" title="45 días, en 4 etapas. Cada pago, contra algo que puedes ver." />
      <!-- Barra de tiempo: cada tramo mide sus días; las monedas marcan los pagos -->
      <div class="reveal mt-20 hidden lg:block" aria-hidden="true">
        <p class="mb-14 text-sm text-muted">Los pagos se liberan contra entregas: el primero al arrancar, el segundo al aprobar el diseño, el tercero con el sitio funcionando.</p>
        <div class="flex items-center gap-1.5">
          {[10, 10, 15, 10].map((d, i) => (
            <div class="relative" style={`flex:${d}`}>
              <div class:list={['h-3 rounded-full', i === 3 ? 'bg-lime' : 'bg-ink/10']}></div>
              <span class="absolute left-0 top-5 text-xs text-faint">día {[1, 11, 21, 36][i]}</span>
              {[true, true, false, true][i] && (
                <span class:list={['absolute -top-12 flex size-10 items-center justify-center rounded-full bg-ink text-[0.6rem] font-semibold text-white ring-4 ring-paper', i === 3 ? 'right-0' : 'left-0']}>{[40, 30, 0, 30][i]}%</span>
              )}
            </div>
          ))}
        </div>
      </div>
      <ol class="mt-14 grid gap-5 md:grid-cols-2 lg:grid-cols-4" role="list">
        {stages.map(({ days, title, items, pay }) => (
          <li class="reveal card-surface flex flex-col p-6 sm:p-7">
            <span class="text-sm font-medium text-lime-deep">{days}</span>
            <h3 class="mt-2 text-xl font-semibold text-text">{title}</h3>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-muted">{items[items.length - 1]}</p>
            {pay && <span class="mt-5 inline-flex w-fit items-center rounded-full border border-line-strong bg-paper px-3 py-1 text-xs font-medium text-text">{pay}</span>}
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 05 · Lo que recibes -->
  <section class="ink-glow py-20 text-white sm:py-28" aria-labelledby="deliverables-title">
    <div class="container-x">
      <SectionHeading id="deliverables-title" eyebrow="Lo que recibes" title="Todo lo que incluye un proyecto" description="Cada entregable llega en tu propuesta con su valor desglosado. Sabes exactamente en qué inviertes, y el proyecto no crece sin control." tone="dark" />
      <div class="mt-12 grid gap-8 lg:grid-cols-12">
        <ul class="card-ink divide-y divide-white/[0.07] lg:col-span-7" role="list">
          {deliverables.map((d) => (
            <li class="flex items-start gap-3 px-6 py-3.5">
              <svg class="mt-1 size-4 shrink-0 text-lime" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 5 5L20 7" /></svg>
              <span class="text-white/85">{d}</span>
            </li>
          ))}
        </ul>
        <div class="lg:col-span-5">
          <p class="mb-3 text-sm font-medium text-white/50">Incluido en cada proyecto, sin costo adicional</p>
          <ul class="grid gap-3" role="list">
            {extras.map(({ title, text }) => (
              <li class="reveal card-ink p-5">
                <h3 class="font-semibold">{title}</h3>
                <p class="mt-1 text-sm leading-relaxed text-white/60">{text}</p>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 07 · Garantías y alcance -->
  <section class="bg-paper-soft py-20 sm:py-28" aria-labelledby="guarantees-title">
    <div class="container-x">
      <SectionHeading id="guarantees-title" eyebrow="Lo que protege a los dos" title="Garantías por escrito y un alcance claro" description="No te pedimos que confíes en palabras. Cada pago se libera contra algo que puedes revisar, y el alcance queda definido antes de empezar." />
      <ul class="mt-12 grid gap-4 lg:grid-cols-3" role="list">
        {guarantees.map(({ title, text }) => (
          <li class="reveal card p-6 sm:p-7">
            <span class="inline-flex size-9 items-center justify-center rounded-xl bg-lime text-ink" aria-hidden="true">
              <svg class="size-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 4 6v6c0 5 3.5 8 8 9 4.5-1 8-4 8-9V6l-8-3Z" /><path d="m9 12 2 2 4-4" /></svg>
            </span>
            <h3 class="mt-5 text-lg font-semibold text-text">{title}</h3>
            <p class="mt-2 leading-relaxed text-muted">{text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Para quién es -->
  <section class="py-20 sm:py-28" aria-labelledby="fit-title">
    <div class="container-x">
      <SectionHeading id="fit-title" eyebrow="Para quién es" title="No hacemos sitios baratos. Hacemos sitios que se pagan solos." description="Tomamos pocos proyectos al mes para cumplir cada fecha, así que preferimos ser claros desde el principio." />
      <div class="mt-12 grid gap-4 lg:grid-cols-2">
        <div class="reveal card p-6 sm:p-8">
          <h3 class="text-lg font-semibold text-text">Es para ti si…</h3>
          <ul class="mt-5 space-y-3" role="list">
            {fit.yes.map((t) => (
              <li class="flex gap-3 text-muted">
                <span class="mt-0.5 inline-flex size-5 shrink-0 items-center justify-center rounded-full bg-lime text-ink" aria-hidden="true"><svg class="size-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5L20 7" /></svg></span>
                {t}
              </li>
            ))}
          </ul>
        </div>
        <div class="reveal card-surface p-6 sm:p-8">
          <h3 class="text-lg font-semibold text-text">No es para ti si…</h3>
          <ul class="mt-5 space-y-3" role="list">
            {fit.no.map((t) => (
              <li class="flex gap-3 text-muted">
                <span class="mt-0.5 inline-flex size-5 shrink-0 items-center justify-center rounded-full bg-ink text-white" aria-hidden="true"><svg class="size-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18" /></svg></span>
                {t}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <Faq items={faqs} title="Preguntas que seguro tienes" />

  <!-- Siguiente paso -->
  <section class="ink-glow py-24 text-white sm:py-32" aria-labelledby="next-title">
    <div class="container-x">
      <div class="max-w-3xl">
        <p class="text-xl font-medium leading-snug text-white/70 sm:text-2xl">“Una página web es solo una herramienta. Con estrategia detrás, se convierte en la máquina que llena tu calendario.”</p>
        <p class="mt-10 text-sm font-medium text-white/50">Siguiente paso</p>
        <h2 id="next-title" class="mt-3 text-4xl font-semibold leading-[1.08] sm:text-5xl">¿Listo para arrancar?</h2>
        <ol class="mt-8 space-y-4" role="list">
          {nextSteps.map((s, i) => (
            <li class="flex items-center gap-4">
              <span class="inline-flex size-9 shrink-0 items-center justify-center rounded-full border border-white/20 text-sm font-semibold">{i + 1}</span>
              <span class="text-lg text-white/85">{s}</span>
            </li>
          ))}
        </ol>
        <div class="mt-10 flex flex-col gap-3 sm:flex-row">
          <Button href={site.bookingUrl} variant="inverse" size="lg" icon={false}>Agendar la revisión de 30 minutos</Button>
          <Button href="/portafolio/" variant="ghost" size="lg" class="text-white/70 hover:text-white">Ver portafolio</Button>
        </div>
      </div>
    </div>
  </section>
</Base>
