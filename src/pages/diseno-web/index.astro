---
import Base from '../../layouts/Base.astro';
import Button from '../../components/ui/Button.astro';
import WebProcessScene from '../../components/sections/WebProcessScene.astro';
import GraphicCard from '../../components/ui/GraphicCard.astro';
import SitemapGraphic from '../../components/graphics/SitemapGraphic.astro';
import SeoGraphic from '../../components/graphics/SeoGraphic.astro';
import EditorGraphic from '../../components/graphics/EditorGraphic.astro';
import BookingGraphic from '../../components/graphics/BookingGraphic.astro';
import BridgeScene from '../../components/graphics/BridgeScene.astro';
import DashboardGraphic from '../../components/graphics/DashboardGraphic.astro';
import MistakeScene from '../../components/graphics/MistakeScene.astro';
import Faq from '../../components/ui/Faq.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import Portfolio from '../../components/sections/Portfolio.astro';
import ClientsMarquee from '../../components/sections/ClientsMarquee.astro';
import Results from '../../components/sections/Results.astro';
import Testimonials from '../../components/sections/Testimonials.astro';
import { site } from '../../data/site';

const title = 'Diseño Web que convierte | Sitios que agendan clientes | Neopoint';
const description =
  'Sitios web que convierten visitas en clientes. Responden las dudas de tu cliente, cargan rápido y llevan a una sola acción. Tu MVP en línea en 10 días y garantías por escrito.';

/* Cifras del método (aplican a todo proyecto) */
const promises = [
  { value: '10 días', label: 'y tu MVP ya está en línea' },
  { value: '1 año', label: 'de panel para ver tus leads' },
  { value: '90+', label: 'de calificación en Google' },
];

/* 01 · Lo que espanta a los clientes */
const mistakes = [
  { kind: 'company', title: 'Habla de la empresa, no del cliente', text: 'Años de experiencia y lista de servicios. Tu cliente entró preguntando otra cosa.' },
  { kind: 'fear', title: 'No responde su miedo', text: '“¿Y si pago y no cumplen?” Si el sitio no contesta, se va con otro.' },
  { kind: 'proof', title: 'No hay pruebas', text: 'Sin fotos reales ni reseñas, nadie contrata. La confianza lo es todo.' },
  { kind: 'button', title: 'Botón escondido y página lenta', text: 'Menús largos y segundos de espera. Desde el celular, la gente se rinde.' },
];

/* Lo que ya intentaste */
const attempts = [
  { title: 'La agencia que hace de todo', what: 'Redes, logos, videos y páginas.', happened: 'Te entregó una página bonita que habla de tu empresa. No vende, porque eso no es lo suyo.', missing: 'Un método con un solo fin: que el sitio venda.' },
  { title: 'El freelancer', what: 'Buen precio y buena voluntad.', happened: 'Sin proceso ni garantías. Se alarga o desaparece, y te deja un sitio a medias.', missing: 'Fechas, avances que puedes ver y alguien que responda.' },
  { title: 'Hacerla tú en Wix o WordPress', what: 'Una plantilla con tus datos.', happened: 'Semanas de tu tiempo, carga lenta y textos que no convencen.', missing: 'Saber qué decirle a tu cliente. Eso no viene en la plantilla.' },
];

/* 03 · Perfil del comprador (ejemplo real, resumido) */
const profileIcons: Record<string, string> = {
  'Lo que desea': '<path d="M12 21s-7-4.6-9.3-8.6C.8 9 3 5 6.8 5c2 0 3.4 1 4.2 2.3C11.8 6 13.2 5 15.2 5 19 5 21.2 9 19.3 12.4 17 16.4 12 21 12 21Z"/>',
  'Su miedo principal': '<path d="M12 3 2 20h20L12 3Z"/><path d="M12 10v4M12 17h.01"/>',
  'Necesita ver': '<path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/>',
};
const profile = [
  { k: 'Lo que desea', v: 'Un techo que aguante el invierno, hecho por alguien que sí llega y cobra lo que dijo.' },
  { k: 'Su miedo principal', v: '“¿Y si les doy el anticipo y no vuelven?”', quote: true },
  { k: 'Necesita ver', v: 'Licencia, fotos de trabajos en su zona, reseñas de vecinos y una inspección fácil de agendar.' },
];

/* 04 · Los 4 pilares */
const pillars = [
  { graphic: SitemapGraphic, title: 'Estructura que vende', description: 'Cada sección hace un trabajo: quitar una duda, dar confianza o llevar al botón.' },
  { graphic: EditorGraphic, title: 'Diseño y textos a tu medida', description: 'Nada de plantillas. Textos que hablan de lo que a tu cliente le importa, con pruebas a la vista.' },
  { graphic: BookingGraphic, title: 'Sistema para agendar', description: 'Formulario corto o calendario. Te avisa al celular y guarda cada contacto.' },
  { graphic: SeoGraphic, title: 'Que te encuentren en Google', description: 'Sitio listo para Google, conectado a tu perfil de negocio y con páginas por zona.' },
];

/* 05 · Lo que recibes */
const deliverables = [
  'Estudio de tu negocio y plan para que el sitio venda',
  'Tu MVP en 10 días: página de inicio y botón para agendar, en línea',
  'Todos los textos, escritos para tu cliente',
  'Diseño a la medida para celular y computadora',
  'Sistema para agendar: formulario y calendario',
  'Aviso de cada solicitud y lista de contactos',
  'Páginas de servicio que llevan al botón',
  'Páginas por ciudad o zona',
  'Sitio listo para aparecer en Google',
  'Carga rápida, siempre',
  'Panel de monitoreo por un año: visitas, leads y citas',
];
/* Incluido en cada proyecto, sin costo adicional */
const extras = [
  { title: 'Sesión de arranque y plan', text: 'Qué pones tú, qué ponemos nosotros y las fechas.' },
  { title: 'Ajuste de logo', text: 'Para que se vea nítido en el sitio y en Google.' },
  { title: 'Guía de fotos', text: 'Cómo fotografiar tus trabajos con el celular.' },
  { title: 'Soporte directo 30 días', text: 'Línea directa por WhatsApp después del lanzamiento.' },
];

/* Cómo trabajamos: tres momentos, sin mecánica de venta */
const moments = [
  { n: '10 días', title: 'Tu MVP en línea', text: 'Página de inicio y botón para agendar, publicados. Tu primer win antes de dos semanas.', win: true },
  { n: 'Apruebas', title: 'Antes de construir', text: 'Ves el diseño completo y los textos. Nada se construye sin tu visto bueno.' },
  { n: '1 año', title: 'Lanzamos y medimos', text: 'Publicamos, lo conectamos con Google y ves tus leads en el panel todo el año.' },
];

/* 07 · Garantías y alcance */
const guarantees = [
  { title: 'Tu MVP en 10 días', text: 'A los 10 días hábiles tu primera versión está en línea: inicio y botón para agendar. Si no llega, lo sabes de inmediato.' },
  { title: 'Garantía de satisfacción', text: 'Trabajamos contigo hasta que apruebes el diseño. No entregamos hasta que estés conforme.' },
  { title: 'Garantía de rendimiento', text: 'Tu sitio sale con 90 o más en las pruebas de Google: velocidad, buscadores y uso.' },
];

/* Para quién es */
const fit = {
  yes: [
    'Vendes un servicio donde la confianza decide',
    'Ves tu sitio como una inversión, no como un gasto',
    'Quieres ver avances y tener garantías por escrito',
  ],
  no: [
    'Buscas lo más barato o una plantilla con tus datos',
    'Esperas estar primero en Google en 30 días',
    'Quieres una página solo por tener una',
  ],
};

/* Siguiente paso */
const nextSteps = [
  'Hablamos 30 minutos por videollamada sobre tu negocio',
  'Recibes una propuesta clara con todo lo que incluye',
  'Firmamos y arrancamos en 48 horas',
];

const faqs = [
  { q: 'Ya nos quedó mal una agencia. ¿En qué son diferentes?', a: 'No te pedimos confianza en palabras. Tu MVP está en línea en 10 días, ves cada avance antes de seguir y hay garantías por escrito.' },
  { q: '¿Qué pasa con mi sitio actual y el dominio?', a: 'El dominio es tuyo y así se queda. Tu sitio actual sigue en línea hasta el día del cambio. Sin días fuera del aire.' },
  { q: '¿Por qué no empezamos con anuncios?', a: 'Porque mandar gente a una página que no convence es tirar el dinero. Primero el sitio; luego los anuncios, en su propia propuesta.' },
  { q: 'Hay opciones más baratas. ¿Por qué invertir más?', a: 'Si buscas lo más barato, no somos la opción. Una plantilla no estudia a tu cliente ni escribe para él. Nuestro trabajo es una inversión: un solo cliente cerrado suele pagarla.' },
  { q: '¿Cuánto cuesta?', a: 'Depende del alcance. En el diagnóstico lo vemos juntos y recibes una propuesta clara con todo lo que incluye.' },
  { q: '¿Cómo sé si el sitio funciona?', a: 'Con un panel de monitoreo por un año. Ves cuánta gente entra, de dónde llega y cuántos se vuelven leads y citas.' },
  { q: '¿Trabajan fuera de México?', a: 'Sí. Tenemos clientes en México, LATAM y Estados Unidos, en español e inglés. Todo es remoto.' },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Diseño Web',
    serviceType: 'Diseño y desarrollo de sitios web que convierten',
    provider: { '@id': `${site.url}/#organization` },
    areaServed: ['MX', 'US', 'Latin America'],
    url: `${site.url}/diseno-web/`,
    description,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map(({ q, a }) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
  },
];
---

<Base {title} {description} {jsonLd}>
  <!-- Hero: pantalla completa, contenido centrado -->
  <section class="relative flex min-h-svh flex-col justify-center bg-paper !pt-16">
    <div class="container-x grid items-center gap-x-12 gap-y-10 py-10 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <p class="mb-5 inline-flex items-center gap-2 rounded-full border border-line bg-surface px-3 py-1 text-xs font-medium text-muted">
          <span class="size-1.5 rounded-full bg-lime-deep" aria-hidden="true"></span>Diseño web estratégico
        </p>
        <h1 class="text-4xl font-semibold leading-[1.06] tracking-[-0.025em] sm:text-5xl lg:text-[3.15rem] xl:text-[3.5rem]">Un sitio que convierte visitas en clientes</h1>
        <p class="mt-6 max-w-lg text-lg leading-relaxed text-muted">Sabemos cuál es el miedo: pagar por una web bonita que no trae clientes. Por eso hacemos sitios que responden dudas, cargan rápido y llevan a una sola acción.</p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <Button href={site.bookingUrl} size="lg" icon={false}>Agendar diagnóstico</Button>
          <Button href="#puente" variant="secondary" size="lg">Ver cómo funciona</Button>
        </div>
        <p class="mt-4 text-sm text-faint">30 minutos, sin costo. Te decimos si tiene sentido trabajar juntos.</p>
      </div>
      <div class="lg:col-span-7">
        <WebProcessScene />
        <dl class="mt-4 grid grid-cols-3 gap-3">
          {promises.map(({ value, label }) => (
            <div class="rounded-card border border-line bg-paper px-4 py-3.5">
              <dd class="text-xl font-semibold tracking-tight text-text sm:text-2xl">{value}</dd>
              <dt class="mt-0.5 text-xs leading-snug text-muted sm:text-sm">{label}</dt>
            </div>
          ))}
        </dl>
      </div>
    </div>
    <a href="#clientes" class="absolute bottom-5 left-1/2 hidden -translate-x-1/2 items-center gap-2 text-xs font-medium text-faint transition-colors hover:text-text lg:inline-flex" aria-label="Bajar al contenido">
      Desliza
      <svg class="size-3.5 animate-bounce" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M6 13l6 6 6-6" /></svg>
    </a>
  </section>

  <div id="clientes"><ClientsMarquee /></div>

  <!-- 01 · El problema -->
  <section class="ink-glow py-20 text-white sm:py-28" aria-labelledby="problem-title">
    <div class="container-x">
      <SectionHeading id="problem-title" eyebrow="El problema" title="Equivocarse con una web sale caro. Y casi todas se equivocan igual." description="Tu trabajo ya es bueno. Falta que el sitio lo demuestre. Casi todos hablan de la empresa, y el cliente entra preguntando si van a cumplir. Si el sitio no responde, se va con otro." tone="dark" />
      <ul class="mt-14 grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-4" role="list">
        {mistakes.map(({ kind, title, text }, i) => (
          <GraphicCard {title} description={text} eyebrow={`Error 0${i + 1}`} tone="dark">
            <MistakeScene kind={kind as any} />
          </GraphicCard>
        ))}
      </ul>
    </div>
  </section>

  <!-- Lo que ya intentaste -->
  <section class="py-20 sm:py-28" aria-labelledby="attempts-title">
    <div class="container-x">
      <SectionHeading id="attempts-title" eyebrow="Lo que ya intentaste" title="Si ya probaste y no funcionó, no es tu culpa" description="Casi todos nuestros clientes pasaron por uno de estos caminos. El problema no fue la persona ni la herramienta. Nadie pensó en tu cliente antes de diseñar." />
      <ul class="mt-12 grid gap-4 lg:grid-cols-3" role="list">
        {attempts.map(({ title, what, happened, missing }) => (
          <li class="reveal card flex flex-col p-6 sm:p-7">
            <h3 class="text-lg font-semibold text-text">{title}</h3>
            <p class="mt-1 text-sm text-faint">{what}</p>
            <div class="mt-5 flex gap-3">
              <span class="mt-0.5 inline-flex size-5 shrink-0 items-center justify-center rounded-full bg-surface text-muted ring-1 ring-line" aria-hidden="true"><svg class="size-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18" /></svg></span>
              <p class="text-muted">{happened}</p>
            </div>
            <div class="mt-4 flex gap-3">
              <span class="mt-0.5 inline-flex size-5 shrink-0 items-center justify-center rounded-full bg-lime text-ink" aria-hidden="true"><svg class="size-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h16M14 6l6 6-6 6" /></svg></span>
              <p class="text-muted">{missing}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 02 · El puente -->
  <section id="puente" class="bg-paper-soft py-20 sm:py-28" aria-labelledby="bridge-title">
    <div class="container-x">
      <SectionHeading id="bridge-title" eyebrow="La solución" title="El sitio es un puente: entre por donde entre, llega al mismo lugar" description="Cada página, cada texto y cada botón tienen un solo fin: que el visitante confíe y agende." />

      <div class="reveal mt-14"><BridgeScene /></div>
    </div>
  </section>

  <!-- 03 · Construimos la oferta -->
  <section class="bg-paper-soft py-20 sm:py-28" aria-labelledby="offer-title">
    <div class="container-x grid gap-12 lg:grid-cols-12 lg:items-center">
      <div class="lg:col-span-5">
        <SectionHeading id="offer-title" eyebrow="Antes de diseñar" title="Primero la oferta. Luego el sitio." description="Un sitio bonito sin oferta es un folleto. Por eso empezamos por tu cliente: qué quiere, qué teme y qué necesita ver para decidirse." />
        <ul class="mt-8 space-y-3 text-muted" role="list">
          {['Perfil de tu cliente: miedos y dudas reales', 'Qué prometer y con qué prueba', 'Un plan que apruebas antes de construir'].map((t) => (
            <li class="flex gap-3"><span class="mt-2.5 size-1.5 shrink-0 rounded-full bg-lime-deep" aria-hidden="true"></span>{t}</li>
          ))}
        </ul>
      </div>
      <div class="reveal lg:col-span-7">
        <div class="card overflow-hidden">
          <div class="flex items-center justify-between gap-4 bg-ink px-6 py-4 text-white">
            <span class="font-semibold">Perfil del comprador</span>
            <span class="text-xs text-white/50 sm:text-sm">Ejemplo real: compañía de techos en EE. UU.</span>
          </div>
          <dl class="divide-y divide-line">
            {profile.map(({ k, v, quote }) => (
              <div class="grid gap-2 px-6 py-4 sm:grid-cols-[11rem_1fr] sm:gap-6">
                <dt class="flex items-center gap-2.5 text-xs font-medium uppercase tracking-wide text-faint">
                  <span class="inline-flex size-7 shrink-0 items-center justify-center rounded-lg bg-paper-soft text-text ring-1 ring-line"><svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={profileIcons[k]} /></span>
                  {k}
                </dt>
                <dd class:list={['leading-relaxed', quote ? 'font-medium text-text' : 'text-muted']}>{v}</dd>
              </div>
            ))}
          </dl>
        </div>
      </div>
    </div>
  </section>

  <!-- 04 · Pilares -->
  <section class="ink-glow py-20 text-white sm:py-28" aria-labelledby="pillars-title">
    <div class="container-x">
      <SectionHeading id="pillars-title" eyebrow="Cómo lo construimos" title="Cuatro cosas que hacen que un sitio venda" tone="dark" />
      <ul class="mt-12 grid gap-x-8 gap-y-12 md:grid-cols-2" role="list">
        {pillars.map(({ graphic: Graphic, title, description }) => (
          <GraphicCard {title} {description} tone="dark"><Graphic /></GraphicCard>
        ))}
      </ul>
    </div>
  </section>

  <!-- Después del lanzamiento: monitoreo -->
  <section class="bg-paper-soft py-20 sm:py-28" aria-labelledby="monitor-title">
    <div class="container-x grid gap-12 lg:grid-cols-12 lg:items-center">
      <div class="order-2 lg:order-1 lg:col-span-6">
        <div class="reveal group">
          <div class="relative aspect-[3/2] overflow-hidden rounded-card bg-paper-soft [container-type:inline-size]"><DashboardGraphic /></div>
          <p class="mt-3 text-xs text-faint">Datos ilustrativos.</p>
        </div>
      </div>
      <div class="order-1 lg:order-2 lg:col-span-6">
        <SectionHeading id="monitor-title" eyebrow="Después del lanzamiento" title="Sabes qué pasa con tu sitio, todo el año" description="Un sitio que no se mide es una apuesta. Por eso recibes un panel por un año: cuánta gente entra, de dónde llega y cuántos agendan." />
        <ul class="mt-8 grid gap-3 sm:grid-cols-2" role="list">
          {[
            ['Visitas', 'Cuánta gente entra y de dónde: Google, anuncios o recomendados.'],
            ['Leads y citas', 'Cada contacto y cada cita, en un solo lugar.'],
            ['Mes a mes', 'Ves si el sitio crece o si hay que ajustar.'],
            ['Decisiones con datos', 'Sabes dónde poner el siguiente peso.'],
          ].map(([t, d]) => (
            <li class="card p-5">
              <h3 class="font-semibold text-text">{t}</h3>
              <p class="mt-1 text-sm leading-relaxed text-muted">{d}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <Portfolio />
  <Results />
  <Testimonials />

  <!-- Cómo trabajamos -->
  <section class="py-20 sm:py-28" aria-labelledby="how-title">
    <div class="container-x">
      <SectionHeading id="how-title" eyebrow="Cómo trabajamos" title="Ves resultados antes de avanzar" description="Sabemos que es difícil saber qué poner en la web para que venda. De eso nos encargamos nosotros. Tú revisas y apruebas." />
      <ol class="mt-12 grid gap-4 lg:grid-cols-3" role="list">
        {moments.map(({ n, title, text, win }) => (
          <li class:list={['reveal flex flex-col p-6 sm:p-7', win ? 'card ring-2 ring-lime' : 'card-surface']}>
            <span class="text-2xl font-semibold tracking-tight text-text">{n}</span>
            <h3 class="mt-1 text-lg font-semibold text-text">{title}</h3>
            <p class="mt-2 leading-relaxed text-muted">{text}</p>
            {win && <span class="mt-4 inline-flex w-fit items-center rounded-full bg-lime px-3 py-1 text-xs font-semibold text-ink">Primer win</span>}
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 05 · Lo que recibes -->
  <section class="ink-glow py-20 text-white sm:py-28" aria-labelledby="deliverables-title">
    <div class="container-x">
      <SectionHeading id="deliverables-title" eyebrow="Lo que recibes" title="Todo lo que incluye un proyecto" description="Sabes exactamente qué recibes. Nada queda a la interpretación." tone="dark" />
      <div class="mt-12 grid gap-8 lg:grid-cols-12">
        <ul class="card-ink divide-y divide-white/[0.07] lg:col-span-7" role="list">
          {deliverables.map((d) => (
            <li class="flex items-start gap-3 px-6 py-3.5">
              <svg class="mt-1 size-4 shrink-0 text-lime" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 5 5L20 7" /></svg>
              <span class="text-white/85">{d}</span>
            </li>
          ))}
        </ul>
        <div class="lg:col-span-5">
          <p class="mb-3 text-sm font-medium text-white/50">Incluido en cada proyecto, sin costo adicional</p>
          <ul class="grid gap-3" role="list">
            {extras.map(({ title, text }) => (
              <li class="reveal card-ink p-5">
                <h3 class="font-semibold">{title}</h3>
                <p class="mt-1 text-sm leading-relaxed text-white/60">{text}</p>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 07 · Garantías y alcance -->
  <section class="bg-paper-soft py-20 sm:py-28" aria-labelledby="guarantees-title">
    <div class="container-x">
      <SectionHeading id="guarantees-title" eyebrow="Lo que protege a los dos" title="Garantías por escrito, para que esta vez no te equivoques" description="No te pedimos confianza en palabras. Ves cada avance antes de seguir, y todo queda claro antes de empezar." />
      <ul class="mt-12 grid gap-4 lg:grid-cols-3" role="list">
        {guarantees.map(({ title, text }) => (
          <li class="reveal card p-6 sm:p-7">
            <span class="inline-flex size-9 items-center justify-center rounded-xl bg-lime text-ink" aria-hidden="true">
              <svg class="size-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 4 6v6c0 5 3.5 8 8 9 4.5-1 8-4 8-9V6l-8-3Z" /><path d="m9 12 2 2 4-4" /></svg>
            </span>
            <h3 class="mt-5 text-lg font-semibold text-text">{title}</h3>
            <p class="mt-2 leading-relaxed text-muted">{text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Para quién es -->
  <section class="py-20 sm:py-28" aria-labelledby="fit-title">
    <div class="container-x">
      <SectionHeading id="fit-title" eyebrow="Para quién es" title="No hacemos sitios baratos. Hacemos sitios que se pagan solos." />
      <div class="mt-12 grid gap-4 lg:grid-cols-2">
        <div class="reveal card p-6 sm:p-8">
          <h3 class="text-lg font-semibold text-text">Es para ti si…</h3>
          <ul class="mt-5 space-y-3" role="list">
            {fit.yes.map((t) => (
              <li class="flex gap-3 text-muted">
                <span class="mt-0.5 inline-flex size-5 shrink-0 items-center justify-center rounded-full bg-lime text-ink" aria-hidden="true"><svg class="size-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5L20 7" /></svg></span>
                {t}
              </li>
            ))}
          </ul>
        </div>
        <div class="reveal card-surface p-6 sm:p-8">
          <h3 class="text-lg font-semibold text-text">No es para ti si…</h3>
          <ul class="mt-5 space-y-3" role="list">
            {fit.no.map((t) => (
              <li class="flex gap-3 text-muted">
                <span class="mt-0.5 inline-flex size-5 shrink-0 items-center justify-center rounded-full bg-ink text-white" aria-hidden="true"><svg class="size-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18" /></svg></span>
                {t}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <Faq items={faqs} title="Preguntas que seguro tienes" />

  <!-- Siguiente paso -->
  <section class="ink-glow py-24 text-white sm:py-32" aria-labelledby="next-title">
    <div class="container-x">
      <div class="max-w-3xl">
        <p class="text-xl font-medium leading-snug text-white/70 sm:text-2xl">“Una página web es solo una herramienta. Con estrategia, llena tu calendario.”</p>
        <p class="mt-10 text-sm font-medium text-white/50">Siguiente paso</p>
        <h2 id="next-title" class="mt-3 text-4xl font-semibold leading-[1.08] sm:text-5xl">¿Listo para arrancar?</h2>
        <ol class="mt-8 space-y-4" role="list">
          {nextSteps.map((s, i) => (
            <li class="flex items-center gap-4">
              <span class="inline-flex size-9 shrink-0 items-center justify-center rounded-full border border-white/20 text-sm font-semibold">{i + 1}</span>
              <span class="text-lg text-white/85">{s}</span>
            </li>
          ))}
        </ol>
        <div class="mt-10 flex flex-col gap-3 sm:flex-row">
          <Button href={site.bookingUrl} variant="inverse" size="lg" icon={false}>Agendar la revisión de 30 minutos</Button>
          <Button href="/portafolio/" variant="ghost" size="lg" class="text-white/70 hover:text-white">Ver portafolio</Button>
        </div>
      </div>
    </div>
  </section>
</Base>
