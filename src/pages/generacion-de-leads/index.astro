---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/ui/PageHero.astro';
import Button from '../../components/ui/Button.astro';
import Faq from '../../components/ui/Faq.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import ProjectCard from '../../components/ui/ProjectCard.astro';
import GraphicCard from '../../components/ui/GraphicCard.astro';
import AdGraphic from '../../components/graphics/AdGraphic.astro';
import FunnelGraphic from '../../components/graphics/FunnelGraphic.astro';
import ChatGraphic from '../../components/graphics/ChatGraphic.astro';
import ClientsMarquee from '../../components/sections/ClientsMarquee.astro';
import Results from '../../components/sections/Results.astro';
import Testimonials from '../../components/sections/Testimonials.astro';
import FinalCta from '../../components/sections/FinalCta.astro';
import { icons } from '../../lib/icons';
import { getProjects } from '../../lib/portfolio';
import { site } from '../../data/site';

const funnels = (await getProjects()).filter((p) => p.data.category === 'funnel');

const title = 'Generación de Leads en México | Lead Gen Agency | Neopoint';
const description =
  'Campañas en Meta y Google con embudos que filtran y califican. A ti solo llegan los que sí quieren comprar. Sector inmobiliario, solar y tech.';

const steps = [
  { lead: '01 · Primero', title: 'Un anuncio que habla claro', text: 'Le decimos a tu cliente lo que quiere oír: qué vendes, para quién y por qué tú.', graphic: AdGraphic },
  { lead: '02 · Después', title: 'Un embudo que filtra', text: 'Califica antes de que lleguen a ti. Fuera curiosos y preguntones.', graphic: FunnelGraphic },
  { lead: '03 · Al final', title: 'Seguimiento hasta la cita', text: 'Conversación y recordatorios para que el lead se vuelva cita, y la cita venta.', graphic: ChatGraphic },
];

const sectors = [
  { icon: icons.building, title: 'Sector inmobiliario', items: ['Desarrolladores inmobiliarios', 'Arquitectura', 'Venta de preventa'] },
  { icon: icons.sun, title: 'Sector solar', items: ['Paneles solares residenciales', 'Proyectos comerciales', 'Financiamiento'] },
  { icon: icons.chip, title: 'Sector tech', items: ['Software y SaaS', 'Servicios digitales', 'Demos y agendas'] },
];

const faqs = [
  { q: '¿En qué plataformas hacen las campañas?', a: 'Meta (Facebook e Instagram) y Google. Elegimos según tu sector y dónde está tu cliente.' },
  { q: '¿Qué es un lead calificado?', a: 'Un contacto que cumple lo que definimos contigo: zona, presupuesto y tiempo de compra. El embudo filtra antes de que llegue a ti.' },
  { q: '¿Cuánto debo invertir en anuncios?', a: 'Depende del objetivo y el sector. Te proponemos un rango en el diagnóstico. La pauta se paga a las plataformas y siempre es tuya.' },
  { q: '¿Cómo mido los resultados?', a: 'Leads, costo por lead, citas y, si conectamos tu CRM, ventas. Sin métricas de vanidad.' },
  { q: '¿Cuánto tarda en verse resultado?', a: 'Las primeras semanas son de aprendizaje. Los resultados suelen estabilizarse entre el primer y el segundo mes.' },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Generación de Leads',
    serviceType: 'Adquisición de clientes potenciales',
    provider: { '@id': `${site.url}/#organization` },
    areaServed: ['MX', 'US', 'Latin America'],
    url: `${site.url}/generacion-de-leads/`,
    description,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map(({ q, a }) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
  },
];
---

<Base {title} {description} {jsonLd}>
  <PageHero eyebrow="Generación de leads" title="Anuncios que traen clientes, no curiosos" description="Sabemos cuál es el miedo: pagar publicidad y recibir preguntones. Por eso filtramos antes de que lleguen a ti.">
    <div class="mt-9 flex flex-col gap-3 sm:flex-row">
      <Button href={site.bookingUrl} size="lg" icon={false}>Agendar diagnóstico</Button>
      <Button href="#metodo" variant="secondary" size="lg">Ver cómo funciona</Button>
    </div>
  </PageHero>

  <ClientsMarquee />

  <section id="metodo" class="ink-glow py-20 text-white sm:py-28" aria-labelledby="method-title">
    <div class="container-x">
      <SectionHeading id="method-title" eyebrow="Método" title="Tres pasos entre el anuncio y la venta" tone="dark" />
      <ol class="mt-14 grid gap-x-6 gap-y-12 md:grid-cols-2 lg:grid-cols-3" role="list">
        {steps.map(({ lead, title, text, graphic: Graphic }) => (
          <GraphicCard {title} description={text} eyebrow={lead} tone="dark">
            <Graphic />
          </GraphicCard>
        ))}
      </ol>
    </div>
  </section>

  <section class="py-20 sm:py-28" aria-labelledby="sectors-title">
    <div class="container-x">
      <SectionHeading id="sectors-title" eyebrow="Sectores" title="Sectores donde ya sabemos qué funciona" description="Conocemos cómo compra la gente en estos sectores y armamos el embudo a su medida." />
      <ul class="mt-12 grid gap-5 lg:grid-cols-3" role="list">
        {sectors.map(({ icon, title, items }) => (
          <li class="reveal card-surface p-7">
            <span class="inline-flex size-10 items-center justify-center rounded-xl border border-line bg-paper text-text">
              <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icon} />
            </span>
            <h3 class="mt-5 text-xl font-semibold text-text">{title}</h3>
            <ul class="mt-4 space-y-2 text-muted">
              {items.map((it) => (
                <li class="flex items-center gap-2"><span class="size-1 rounded-full bg-faint" aria-hidden="true"></span>{it}</li>
              ))}
            </ul>
          </li>
        ))}
      </ul>
      <div class="mt-10 flex justify-center"><Button href={site.bookingUrl} icon={false}>Agendar diagnóstico</Button></div>
    </div>
  </section>

  {funnels.length > 0 && (
    <section class="bg-paper-soft py-20 sm:py-28" aria-labelledby="cases-title">
      <div class="container-x grid gap-10 lg:grid-cols-12 lg:items-center">
        <div class="lg:col-span-5">
          <SectionHeading id="cases-title" eyebrow="Caso de éxito" title="Un funnel que llena la agenda" description="Preventa inmobiliaria: prospectos calificados, listos para dar el siguiente paso." align="left" />
          <div class="mt-8"><Button href="/portafolio/" variant="secondary">Ver portafolio completo</Button></div>
        </div>
        <ul class="grid gap-6 lg:col-span-7" role="list">
          {funnels.map((p) => <li class="reveal"><ProjectCard project={p} /></li>)}
        </ul>
      </div>
    </section>
  )}

  <Results />
  <Testimonials />
  <Faq items={faqs} title="Preguntas frecuentes sobre generación de leads" />
  <FinalCta />
</Base>
