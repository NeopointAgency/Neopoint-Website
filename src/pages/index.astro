---
import Base from '../layouts/Base.astro';
import HomeHero from '../components/sections/HomeHero.astro';
import ClientsMarquee from '../components/sections/ClientsMarquee.astro';
import Services from '../components/sections/Services.astro';
import HowWeWork from '../components/sections/HowWeWork.astro';
import Portfolio from '../components/sections/Portfolio.astro';
import Results from '../components/sections/Results.astro';
import Testimonials from '../components/sections/Testimonials.astro';
import FinalCta from '../components/sections/FinalCta.astro';
import { site } from '../data/site';
import { services } from '../data/home';

const title = 'Neopoint | Diseño Web y Generación de Leads en México';
const description =
  'Sitios web que venden y campañas que llenan tu agenda. Marketing que trae clientes, no likes. Más de 60 negocios y 20 mil clientes potenciales generados.';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ProfessionalService',
    '@id': `${site.url}/#service`,
    name: site.name,
    url: site.url,
    description,
    areaServed: ['MX', 'US', 'Latin America'],
    priceRange: '$$',
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: 'Servicios de marketing digital',
      itemListElement: services.map((s) => ({
        '@type': 'Offer',
        itemOffered: { '@type': 'Service', name: s.title, url: `${site.url}${s.href}`, description: s.description },
      })),
    },
  },
];
---

<Base {title} {description} {jsonLd}>
  <HomeHero />
  <ClientsMarquee />
  <Services />
  <HowWeWork />
  <Portfolio />
  <Results />
  <Testimonials />
  <FinalCta />
</Base>
