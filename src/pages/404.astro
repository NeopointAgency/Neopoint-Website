---
import Base from '../layouts/Base.astro';
import Button from '../components/ui/Button.astro';
---

<Base title="Página no encontrada | Neopoint" description="La página que buscas no existe o cambió de dirección." noindex>
  <section class="container-x flex min-h-[60vh] flex-col items-center justify-center py-24 text-center">
    <p class="text-sm font-medium text-muted">Error 404</p>
    <h1 class="mt-4 text-4xl font-semibold sm:text-6xl">Esta página no existe</h1>
    <p class="mt-5 max-w-md text-lg text-muted">Puede que el enlace haya cambiado. Vuelve al inicio o explora nuestro portafolio.</p>
    <div class="mt-9 flex flex-col gap-3 sm:flex-row">
      <Button href="/" icon={false}>Ir al inicio</Button>
      <Button href="/portafolio/" variant="secondary">Ver portafolio</Button>
    </div>
  </section>
</Base>
