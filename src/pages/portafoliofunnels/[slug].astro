---
import Base from '../../layouts/Base.astro';
import ProjectDetail from '../../components/sections/ProjectDetail.astro';
import { getProjects, projectHref } from '../../lib/portfolio';
import { site } from '../../data/site';

export async function getStaticPaths() {
  const all = await getProjects();
  const funnels = all.filter((p) => p.data.category === 'funnel');
  return funnels.map((project, i) => ({
    params: { slug: project.id },
    props: {
      project,
      prev: funnels[i - 1],
      next: funnels[i + 1],
      related: all.filter((p) => p.data.featured && p.data.cover).slice(0, 3),
    },
  }));
}

const { project, prev, next, related } = Astro.props;
const { title: name, sector } = project.data;
const title = `${name} | Caso de éxito en generación de leads | Neopoint`;
const description = `${sector}. ${project.body?.slice(0, 150).trim()}…`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Portafolio', item: `${site.url}/portafolio/` },
      { '@type': 'ListItem', position: 3, name, item: `${site.url}${projectHref(project)}` },
    ],
  },
];
---

<Base {title} {description} {jsonLd}>
  <ProjectDetail {project} {prev} {next} {related} />
</Base>
