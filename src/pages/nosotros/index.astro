---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/ui/PageHero.astro';
import Button from '../../components/ui/Button.astro';
import FeatureGrid from '../../components/ui/FeatureGrid.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import ClientsMarquee from '../../components/sections/ClientsMarquee.astro';
import Results from '../../components/sections/Results.astro';
import Testimonials from '../../components/sections/Testimonials.astro';
import FinalCta from '../../components/sections/FinalCta.astro';
import { icons } from '../../lib/icons';
import { site } from '../../data/site';

const title = 'Nosotros | Neopoint, Digital Marketing Studio en México';
const description =
  'Neopoint es un estudio de marketing digital en México con más de cuatro años ayudando a negocios de LATAM y USA a crecer con diseño web estratégico y generación de leads.';

const values = [
  { icon: icons.compass, title: 'Dirección', description: 'Cada decisión de diseño o pauta responde a un objetivo comercial claro. Sin adornos que no vendan.' },
  { icon: icons.chart, title: 'Resultados medibles', description: 'Leads, costo por lead, citas y ventas. Reportamos lo que importa, con datos reales.' },
  { icon: icons.eye, title: 'Claridad', description: 'Explicamos lo que hacemos y por qué. Nuestros clientes nos describen como atentos y claros.' },
  { icon: icons.heart, title: 'Cercanía', description: 'Trabajamos de la mano con cada negocio, como una extensión de su equipo.' },
];

const how = [
  { n: '01', title: 'Escuchamos', text: 'Una asesoría inicial sin costo para entender tu negocio, tu cliente y tu meta.' },
  { n: '02', title: 'Proponemos', text: 'Una ruta concreta: qué construir, qué campañas correr y qué esperar de cada etapa.' },
  { n: '03', title: 'Ejecutamos y medimos', text: 'Diseñamos, lanzamos y optimizamos con datos. Ajustamos hasta que los números funcionen.' },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'AboutPage',
    name: 'Nosotros',
    url: `${site.url}/nosotros/`,
    description,
    mainEntity: { '@id': `${site.url}/#organization` },
  },
];
---

<Base {title} {description} {jsonLd}>
  <PageHero eyebrow="Nosotros" title="Marketing con dirección. Leads con intención." description="Somos un Digital Marketing Studio en México. Diseñamos sitios web que venden y campañas que traen clientes potenciales calificados, para negocios en México, LATAM y USA.">
    <div class="mt-9 flex flex-col gap-3 sm:flex-row">
      <Button href={site.bookingUrl} size="lg" icon={false}>Agendar tu asesoría</Button>
      <Button href="/portafolio/" variant="secondary" size="lg">Ver portafolio</Button>
    </div>
  </PageHero>

  <section class="py-20 sm:py-28" aria-labelledby="story-title">
    <div class="container-x grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <SectionHeading id="story-title" eyebrow="Nuestra historia" title="Los buenos resultados vienen de buenas cosechas" align="left" />
      </div>
      <div class="space-y-5 text-lg leading-relaxed text-muted lg:col-span-7">
        <p>Neopoint nació con una idea simple: la mayoría de los negocios no necesita "una página web" ni "publicidad"; necesita clientes. Por eso unimos en un mismo equipo el diseño web y la generación de leads.</p>
        <p>En más de cuatro años hemos acompañado a más de sesenta negocios, desde joyerías, despachos y constructoras hasta desarrolladoras inmobiliarias y plataformas educativas, generando más de veinte mil clientes potenciales y administrando más de un millón de pesos en pauta.</p>
        <p>Trabajamos de forma remota desde México con clientes en LATAM y Estados Unidos. Cada proyecto empieza con una conversación clara y termina con números sobre la mesa.</p>
      </div>
    </div>
  </section>

  <ClientsMarquee />

  <section class="py-20 sm:py-28" aria-labelledby="values-title">
    <div class="container-x">
      <SectionHeading id="values-title" eyebrow="Valores" title="Lo que guía cada proyecto" />
      <div class="mt-12"><FeatureGrid items={values} cols={4} /></div>
    </div>
  </section>

  <section class="bg-ink py-20 text-white sm:py-28" aria-labelledby="how-title">
    <div class="container-x">
      <SectionHeading id="how-title" eyebrow="Cómo trabajamos" title="Simple por fuera, riguroso por dentro" tone="dark" />
      <ol class="mt-14 grid gap-5 lg:grid-cols-3" role="list">
        {how.map(({ n, title, text }) => (
          <li class="reveal rounded-card border border-ink-line bg-ink-soft p-7 sm:p-8">
            <span class="text-sm font-medium text-white/50">{n}</span>
            <h3 class="mt-3 text-2xl font-semibold">{title}</h3>
            <p class="mt-2 leading-relaxed text-white/60">{text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <Results />
  <Testimonials />
  <FinalCta />
</Base>
